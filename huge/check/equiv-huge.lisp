;;;; equiv.lisp -- old (gpt-big.lisp) vs new (gpt-fast.lisp): (1) analytic gradients on a tiny config and on the real
;;;; config, (2) training-loss curves for N steps with the same seed, same data windows, step-based LR schedule.
;;;; usage: sbcl --script equiv.lisp steps=300 data=../big/corpus.txt
(defun harg (key default)
  (let ((a (find-if (lambda (s) (and (> (length s) (length key)) (string= (concatenate 'string key "=") s :end2 (1+ (length key))))) sb-ext:*posix-argv*)))
    (if a (subseq a (1+ (length key))) default)))
(load (compile-file "../../fast-gpt/gpt-old.lisp" :output-file "/tmp/equiv-old.fasl" :verbose nil :print nil))
(rename-package :gpt :gpt-old)
(load (compile-file "../gpt-huge.lisp" :output-file "/tmp/equiv-new.fasl" :verbose nil :print nil))
(funcall (intern "%SET-THREADS" :gpt) 1)   ; single-threaded OpenBLAS, as in MAIN (same library in both)
(defun sym (pkg name) (intern (string-upcase name) pkg))
(defmacro with-pkg ((p) &body body) `(flet ((f (name &rest args) (apply (sym ,p name) args))) (declare (ignorable #'f)) ,@body))
(defun setup (p cfg k b seed pdrop &key (perturb nil))
  "Build model + K workers in package P with the same RNG consumption as gpt-big.lisp."
  (setf (symbol-value (sym p "*rs*")) (sb-ext:seed-random-state seed)
        (symbol-value (sym p "*pdrop*")) pdrop)
  (with-pkg (p)
    (let* ((c (apply (sym p "make-cfg") cfg)) (m (f "make-model*" c)) (ws (loop repeat k collect (f "make-wk*" c b))))
      (when perturb
        (dolist (pv (f "model-vecs" m)) (let ((a (car pv))) (dotimes (i (length a)) (incf (aref a i) (coerce (* 0.3 (f "randn")) 'single-float))))))
      (list c m ws))))
(defun grads-of (p m ws nt scale drop)
  (with-pkg (p)
    (dolist (w ws) (setf (slot-value w (sym p "drop")) drop (slot-value w (sym p "newmask")) t (slot-value w (sym p "loss")) 0d0 (slot-value w (sym p "count")) 0)
      (f "forward-backward" m w nt 0 t scale))
    (values (f "sum-grads" ws) (loop for w in ws sum (slot-value w (sym p "loss"))))))
(defun compare-grads (label cfg k b nt pdrop ids-fn)
  (let ((res (loop for p in '(:gpt-old :gpt)
                   collect (destructuring-bind (c m ws) (setup p cfg k b 1 pdrop :perturb (eq ids-fn :tiny))
                             (declare (ignore c))
                             (let ((rs (sb-ext:seed-random-state 99)) (vv (getf cfg :v)))
                               (dolist (w ws) (dotimes (q (* b nt)) (setf (aref (slot-value w (sym p "ids")) q) (random vv rs)
                                                                         (aref (slot-value w (sym p "tgt")) q) (random vv rs)))))
                             (multiple-value-list (grads-of p m ws nt (coerce (/ 1d0 (* k b nt)) 'single-float) (> pdrop 0d0)))))))
    (destructuring-bind ((g1 l1) (g2 l2)) res
      (let ((n 0) (ndiff 0) (maxabs 0d0) (maxg 0d0))
        (loop for a in g1 for bb in g2
              do (dotimes (i (length a))
                   (incf n) (setf maxg (max maxg (abs (aref a i))))
                   (unless (= (aref a i) (aref bb i)) (incf ndiff) (setf maxabs (max maxabs (abs (- (aref a i) (aref bb i))))))))
        (format t "~a dropout=~a: loss old ~,10f new ~,10f | ~d grads, ~d differ (max |diff| ~,3e, max |g| ~,3e)~%" label pdrop l1 l2 n ndiff maxabs maxg)
        (finish-output)))))
(format t "== gradient equivalence (old analytic vs new analytic, FT=single) ==~%")
(dolist (pd '(0d0 0.2d0))
  (compare-grads "scaled-shape tiny V=11 d=16 L=6 H=8 T=16, 2 workers x 2 seqs" '(:v 11 :d 16 :nl 6 :nh 8 :tt 16) 2 2 16 pd :tiny))
(dolist (pd '(0d0 0.05d0))
  (compare-grads "full scaled V=95 d=256 L=6 H=8 T=128, 8 workers x 4 seqs" '(:v 95 :d 256 :nl 6 :nh 8 :tt 128) 8 4 128 pd :real))
