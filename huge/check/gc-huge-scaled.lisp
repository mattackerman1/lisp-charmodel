(declaim (sb-ext:muffle-conditions sb-ext:compiler-note))
;;;; gpt-huge.lisp -- gpt-fast.lisp with octet (ASCII) corpus loading for ~100 MB corpora and fullval-targets= (cap on periodic val).
;;;; gpt-fast.lisp -- faster gpt-big.lisp with the same maths (same model, init, RNG streams, dropout masks, optimizer).
;;;; Speedups vs gpt-big.lisp (see REPORT.md):
;;;;  1. GELU: tanh computed once in the forward pass and cached (double) for the backward; GELU fwd/bwd and the
;;;;     exp() in both softmaxes vectorized with sb-simd AVX2 (4 x double), same operation sequence => bitwise-equal.
;;;;  2. AdamW + cross-worker gradient reduction run in parallel on the worker threads (whole parameter tensors per
;;;;     thread, LPT-balanced), vectorized 8 x float; grad-norm summed in the original order => bitwise-equal.
;;;;  3. Persistent thread pool (mutex/condvar generation barrier) instead of make-thread/join-thread every step.
;;;;  4. Element-wise loops (dropout multiply, residual adds, bias grads, LN apply, softmax normalize) vectorized;
;;;;     branch-free dropout mask generation (same xorshift stream).
;;;; Single-float only (FT=double is not supported here; use gpt-big.lisp for the double-precision gradcheck).
(eval-when (:compile-toplevel :load-toplevel :execute) (require :sb-simd))
(defpackage :gpt (:use :cl) (:local-nicknames (:v :sb-simd-avx2))) (in-package :gpt)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defparameter *ft* 'single-float)
  (when (equal (sb-ext:posix-getenv "FT") "double") (error "gpt-fast.lisp is single-float only")))
(declaim (optimize (speed 3) (safety 0) (debug 0)))
(deftype fl () 'single-float)
(deftype fvec () '(simple-array single-float (*)))
(deftype dvec () '(simple-array double-float (*)))
(deftype idx () '(unsigned-byte 40))
(deftype dim () '(unsigned-byte 24))
(defmacro f (x) (coerce x *ft*))
(declaim (inline mkv)) (defun mkv (n) (make-array n :element-type 'single-float :initial-element 0f0))
(defun mkd (n) (make-array n :element-type 'double-float :initial-element 0d0))
(defun opt (key default)
  (let ((a (find-if (lambda (s) (and (> (length s) (length key)) (string= (concatenate 'string key "=") s :end2 (1+ (length key)))))
                    sb-ext:*posix-argv*)))
    (if a (subseq a (1+ (length key))) default)))
(defvar *rs* (sb-ext:seed-random-state 1))
(defvar *pdrop* 0d0)
(defun randn () (* (sqrt (* -2d0 (log (- 1d0 (random 1d0 *rs*))))) (cos (* 2 pi (random 1d0 *rs*)))))

;;; ---------- math helpers (double internally); scalar versions identical to gpt-big.lisp ----------
(defmacro horner (x &rest cs) (if (cdr cs) `(+ ,(car cs) (* ,x (horner ,x ,@(cdr cs)))) (car cs)))
(declaim (inline exp-neg tanh-d))
(defun exp-neg (y)
  (declare (double-float y))
  (if (< y -700d0) 0d0
      (let* ((n (floor (+ (* (the (double-float -700d0 0d0) y) 1.4426950408889634d0) 0.5d0)))
             (r (- (- y (* n 0.6931471803691238d0)) (* n 1.9082149292705877d-10)))
             (p (horner r 1d0 1d0 0.5d0 1.6666666666666666d-1 4.1666666666666664d-2 8.333333333333333d-3
                        1.388888888888889d-3 1.984126984126984d-4 2.48015873015873d-5 2.7557319223985893d-6
                        2.755731922398589d-7 2.505210838544172d-8 2.08767569878681d-9)))
        (declare (type (integer -1010 1) n))
        (* p (sb-kernel:make-double-float (ash (+ n 1023) 20) 0)))))
(defun tanh-d (x)
  (declare (double-float x))
  (if (> (abs x) 19d0) (if (> x 0d0) 1d0 -1d0)
      (let* ((e (exp-neg (* -2d0 (abs x)))) (th (/ (- 1d0 e) (+ 1d0 e)))) (if (< x 0d0) (- th) th))))

;;; ---------- SIMD versions: same IEEE operations in the same order (no FMA), 4 lanes ----------
(defmacro vhorner (x &rest cs) (if (cdr cs) `(v:f64.4+ (v:f64.4 ,(car cs)) (v:f64.4* ,x (vhorner ,x ,@(cdr cs)))) `(v:f64.4 ,(car cs))))
(declaim (inline vexp-neg vtanh))
(defun vexp-neg (y)
  "Lane-wise EXP-NEG. floor() via round-to-nearest + correction; 2^n built in the exponent field."
  (let* ((big (v:f64.4< y (v:f64.4 -700d0)))
         (yc (v:f64.4-max y (v:f64.4 -700d0)))
         (z (v:f64.4+ (v:f64.4* yc (v:f64.4 1.4426950408889634d0)) (v:f64.4 0.5d0)))
         (rn (v:f64.4-round z))
         (n (v:f64.4-if (v:f64.4> rn z) (v:f64.4- rn (v:f64.4 1d0)) rn))
         (r (v:f64.4- (v:f64.4- yc (v:f64.4* n (v:f64.4 0.6931471803691238d0))) (v:f64.4* n (v:f64.4 1.9082149292705877d-10))))
         (p (vhorner r 1d0 1d0 0.5d0 1.6666666666666666d-1 4.1666666666666664d-2 8.333333333333333d-3
                     1.388888888888889d-3 1.984126984126984d-4 2.48015873015873d-5 2.7557319223985893d-6
                     2.755731922398589d-7 2.505210838544172d-8 2.08767569878681d-9))
         (sc (v:f64.4! (v:u64.4-shiftl (v:u64.4- (v:u64.4! (v:f64.4+ n (v:f64.4 (+ 1023d0 4503599627370496d0))))
                                                 (v:u64.4 #x4330000000000000)) 52))))
    (v:f64.4-if big (v:f64.4 0d0) (v:f64.4* p sc))))
(defun vtanh (x)
  (let* ((sign (v:f64.4-and x (v:f64.4! (v:u64.4 #x8000000000000000))))
         (ax (v:f64.4-and x (v:f64.4! (v:u64.4 #x7FFFFFFFFFFFFFFF))))
         (e (vexp-neg (v:f64.4* (v:f64.4 -2d0) (v:f64.4-min ax (v:f64.4 19d0)))))
         (th (v:f64.4/ (v:f64.4- (v:f64.4 1d0) e) (v:f64.4+ (v:f64.4 1d0) e))))
    (v:f64.4-xor (v:f64.4-if (v:f64.4> ax (v:f64.4 19d0)) (v:f64.4 1d0) th) sign)))

;;; element-wise float helpers (8 lanes + scalar tail).
;;; NOTE: VZEROUPPER is only issued where no YMM value is live afterwards (it would clobber hoisted broadcasts).
(defmacro do8 ((q n) vec-body scalar-body)
  `(let ((n8 (logand ,n (lognot 7))))
     (declare (idx n8))
     (loop for ,q of-type idx from 0 below n8 by 8 do ,vec-body)
     (loop for ,q of-type idx from n8 below ,n do ,scalar-body)))
(defun vmul (a m n) (declare (fvec a m) (idx n))
  (do8 (q n) (setf (v:f32.8-aref a q) (v:f32.8* (v:f32.8-aref a q) (v:f32.8-aref m q)))
       (setf (aref a q) (* (aref a q) (aref m q)))))
(defun vmul-into (o a m n) (declare (fvec o a m) (idx n))
  (do8 (q n) (setf (v:f32.8-aref o q) (v:f32.8* (v:f32.8-aref a q) (v:f32.8-aref m q)))
       (setf (aref o q) (* (aref a q) (aref m q)))))
(defun vmul-off (o oo a ao m mo n)   ; o[oo+q] = a[ao+q]*m[mo+q]
  (declare (fvec o a m) (idx oo ao mo n))
  (do8 (q n) (setf (v:f32.8-aref o (+ oo q)) (v:f32.8* (v:f32.8-aref a (+ ao q)) (v:f32.8-aref m (+ mo q))))
       (setf (aref o (+ oo q)) (* (aref a (+ ao q)) (aref m (+ mo q))))))
(defun vadd (a b n) (declare (fvec a b) (idx n))   ; a += b
  (do8 (q n) (setf (v:f32.8-aref a q) (v:f32.8+ (v:f32.8-aref a q) (v:f32.8-aref b q)))
       (setf (aref a q) (+ (aref a q) (aref b q)))))

;;; ---------- BLAS ----------
(sb-alien:load-shared-object "/usr/lib/x86_64-linux-gnu/libopenblas.so.0")
(sb-alien:define-alien-routine ("cblas_sgemm" %sgemm) sb-alien:void
  (order sb-alien:int) (ta sb-alien:int) (tb sb-alien:int) (m sb-alien:int) (n sb-alien:int) (k sb-alien:int)
  (alpha sb-alien:single-float) (a sb-sys:system-area-pointer) (lda sb-alien:int) (b sb-sys:system-area-pointer) (ldb sb-alien:int)
  (beta sb-alien:single-float) (c sb-sys:system-area-pointer) (ldc sb-alien:int))
(sb-alien:define-alien-routine ("openblas_set_num_threads" %set-threads) sb-alien:void (n sb-alien:int))
(defconstant +esz+ 4)
(declaim (inline gemm))
(defun gemm (ta tb m n k alpha A ao lda B bo ldb beta C co ldc)
  "Row-major C[m,n] = alpha op(A) op(B) + beta C; TA/TB true = transpose. Offsets in elements."
  (declare (fvec A B C) (idx ao bo co) (dim m n k lda ldb ldc) (type fl alpha beta))
  (sb-sys:with-pinned-objects (A B C)
    (%sgemm 101 (if ta 112 111) (if tb 112 111) m n k alpha
            (sb-sys:sap+ (sb-sys:vector-sap A) (* +esz+ ao)) lda
            (sb-sys:sap+ (sb-sys:vector-sap B) (* +esz+ bo)) ldb
            beta (sb-sys:sap+ (sb-sys:vector-sap C) (* +esz+ co)) ldc)))

;;; ---------- parameters (unchanged) ----------
(defconstant +ln1g+ 0) (defconstant +ln1b+ 1) (defconstant +wqkv+ 2) (defconstant +bqkv+ 3)
(defconstant +wproj+ 4) (defconstant +bproj+ 5) (defconstant +ln2g+ 6) (defconstant +ln2b+ 7)
(defconstant +wfc+ 8) (defconstant +bfc+ 9) (defconstant +wfc2+ 10) (defconstant +bfc2+ 11)
(defstruct (cfg (:conc-name c-)) (v 0 :type fixnum) (d 0 :type fixnum) (nl 0 :type fixnum) (nh 0 :type fixnum) (tt 0 :type fixnum))
(defstruct (model (:conc-name m-)) cfg wte wpe layers lnfg lnfb)
(defun model-vecs (m)
  (append (list (cons (m-wte m) t) (cons (m-wpe m) t))
          (loop for ly in (m-layers m)
                append (loop for i below 12 collect (cons (svref ly i) (member i (list +wqkv+ +wproj+ +wfc+ +wfc2+)))))
          (list (cons (m-lnfg m) nil) (cons (m-lnfb m) nil))))
(defun make-model* (c &optional (zero nil))
  (let* ((v (c-v c)) (d (c-d c)) (nl (c-nl c)) (tt (c-tt c)) (rstd (/ 0.02d0 (sqrt (* 2d0 nl)))))
    (flet ((rnd (n sd) (let ((a (mkv n))) (unless zero (dotimes (i n) (setf (aref a i) (coerce (* sd (randn)) 'fl)))) a))
           (ones (n) (let ((a (mkv n))) (unless zero (fill a (f 1))) a)))
      (make-model :cfg c :wte (rnd (* v d) 0.02d0) :wpe (rnd (* tt d) 0.02d0)
                  :layers (loop repeat nl collect
                                (vector (ones d) (mkv d) (rnd (* d 3 d) 0.02d0) (mkv (* 3 d))
                                        (rnd (* d d) rstd) (mkv d) (ones d) (mkv d)
                                        (rnd (* d 4 d) 0.02d0) (mkv (* 4 d)) (rnd (* 4 d d) rstd) (mkv d)))
                  :lnfg (ones d) :lnfb (mkv d)))))
(defun nparams (m) (reduce #'+ (mapcar (lambda (p) (length (the fvec (car p)))) (model-vecs m))))

;;; ---------- worker ----------
(defstruct (wk (:conc-name w-)) (b 0 :type fixnum) grads
  xs ln1h ln1r xn1 qkv att y xmid ln2h ln2r xn2 hfc gel gth
  lnfh lnfr xf P dx tmp dqkv dy dg dA ids tgt (loss 0d0 :type double-float) (count 0 :type fixnum)
  (drop nil) (newmask t) rng me m1 m2 ma attd dm ebuf)
(defun make-wk* (c b)
  (let* ((d (c-d c)) (tt (c-tt c)) (nl (c-nl c)) (r (* b tt)) (v (c-v c)) (nh (c-nh c)))
    (flet ((per (n) (coerce (loop repeat nl collect (mkv n)) 'simple-vector)))
      (make-wk :b b :grads (make-model* c t)
               :xs (coerce (loop repeat (1+ nl) collect (mkv (* r d))) 'simple-vector)
               :ln1h (per (* r d)) :ln1r (per r) :xn1 (per (* r d)) :qkv (per (* r 3 d)) :att (per (* b nh tt tt))
               :y (per (* r d)) :xmid (per (* r d)) :ln2h (per (* r d)) :ln2r (per r) :xn2 (per (* r d))
               :hfc (per (* r 4 d)) :gel (per (* r 4 d))
               :gth (coerce (loop repeat nl collect (mkd (* r 4 d))) 'simple-vector)   ; cached tanh for GELU backward
               :lnfh (mkv (* r d)) :lnfr (mkv r) :xf (mkv (* r d)) :P (mkv (* r v))
               :dx (mkv (* r d)) :tmp (mkv (* r d)) :dqkv (mkv (* r 3 d)) :dy (mkv (* r d)) :dg (mkv (* r 4 d)) :dA (mkv (* tt tt))
               :ids (make-array r :element-type 'fixnum) :tgt (make-array r :element-type 'fixnum)
               :rng (make-array 1 :element-type '(unsigned-byte 64) :initial-element (+ 1 (random (expt 2 62) *rs*)))
               :me (mkv (* r d)) :m1 (per (* r d)) :m2 (per (* r d)) :ma (per (* b nh tt tt)) :attd (per (* b nh tt tt)) :dm (mkv (* r d))
               :ebuf (mkd (max tt v 8))))))

(defun fill-mask (st mask n)
  "Inverted-dropout mask: 0 with prob *pdrop*, else 1/(1-p). Same xorshift64 stream as gpt-big.lisp, branch-free select."
  (declare (type (simple-array (unsigned-byte 64) (1)) st) (fvec mask) (idx n))
  (let* ((x (aref st 0)) (thr (round (* *pdrop* 16777216))) (ks (coerce (/ 1d0 (- 1d0 *pdrop*)) 'fl))
         (tbl (make-array 2 :element-type 'single-float :initial-contents (list 0f0 ks))))
    (declare (type (unsigned-byte 64) x) (type (signed-byte 32) thr) (type (simple-array single-float (2)) tbl))
    (dotimes (i n)
      (setf x (logxor x (logand (ash x 13) #xFFFFFFFFFFFFFFFF)))
      (setf x (logxor x (ash x -7)))
      (setf x (logxor x (logand (ash x 17) #xFFFFFFFFFFFFFFFF)))
      (setf (aref mask i) (aref tbl (+ 1 (ash (the (signed-byte 32) (- (the (unsigned-byte 24) (ash x -40)) thr)) -31)))))
    (setf (aref st 0) x)))

;;; ---------- building blocks ----------
(defun layernorm (X R d g b H rs Y)
  "Y = g * (X-mean)/sqrt(var+1e-5) + b per row; stores xhat in H and 1/std in RS."
  (declare (fvec X g b H rs Y) (dim R d))
  (dotimes (r R)
    (let ((o (* r d)) (mu 0d0) (var 0d0))
      (declare (idx o) (double-float mu var))
      (dotimes (j d) (incf mu (aref X (+ o j)))) (setf mu (/ mu d))
      (dotimes (j d) (let ((z (- (aref X (+ o j)) mu))) (incf var (* z z)))) (setf var (/ var d))
      (let ((s (/ 1d0 (sqrt (the (double-float 0d0) (+ var 1d-5))))))   ; same value; avoids generic sqrt + boxing
        (setf (aref rs r) (coerce s 'fl))
        (dotimes (j d)
          (let ((xh (coerce (* (- (aref X (+ o j)) mu) s) 'fl)))
            (setf (aref H (+ o j)) xh (aref Y (+ o j)) (+ (* (aref g j) xh) (aref b j)))))))))

(defun ln-back (dY H rs g dg db R d dX accumulate)
  (declare (fvec dY H rs g dg db dX) (dim R d))
  (dotimes (r R)
    (let ((o (* r d)) (m1 0d0) (m2 0d0))
      (declare (idx o) (double-float m1 m2))
      (dotimes (j d)
        (let* ((dy (aref dY (+ o j))) (dxh (* dy (aref g j))))
          (incf (aref dg j) (* dy (aref H (+ o j)))) (incf (aref db j) dy)
          (incf m1 dxh) (incf m2 (* dxh (aref H (+ o j))))))
      (setf m1 (/ m1 d) m2 (/ m2 d))
      (let ((s (aref rs r)))
        (dotimes (j d)
          (let ((v (* s (coerce (- (* (aref dY (+ o j)) (aref g j)) m1 (* (aref H (+ o j)) m2)) 'fl))))
            (if accumulate (incf (aref dX (+ o j)) v) (setf (aref dX (+ o j)) v))))))))

(defun linear (X R din W bias Y dout)
  (declare (fvec X W bias Y) (dim R din dout))
  (dotimes (r R) (replace Y bias :start1 (* r dout)))
  (gemm nil nil R dout din (f 1) X 0 din W 0 dout (f 1) Y 0 dout))

(defun linear-back (X R din W dY dout gW gb dX)
  (declare (fvec X W dY gW gb) (dim R din dout))
  (gemm t nil din dout R (f 1) X 0 din dY 0 dout (f 1) gW 0 dout)
  (let ((d8 (logand dout (lognot 7))))       ; bias grad: per column, rows summed in the original order
    (declare (dim d8))
    (dotimes (r R)
      (let ((o (* r dout))) (declare (idx o))
        (loop for j of-type idx from 0 below d8 by 8 do (setf (v:f32.8-aref gb j) (v:f32.8+ (v:f32.8-aref gb j) (v:f32.8-aref dY (+ o j)))))
        (sb-simd-avx:vzeroupper)
        (loop for j from d8 below dout do (incf (aref gb j) (aref dY (+ o j)))))))
  (when dX (gemm nil t R din dout (f 1) dY 0 dout W 0 dout (f 0) dX 0 din)))

(defconstant +gc+ 0.7978845608028654d0)   ; sqrt(2/pi)
(defun gelu (Hh G TC n)
  "G = gelu(Hh); TC caches tanh(...) (double) for GELU-BACK."
  (declare (fvec Hh G) (dvec TC) (idx n))
  (let ((n4 (logand n (lognot 3))))
    (declare (idx n4))
    (loop for q of-type idx from 0 below n4 by 4
          do (let* ((x (v:f64.4-from-f32.4 (v:f32.4-aref Hh q)))
                    (th (vtanh (v:f64.4* (v:f64.4 +gc+) (v:f64.4+ x (v:f64.4* (v:f64.4* (v:f64.4* (v:f64.4 0.044715d0) x) x) x))))))
               (setf (v:f64.4-aref TC q) th
                     (v:f32.4-aref G q) (v:f32.4-from-f64.4 (v:f64.4* (v:f64.4* (v:f64.4 0.5d0) x) (v:f64.4+ (v:f64.4 1d0) th))))))
    (sb-simd-avx:vzeroupper)
    (loop for q from n4 below n
          do (let* ((x (coerce (aref Hh q) 'double-float)) (th (tanh-d (* +gc+ (+ x (* 0.044715d0 x x x))))))
               (setf (aref TC q) th (aref G q) (coerce (* 0.5d0 x (+ 1d0 th)) 'fl))))))
(defun gelu-back (Hh TC dG n)       ; dG *= gelu'(h), using cached tanh
  (declare (fvec Hh dG) (dvec TC) (idx n))
  (let ((n4 (logand n (lognot 3))) (c3 (* 3d0 0.044715d0)))
    (declare (idx n4) (double-float c3))
    (loop for q of-type idx from 0 below n4 by 4
          do (let* ((x (v:f64.4-from-f32.4 (v:f32.4-aref Hh q))) (t1 (v:f64.4-aref TC q))
                    (dd (v:f64.4+ (v:f64.4* (v:f64.4 0.5d0) (v:f64.4+ (v:f64.4 1d0) t1))
                                  (v:f64.4* (v:f64.4* (v:f64.4* (v:f64.4* (v:f64.4 0.5d0) x) (v:f64.4- (v:f64.4 1d0) (v:f64.4* t1 t1))) (v:f64.4 +gc+))
                                            (v:f64.4+ (v:f64.4 1d0) (v:f64.4* (v:f64.4* (v:f64.4 c3) x) x))))))
               (setf (v:f32.4-aref dG q) (v:f32.4* (v:f32.4-aref dG q) (v:f32.4-from-f64.4 dd)))))
    (sb-simd-avx:vzeroupper)
    (loop for q from n4 below n
          do (let* ((x (coerce (aref Hh q) 'double-float)) (t1 (aref TC q))
                    (dd (+ (* 0.5d0 (+ 1d0 t1)) (* 0.5d0 x (- 1d0 (* t1 t1)) +gc+ (+ 1d0 (* 3d0 0.044715d0 x x))))))
               (setf (aref dG q) (* (aref dG q) (coerce dd 'fl)))))))

(declaim (inline softmax-row))
(defun softmax-row (A o L EB)
  "In place on A[o..o+L): e_j = exp-neg(float(A_j - max)) (vectorized), sum in double in the original sequential order,
   A_j = float(e_j_float * (1/sum)). Returns the sum. EB is a double scratch buffer of length >= L."
  (declare (fvec A) (dvec EB) (idx o) (dim L))
  (let ((mx (aref A o)) (sm 0d0) (L4 (logand L (lognot 3))))
    (declare (type fl mx) (double-float sm) (dim L4))
    (loop for j from 1 below L do (setf mx (max mx (aref A (+ o j)))))
    (let ((vmx (v:f32.4 mx)))
      (loop for j of-type idx from 0 below L4 by 4
            do (let ((e (vexp-neg (v:f64.4-from-f32.4 (v:f32.4- (v:f32.4-aref A (+ o j)) vmx)))))
                 (setf (v:f64.4-aref EB j) e (v:f32.4-aref A (+ o j)) (v:f32.4-from-f64.4 e)))))
    (sb-simd-avx:vzeroupper)
    (loop for j from L4 below L
          do (let ((e (exp-neg (coerce (- (aref A (+ o j)) mx) 'double-float)))) (setf (aref EB j) e (aref A (+ o j)) (coerce e 'fl))))
    (dotimes (j L) (incf sm (aref EB j)))
    sm))

(defun attention (c qkv att y b nt E &optional ma attd)
  (declare (fvec qkv att y) (dvec E) (dim b nt))
  (let* ((d (c-d c)) (nh (c-nh c)) (hd (floor d nh)) (d3 (* 3 d)) (scale (coerce (/ 1d0 (sqrt (float hd 1d0))) 'fl)))
    (declare (dim d nh hd d3))
    (dotimes (s b)
      (dotimes (h nh)
        (let* ((qo (+ (* s nt d3) (* h hd))) (ko (+ qo d)) (vo (+ qo d d))
               (ao (* (+ (* s nh) h) nt nt)) (yo (+ (* s nt d) (* h hd))))
          (declare (idx qo ko vo ao yo))
          (gemm nil t nt nt hd scale qkv qo d3 qkv ko d3 (f 0) att ao nt)
          (dotimes (i nt)
            (let* ((o (+ ao (* i nt))) (L (1+ i)) (L4 (logand L (lognot 3))) (inv (/ 1d0 (softmax-row att o L E))) (vinv (v:f64.4 inv)))
              (declare (idx o) (dim L L4) (double-float inv))
              (loop for j of-type idx from 0 below L4 by 4
                    do (setf (v:f32.4-aref att (+ o j)) (v:f32.4-from-f64.4 (v:f64.4* vinv (v:f64.4-from-f32.4 (v:f32.4-aref att (+ o j)))))))
              (sb-simd-avx:vzeroupper)
              (loop for j from L4 below L do (setf (aref att (+ o j)) (coerce (* inv (aref att (+ o j))) 'fl)))
              (loop for j from L below nt do (setf (aref att (+ o j)) (f 0)))))
          (if ma
              (progn (vmul-off attd ao att ao ma ao (* nt nt))
                     (gemm nil nil nt hd nt (f 1) attd ao nt qkv vo d3 (f 0) y yo d))
              (gemm nil nil nt hd nt (f 1) att ao nt qkv vo d3 (f 0) y yo d)))))))

(defun attention-back (c qkv att dy dqkv dA b nt &optional ma attd)
  (declare (fvec qkv att dy dqkv dA) (dim b nt))
  (let* ((d (c-d c)) (nh (c-nh c)) (hd (floor d nh)) (d3 (* 3 d)) (scale (coerce (/ 1d0 (sqrt (float hd 1d0))) 'fl)))
    (declare (dim d nh hd d3))
    (dotimes (s b)
      (dotimes (h nh)
        (let* ((qo (+ (* s nt d3) (* h hd))) (ko (+ qo d)) (vo (+ qo d d))
               (ao (* (+ (* s nh) h) nt nt)) (yo (+ (* s nt d) (* h hd))))
          (declare (idx qo ko vo ao yo))
          (gemm nil t nt nt hd (f 1) dy yo d qkv vo d3 (f 0) dA 0 nt)
          (when ma (vmul-off dA 0 dA 0 ma ao (* nt nt)))
          (gemm t nil nt hd nt (f 1) (if ma attd att) ao nt dy yo d (f 0) dqkv vo d3)
          (dotimes (i nt)
            (let ((o (* i nt)) (sd 0d0))
              (declare (idx o) (double-float sd))
              (loop for j from 0 to i do (incf sd (* (aref att (+ ao o j)) (aref dA (+ o j)))))
              (let* ((sdf (coerce sd 'fl)) (vsd (v:f32.8 sdf)) (L (1+ i)) (L8 (logand L (lognot 7))))
                (declare (dim L L8))
                (loop for j of-type idx from 0 below L8 by 8
                      do (setf (v:f32.8-aref dA (+ o j)) (v:f32.8* (v:f32.8-aref att (+ ao o j)) (v:f32.8- (v:f32.8-aref dA (+ o j)) vsd))))
                (sb-simd-avx:vzeroupper)
                (loop for j from L8 below L do (setf (aref dA (+ o j)) (* (aref att (+ ao o j)) (- (aref dA (+ o j)) sdf))))
                (loop for j from L below nt do (setf (aref dA (+ o j)) (f 0))))))
          (gemm nil nil nt hd nt scale dA 0 nt qkv ko d3 (f 0) dqkv qo d3)
          (gemm t nil nt hd nt scale dA 0 nt qkv qo d3 (f 0) dqkv ko d3))))))

;;; ---------- full model forward / backward (same order of operations as gpt-big.lisp) ----------
(defun forward-backward (m w nt sf backprop scale)
  (declare (dim nt sf) (type fl scale))
  (let* ((c (m-cfg m)) (d (c-d c)) (v (c-v c)) (nl (c-nl c)) (b (w-b w)) (R (* b nt)) (d3 (* 3 d)) (d4 (* 4 d))
         (wte (m-wte m)) (wpe (m-wpe m)) (ids (w-ids w)) (tgt (w-tgt w)) (P (w-P w)) (xf (w-xf w)) (loss 0d0) (E (w-ebuf w))
         (layers (coerce (m-layers m) 'simple-vector)))
    (declare (dim d v nl b R d3 d4) (fvec wte wpe P xf) ((simple-array fixnum (*)) ids tgt) (double-float loss) (dvec E))
    (let ((x0 (svref (w-xs w) 0)))
      (declare (fvec x0))
      (dotimes (r R)
        (let ((o (* r d)) (eo (* (aref ids r) d)) (po (* (mod r nt) d)))
          (declare (idx o eo po))
          (dotimes (j d) (setf (aref x0 (+ o j)) (+ (aref wte (+ eo j)) (aref wpe (+ po j)))))))
      (when (w-drop w)
        (when (w-newmask w)
          (fill-mask (w-rng w) (w-me w) (* R d))
          (dotimes (l nl) (fill-mask (w-rng w) (svref (w-m1 w) l) (* R d)) (fill-mask (w-rng w) (svref (w-m2 w) l) (* R d))
                          (fill-mask (w-rng w) (svref (w-ma w) l) (* b (c-nh c) nt nt))))
        (vmul x0 (w-me w) (* R d))))
    (dotimes (l nl)
      (let ((ly (svref layers l)) (X (svref (w-xs w) l)) (Xo (svref (w-xs w) (1+ l))) (xmid (svref (w-xmid w) l)))
        (declare (simple-vector ly) (fvec X Xo xmid))
        (layernorm X R d (svref ly +ln1g+) (svref ly +ln1b+) (svref (w-ln1h w) l) (svref (w-ln1r w) l) (svref (w-xn1 w) l))
        (linear (svref (w-xn1 w) l) R d (svref ly +wqkv+) (svref ly +bqkv+) (svref (w-qkv w) l) d3)
        (if (w-drop w)
            (attention c (svref (w-qkv w) l) (svref (w-att w) l) (svref (w-y w) l) b nt E (svref (w-ma w) l) (svref (w-attd w) l))
            (attention c (svref (w-qkv w) l) (svref (w-att w) l) (svref (w-y w) l) b nt E))
        (linear (svref (w-y w) l) R d (svref ly +wproj+) (svref ly +bproj+) xmid d)
        (when (w-drop w) (vmul xmid (svref (w-m1 w) l) (* R d)))
        (vadd xmid X (* R d))
        (layernorm xmid R d (svref ly +ln2g+) (svref ly +ln2b+) (svref (w-ln2h w) l) (svref (w-ln2r w) l) (svref (w-xn2 w) l))
        (linear (svref (w-xn2 w) l) R d (svref ly +wfc+) (svref ly +bfc+) (svref (w-hfc w) l) d4)
        (gelu (svref (w-hfc w) l) (svref (w-gel w) l) (svref (w-gth w) l) (* R d4))
        (linear (svref (w-gel w) l) R d4 (svref ly +wfc2+) (svref ly +bfc2+) Xo d)
        (when (w-drop w) (vmul Xo (svref (w-m2 w) l) (* R d)))
        (vadd Xo xmid (* R d))))
    (layernorm (svref (w-xs w) nl) R d (m-lnfg m) (m-lnfb m) (w-lnfh w) (w-lnfr w) xf)
    (gemm nil t R v d (f 1) xf 0 d wte 0 d (f 0) P 0 v)
    (dotimes (r R)
      (let* ((o (* r v)) (scored (>= (mod r nt) sf)) (inv (/ 1d0 (softmax-row P o v E))))
        (declare (idx o) (double-float inv))
        (if scored
            (progn (decf loss (log (max 1d-300 (* inv (aref P (+ o (aref tgt r))))))) (incf (w-count w))
                   (loop for j from o below (+ o v) do (setf (aref P j) (coerce (* inv (aref P j)) 'fl))))
            (fill P (f 0) :start o :end (+ o v)))))
    (incf (w-loss w) loss)
    (when backprop
      (let* ((g (w-grads w)) (gwte (m-wte g)) (dx (w-dx w)) (tmp (w-tmp w)) (dy (w-dy w)) (dg (w-dg w)) (dqkv (w-dqkv w))
             (glayers (coerce (m-layers g) 'simple-vector)) (vs (v:f32.8 scale)))
        (declare (fvec gwte dx tmp dy dg dqkv))
        (dotimes (r R) (let ((o (* r v)))
                         (declare (idx o))
                         (when (>= (mod r nt) sf) (decf (aref P (+ o (aref tgt r))) (f 1)))
                         (do8 (j v) (setf (v:f32.8-aref P (+ o j)) (v:f32.8* vs (v:f32.8-aref P (+ o j))))
                              (setf (aref P (+ o j)) (* scale (aref P (+ o j)))))))
        (gemm t nil v d R (f 1) P 0 v xf 0 d (f 1) gwte 0 d)
        (gemm nil nil R d v (f 1) P 0 v wte 0 d (f 0) tmp 0 d)
        (ln-back tmp (w-lnfh w) (w-lnfr w) (m-lnfg m) (m-lnfg g) (m-lnfb g) R d dx nil)
        (loop for l from (1- nl) downto 0
              do (let ((ly (svref layers l)) (gl (svref glayers l)))
                   (declare (simple-vector ly gl))
                   (linear-back (svref (w-gel w) l) R d4 (svref ly +wfc2+) (if (w-drop w) (progn (vmul-into (w-dm w) dx (svref (w-m2 w) l) (* R d)) (w-dm w)) dx) d (svref gl +wfc2+) (svref gl +bfc2+) dg)
                   (gelu-back (svref (w-hfc w) l) (svref (w-gth w) l) dg (* R d4))
                   (linear-back (svref (w-xn2 w) l) R d (svref ly +wfc+) dg d4 (svref gl +wfc+) (svref gl +bfc+) tmp)
                   (ln-back tmp (svref (w-ln2h w) l) (svref (w-ln2r w) l) (svref ly +ln2g+) (svref gl +ln2g+) (svref gl +ln2b+) R d dx t)
                   (linear-back (svref (w-y w) l) R d (svref ly +wproj+) (if (w-drop w) (progn (vmul-into (w-dm w) dx (svref (w-m1 w) l) (* R d)) (w-dm w)) dx) d (svref gl +wproj+) (svref gl +bproj+) dy)
                   (if (w-drop w)
                       (attention-back c (svref (w-qkv w) l) (svref (w-att w) l) dy dqkv (w-dA w) b nt (svref (w-ma w) l) (svref (w-attd w) l))
                       (attention-back c (svref (w-qkv w) l) (svref (w-att w) l) dy dqkv (w-dA w) b nt))
                   (linear-back (svref (w-xn1 w) l) R d (svref ly +wqkv+) dqkv d3 (svref gl +wqkv+) (svref gl +bqkv+) tmp)
                   (ln-back tmp (svref (w-ln1h w) l) (svref (w-ln1r w) l) (svref ly +ln1g+) (svref gl +ln1g+) (svref gl +ln1b+) R d dx t)))
        (let ((gwpe (m-wpe g)))
          (declare (fvec gwpe))
          (when (w-drop w) (vmul dx (w-me w) (* R d)))
          (dotimes (r R)
            (let ((o (* r d)) (eo (* (aref ids r) d)) (po (* (mod r nt) d)))
              (declare (idx o eo po))
              (dotimes (j d) (incf (aref gwte (+ eo j)) (aref dx (+ o j))) (incf (aref gwpe (+ po j)) (aref dx (+ o j)))))))))))

;;; ---------- persistent thread pool ----------
(defstruct (pool (:conc-name p-)) (n 1 :type fixnum) (gen 0 :type fixnum) (done 0 :type fixnum) job threads
  (mx (sb-thread:make-mutex)) (cv (sb-thread:make-waitqueue)) (cvd (sb-thread:make-waitqueue)))
(defun pool-loop (p i)
  (let ((seen 0))
    (loop
      (let (job)
        (sb-thread:with-mutex ((p-mx p))
          (loop while (= (p-gen p) seen) do (sb-thread:condition-wait (p-cv p) (p-mx p)))
          (setf seen (p-gen p) job (p-job p)))
        (when (eq job :quit) (return))
        (funcall (the function job) i)
        (sb-thread:with-mutex ((p-mx p))
          (when (= (incf (p-done p)) (1- (p-n p))) (sb-thread:condition-broadcast (p-cvd p))))))))
(defun make-pool* (n)
  (let ((p (make-pool :n n)))
    (setf (p-threads p) (loop for i from 1 below n collect (let ((i i)) (sb-thread:make-thread (lambda () (pool-loop p i)) :name (format nil "w~d" i)))))
    p))
(defun run-pool (p fn)
  "Call FN on 0..n-1 in parallel (0 on the calling thread); return when all are done."
  (declare (function fn))
  (if (= (p-n p) 1) (funcall fn 0)
      (progn
        (sb-thread:with-mutex ((p-mx p)) (setf (p-job p) fn (p-done p) 0) (incf (p-gen p)) (sb-thread:condition-broadcast (p-cv p)))
        (funcall fn 0)
        (sb-thread:with-mutex ((p-mx p))
          (loop until (= (p-done p) (1- (p-n p))) do (sb-thread:condition-wait (p-cvd p) (p-mx p))))
        nil)))
(defun stop-pool (p)
  (when (> (p-n p) 1)
    (sb-thread:with-mutex ((p-mx p)) (setf (p-job p) :quit) (incf (p-gen p)) (sb-thread:condition-broadcast (p-cv p)))
    (mapc #'sb-thread:join-thread (p-threads p))))

;;; old-style helpers kept for the gradcheck
(defun sum-grads (workers)
  (let ((g0 (mapcar #'car (model-vecs (w-grads (car workers))))))
    (dolist (w (cdr workers))
      (loop for a in g0 for (bv) in (model-vecs (w-grads w))
            do (let ((a a) (bv bv)) (declare (fvec a bv)) (dotimes (i (length a)) (incf (aref a i) (aref bv i)) (setf (aref bv i) (f 0))))))
    g0))

;;; ---------- AdamW, parallel over parameter tensors ----------
(defstruct (adam (:conc-name a-)) ms vs (tn 0 :type fixnum)
  ps decays gs     ; simple-vectors over tensors: params, decay flags, per-tensor simple-vector of worker grad fvecs
  parts            ; dvec: per-tensor sum of squares of the reduced gradient
  assign)          ; simple-vector (per thread) of lists of tensor indices
(defun make-adam* (m &optional ws (nthreads 1))
  (let* ((mv (model-vecs m)) (nt (length mv))
         (o (make-adam :ms (mapcar (lambda (p) (mkv (length (the fvec (car p))))) mv)
                       :vs (mapcar (lambda (p) (mkv (length (the fvec (car p))))) mv))))
    (when ws
      (setf (a-ps o) (coerce (mapcar #'car mv) 'simple-vector)
            (a-decays o) (coerce (mapcar (lambda (p) (and (cdr p) t)) mv) 'simple-vector)
            (a-gs o) (let ((per (mapcar (lambda (w) (mapcar #'car (model-vecs (w-grads w)))) ws)))
                       (coerce (loop for i below nt collect (coerce (mapcar (lambda (l) (nth i l)) per) 'simple-vector)) 'simple-vector))
            (a-parts o) (mkd nt))
      ;; LPT: biggest tensors first, each to the least-loaded thread
      (let ((load (make-array nthreads :initial-element 0)) (asg (make-array nthreads :initial-element nil)))
        (dolist (i (sort (loop for i below nt collect i) #'> :key (lambda (i) (length (the fvec (svref (a-ps o) i))))))
          (let ((th (position (reduce #'min load) load)))
            (incf (aref load th) (length (the fvec (svref (a-ps o) i)))) (push i (aref asg th))))
        (setf (a-assign o) asg)))
    o))

(defun reduce-tensor (gw parts i)
  "g0 += g1 + ... (per element, workers in order; others zeroed); parts[i] = sum g0^2 in double, sequential."
  (declare (simple-vector gw) (dvec parts) (fixnum i))
  (let* ((g0 (svref gw 0)) (n (length g0)) (k (length gw)) (s 0d0))
    (declare (fvec g0) (idx n) (fixnum k) (double-float s))
    (loop for wi from 1 below k
          do (let ((bv (svref gw wi)) (z (v:f32.8 0f0)))
               (declare (fvec bv))
               (do8 (q n) (progn (setf (v:f32.8-aref g0 q) (v:f32.8+ (v:f32.8-aref g0 q) (v:f32.8-aref bv q))) (setf (v:f32.8-aref bv q) z))
                    (progn (incf (aref g0 q) (aref bv q)) (setf (aref bv q) (f 0))))))
    (loop for x across g0 do (incf s (* (coerce x 'double-float) x)))
    (setf (aref parts i) s)))

(defun adam-tensor (p g mm vv cs shrink lrc ic2)
  (declare (fvec p g mm vv) (type fl cs shrink lrc ic2))
  (let ((n (length p)) (vcs (v:f32.8 cs)) (vsh (v:f32.8 shrink)) (vlrc (v:f32.8 lrc)) (vic2 (v:f32.8 ic2))
        (b1 (v:f32.8 0.9f0)) (b1c (v:f32.8 0.1f0)) (b2 (v:f32.8 0.99f0)) (b2c (v:f32.8 0.01f0)) (eps (v:f32.8 1f-8)) (z (v:f32.8 0f0)))
    (declare (idx n))
    (do8 (i n)
         (let* ((gi (v:f32.8* vcs (v:f32.8-aref g i)))
                (m1 (v:f32.8+ (v:f32.8* b1 (v:f32.8-aref mm i)) (v:f32.8* b1c gi)))
                (v1 (v:f32.8+ (v:f32.8* b2 (v:f32.8-aref vv i)) (v:f32.8* (v:f32.8* b2c gi) gi))))
           (setf (v:f32.8-aref mm i) m1 (v:f32.8-aref vv i) v1
                 (v:f32.8-aref p i) (v:f32.8- (v:f32.8* vsh (v:f32.8-aref p i))
                                              (v:f32.8/ (v:f32.8* vlrc m1) (v:f32.8+ (v:f32.8-sqrt (v:f32.8* v1 vic2)) eps)))
                 (v:f32.8-aref g i) z))
         (let ((gi (* cs (aref g i))))
           (setf (aref mm i) (+ (* (f 0.9) (aref mm i)) (* (f 0.1) gi))
                 (aref vv i) (+ (* (f 0.99) (aref vv i)) (* (f 0.01) gi gi)))
           (setf (aref p i) (- (* shrink (aref p i)) (/ (* lrc (aref mm i)) (+ (sqrt (the (single-float 0f0) (* (aref vv i) ic2))) (f 1e-8)))))
           (setf (aref g i) (f 0))))))

(defun opt-step (pool opt lr wd)
  "Reduce worker grads, global-norm clip 1.0, AdamW -- all tensors in parallel on POOL. Returns the grad norm."
  (declare (double-float lr wd))
  (let ((asg (a-assign opt)) (gs (a-gs opt)) (parts (a-parts opt)))
    (declare (simple-vector asg gs) (dvec parts))
    (run-pool pool (lambda (th) (dolist (i (svref asg th)) (reduce-tensor (svref gs i) parts i))))
    (let* ((norm (sqrt (let ((s 0d0)) (declare (double-float s)) (loop for x across parts do (incf s x)) s)))
           (cs (coerce (if (> norm 1d0) (/ 1d0 norm) 1d0) 'fl)) (tn (incf (a-tn opt)))
           (c1 (- 1d0 (expt 0.9d0 tn))) (c2 (- 1d0 (expt 0.99d0 tn)))
           (lrc (coerce (/ lr c1) 'fl)) (ic2 (coerce (/ 1d0 c2) 'fl))
           (ps (a-ps opt)) (dec (a-decays opt)) (ms (coerce (a-ms opt) 'simple-vector)) (vs (coerce (a-vs opt) 'simple-vector))
           (sh-d (coerce (- 1d0 (* lr wd)) 'fl)))
      (run-pool pool (lambda (th) (dolist (i (svref asg th))
                                    (adam-tensor (svref ps i) (svref (svref gs i) 0) (svref ms i) (svref vs i) cs
                                                 (if (svref dec i) sh-d (f 1)) lrc ic2))))
      norm)))

;;; reference (serial) AdamW identical to gpt-big.lisp, used by the gradcheck/equivalence tests
(defun adamw (m opt grads lr wd)
  (declare (double-float lr wd))
  (let* ((norm (sqrt (loop for gr in grads sum (let ((gr gr)) (declare (fvec gr)) (loop for x across gr sum (* (coerce x 'double-float) x) of-type double-float)) of-type double-float)))
         (cs (coerce (if (> norm 1d0) (/ 1d0 norm) 1d0) 'fl)) (tn (incf (a-tn opt)))
         (c1 (- 1d0 (expt 0.9d0 tn))) (c2 (- 1d0 (expt 0.99d0 tn)))
         (lrc (coerce (/ lr c1) 'fl)) (ic2 (coerce (/ 1d0 c2) 'fl)))
    (loop for (p . decay) in (model-vecs m) for g in grads for mm in (a-ms opt) for vv in (a-vs opt)
          do (adam-tensor p g mm vv cs (coerce (if decay (- 1d0 (* lr wd)) 1d0) 'fl) lrc ic2))
    norm))
;;; ---------- gradient check (use FT=double) ----------
(defun gradcheck (&optional (p 0d0))
  (setf *pdrop* p)
  (let* ((c (make-cfg :v 11 :d 16 :nl 6 :nh 8 :tt 16)) (m (make-model* c)) (k 2) (b 2) (nt 16)
         (ws (loop repeat k collect (make-wk* c b))) (scale (coerce (/ 1d0 (* k b nt)) 'fl))
         (eps (if (eq *ft* 'single-float) 1d-2 1d-5)) (worst 0d0) (wa 0d0) (cnt 0) (sd2 0d0) (sn2 0d0))
    ;; perturb all params (so LN gains/biases are not trivially 1/0)
    (dolist (pv (model-vecs m)) (let ((p (car pv))) (declare (fvec p)) (dotimes (i (length p)) (incf (aref p i) (coerce (* 0.3 (randn)) 'fl)))))
    (dolist (w ws) (dotimes (q (* b nt)) (setf (aref (w-ids w) q) (random 11 *rs*) (aref (w-tgt w) q) (random 11 *rs*))))
    (dolist (w ws) (setf (w-drop w) (> p 0d0) (w-newmask w) t))
    (flet ((loss (bp) (dolist (w ws) (setf (w-loss w) 0d0 (w-count w) 0) (forward-backward m w nt 0 bp scale) (setf (w-newmask w) nil))
                 (* (coerce scale 'double-float) (loop for w in ws sum (w-loss w)))))
      (loss t)
      (loop for (p) in (model-vecs m) for g in (sum-grads ws) for name from 0
            do (let ((p p) (g g)) (declare (fvec p g))
                 (dotimes (i (length p))
                   (let* ((old (aref p i)) (pp (coerce (+ old eps) 'fl)) (pm (coerce (- old eps) 'fl))
                          (lp (progn (setf (aref p i) pp) (loss nil))) (lm (progn (setf (aref p i) pm) (loss nil)))
                          (num (/ (- lp lm) (- (coerce pp 'double-float) (coerce pm 'double-float)))) (an (coerce (aref g i) 'double-float)))
                     (setf (aref p i) old) (incf cnt) (incf sd2 (expt (- num an) 2)) (incf sn2 (expt num 2))
                     (setf wa (max wa (abs (- num an))) worst (if (> (+ (abs num) (abs an)) 1d-7) (max worst (/ (abs (- num an)) (+ (abs num) (abs an)))) worst)))))))
    (format t "gradcheck FT=~a dropout=~a (masks fixed): scaled-shape tiny GPT (V=11 d=16 L=6 heads=8 hd=2 T=16), 2 workers x 2 seqs, ~d params, eps=~a~%  max rel err (entries with |g|+|num|>1e-7) ~,3e, max abs err ~,3e, global |g-num|/|num| = ~,3e~%"
            *ft* p cnt eps worst wa (sqrt (/ sd2 sn2)))))

;;; ---------- training ----------
(defvar *steps-max* 0)
(defun main ()
  (setf *rs* (sb-ext:seed-random-state (parse-integer (opt "seed" "1"))))
  (setf *steps-max* (parse-integer (opt "steps" "0")))
  (%set-threads 1)
  (let* ((bytes (with-open-file (s (opt "data" "../input.txt") :element-type '(unsigned-byte 8))   ; ASCII corpus, read as octets
                  (let* ((b (make-array (file-length s) :element-type '(unsigned-byte 8))) (k (read-sequence b s))) (subseq b 0 k))))
         (chars (let ((seen (make-array 256 :initial-element nil)))
                  (loop for x across bytes do (setf (svref seen x) t))
                  (coerce (loop for i below 256 when (svref seen i) collect (code-char i)) 'simple-vector)))
         (v (length chars)) (c2i (let ((ht (make-hash-table))) (loop for ch across chars for i from 0 do (setf (gethash ch ht) i)) ht))
         (data (let ((lut (make-array 256 :element-type '(unsigned-byte 8) :initial-element 0)) (d (make-array (length bytes) :element-type '(unsigned-byte 8))))
                 (loop for ch across chars for i from 0 do (setf (aref lut (char-code ch)) i))
                 (loop for x across bytes for i from 0 do (setf (aref d i) (aref lut x))) d))
         (nall (length data)) (vstart (floor (* 0.9 nall)))             ; same fixed split as the ablation
         (tt (parse-integer (opt "ctx" "64"))) (c (make-cfg :v v :d (parse-integer (opt "d" "128")) :nl (parse-integer (opt "layers" "4"))
                                                       :nh (parse-integer (opt "heads" "4")) :tt tt))
         (k (parse-integer (opt "threads" "8"))) (bt (parse-integer (opt "batch" "32"))) (b (floor bt k))
         (lr0 (float (read-from-string (opt "lr" "1e-3")) 1d0)) (wd (float (read-from-string (opt "wd" "0.1")) 1d0))
         (budget (float (parse-integer (opt "secs" "480")) 1d0)) (warm 0.02d0)
         (pdrop (setf *pdrop* (float (read-from-string (opt "dropout" "0")) 1d0)))
         (m (make-model* c)) (ws (loop repeat k collect (make-wk* c b))) (opt (make-adam* m ws k)) (pool (make-pool* k))
         (scale (coerce (/ 1d0 (* bt tt)) 'fl)) (half (floor tt 2))
         (step 0) (t0 (get-internal-real-time)) (hist nil) (fhist nil) (eval-secs 0d0)
         (fevery (float (parse-integer (opt "fullval-every" "0")) 1d0)) (fnext (float (parse-integer (opt "fullval-every" "0")) 1d0)))
    (declare (fixnum step) (double-float eval-secs))
    (assert (= (* b k) bt))
    (labels ((secs () (/ (- (get-internal-real-time) t0) internal-time-units-per-second 1d0))
             (tsecs () (- (secs) eval-secs))     ; training time = wall time minus evaluation time
             (write-full () (with-open-file (fo (format nil "~a-full.csv" (opt "tag" "gpt")) :direction :output :if-exists :supersede)
                              (format fo "step,train_seconds,val_full~%") (dolist (r (reverse fhist)) (format fo "~{~a~^,~}~%" r))))
             (lr-at (fr) (if (< fr warm) (* lr0 (max 0.01d0 (/ fr warm)))
                             (+ (* 0.1d0 lr0) (* 0.9d0 lr0 0.5d0 (+ 1d0 (cos (* pi (min 1d0 (/ (- fr warm) (- 1d0 warm))))))))))
             (load-window (w s0 start)       ; sequence slot s0 of worker w <- window starting at START
               (dotimes (i tt) (setf (aref (w-ids w) (+ (* s0 tt) i)) (aref data (+ start i))
                                     (aref (w-tgt w) (+ (* s0 tt) i)) (aref data (+ start i 1)))))
             (val-loss (ntargets)
               ;; Windows of length tt with stride tt/2; score only the second half of each window
               ;; (so every scored char has between tt/2 and tt-1 chars of context). First scored target = vstart.
               (dolist (w ws) (setf (w-drop w) nil))
               (let* ((e0 (secs)) (starts (loop for s from (- vstart 1 half) by half
                                                while (and (< (+ s half 1) (+ vstart ntargets)) (<= (+ s tt 1) nall))
                                                collect s)))
                 (dolist (w ws) (setf (w-loss w) 0d0 (w-count w) 0))
                 (loop while starts
                       do (let ((batch (loop repeat bt while starts collect (pop starts))))
                            ;; pad incomplete batches by repeating the last window, then discount
                            (let* ((nreal (length batch)) (padded (append batch (make-list (- bt nreal) :initial-element (car (last batch))))))
                              (loop for w in ws for kk from 0
                                    do (dotimes (s0 b) (load-window w s0 (nth (+ (* kk b) s0) padded))))
                              (let ((before (mapcar (lambda (w) (cons (w-loss w) (w-count w))) ws)))
                                (run-pool pool (lambda (i) (forward-backward m (nth i ws) tt half nil scale)))
                                ;; drop padded sequences' contribution: recompute is costly, so pads are excluded by
                                ;; re-running only the real ones when the batch is partial (last batch only)
                                (when (< nreal bt)
                                  (loop for w in ws for (l0 . c0) in before do (setf (w-loss w) l0 (w-count w) c0))
                                  (let ((w1 (make-wk* c 1)))
                                    (dolist (s batch)
                                      (load-window w1 0 s)
                                      (forward-backward m w1 tt half nil scale)
                                      (incf (w-loss (car ws)) (w-loss w1)) (incf (w-count (car ws)) (w-count w1))
                                      (setf (w-loss w1) 0d0 (w-count w1) 0))))))))
                 (incf eval-secs (- (secs) e0))
                 (/ (loop for w in ws sum (w-loss w)) (loop for w in ws sum (w-count w))))))
      (format t "dropout=~a (emb, attn probs, attn/MLP residual outputs; off at eval)~%" pdrop)
      (format t "config: GPT d=~d layers=~d heads=~d ctx=~d vocab=~d params=~d | batch ~d seqs (~d tokens), threads=~d (x ~d seqs), FT=~a~%"
              (c-d c) (c-nl c) (c-nh c) tt v (nparams m) bt (* bt tt) k b *ft*)
      (format t "AdamW lr=~a betas 0.9/0.99 wd=~a clip 1.0, warmup 2% then cosine to lr/10 over ~ds of training time (eval excluded) | data ~a | train chars ~d, val chars ~d (last 10%)~%"
              lr0 wd (round budget) (opt "data" "../input.txt") vstart (- nall vstart))
      (format t "val protocol: windows of ~d, stride ~d, score 2nd half (context ~d..~d); periodic val = first 32000 val targets every 200 steps~%"
              tt half half (1- tt))
      (finish-output)
      (loop for el = (tsecs) while (and (< el budget) (or (zerop *steps-max*) (< step *steps-max*)))
            do (dolist (w ws)
                 (dotimes (s0 b) (load-window w s0 (random (- vstart tt 1) *rs*)))
                 (setf (w-loss w) 0d0 (w-count w) 0 (w-drop w) (> pdrop 0d0) (w-newmask w) t))
               (run-pool pool (lambda (i) (forward-backward m (nth i ws) tt 0 t scale)))
               (opt-step pool opt (lr-at (/ el budget)) wd)
               (incf step)
               (when (zerop (mod step 200))
                 (let ((tl (/ (loop for w in ws sum (w-loss w)) (loop for w in ws sum (w-count w)))) (vl (val-loss 32000)))
                   (format t "step ~6d  t=~6,1fs  wall=~6,1fs  lr=~,6f  train(last batch)=~,4f  val(subset)=~,4f~%" step (tsecs) (secs) (lr-at (/ (tsecs) budget)) tl vl)
                   (push (list step (tsecs) tl vl) hist) (finish-output)
                   (with-open-file (fo (format nil "~a.csv" (opt "tag" "gpt")) :direction :output :if-exists :supersede)
                     (format fo "step,seconds,train_batch,val_subset~%") (dolist (r (reverse hist)) (format fo "~{~a~^,~}~%" r)))))
               (when (and (> fevery 0d0) (>= (tsecs) fnext) (< (tsecs) budget))
                 (incf fnext fevery)
                 (let* ((ts (tsecs)) (vf (val-loss (min nall (parse-integer (opt "fullval-targets" "1000000000"))))))
                   (format t "FULLVAL step ~d  t=~,1fs  val(full~a)=~,4f~%" step ts (let ((ft (opt "fullval-targets" nil))) (if ft (format nil ", first ~a targets" ft) "")) vf) (finish-output)
                   (push (list step ts vf) fhist) (write-full))))
      (let ((s (tsecs)))
        (format t "trained ~d steps in ~,1fs training time (wall ~,1fs, eval ~,1fs): ~,2f steps/s, ~,0f tokens/s (training time)~%" step s (secs) eval-secs (/ step s) (/ (* step bt tt) s))
        (finish-output)
        (let ((vl (val-loss nall))) (format t "FINAL: val(full fixed val, ~d targets scored)=~,4f~%" (loop for w in ws sum (w-count w)) vl)
          (push (list step s vl) fhist) (write-full)) (finish-output))
      ;; sample 300 chars at T=0.8 from a newline, context window up to tt
      (let ((w (make-wk* c 1)) (ctx (list (gethash #\Newline c2i))))
        (format t "~%=== sample (T=0.8) ===~%~a~%"
                (with-output-to-string (o)
                  (dotimes (q 300)
                    (let* ((cl (last ctx tt)) (nt (length cl)))
                      (loop for ch in cl for i from 0 do (setf (aref (w-ids w) i) ch (aref (w-tgt w) i) 0))
                      (forward-backward m w nt 0 nil (f 1))
                      (let* ((P (w-P w)) (o0 (* (1- nt) v))
                             (wt (loop for j below v collect (expt (max (coerce (aref P (+ o0 j)) 'double-float) 1d-300) 1.25d0)))
                             (u (* (random 1d0 *rs*) (reduce #'+ wt))) (acc 0d0) (ch (1- v)))
                        (loop for x in wt for j from 0 do (incf acc x) (when (> acc u) (setf ch j) (return)))
                        (write-char (svref chars ch) o) (setf ctx (append ctx (list ch)))))))))
      (stop-pool pool))))

(let ((mode (opt "mode" "train")))
  (when (member "--run" sb-ext:*posix-argv* :test #'string=)
    (if (string= mode "gradcheck") (progn (gradcheck 0d0) (gradcheck 0.2d0) (gradcheck 0.5d0)) (main))))
