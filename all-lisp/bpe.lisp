;;;; bpe.lisp -- pure-Lisp replacement for efficiency/08-vocab-up/train_bpe.py (HF `tokenizers` BpeTrainer + encoder).
;;;; Same recipe: train split only (first VSTART chars of huge/corpus.txt), fed in fixed 1,000,000-char chunks,
;;;; GPT-2-style pre-tokenizer " ?[A-Za-z]+| ?[0-9]+| ?[^\sA-Za-z0-9]+|\s+(?!\S)|\s+" (hand-coded scanner, ASCII corpus),
;;;; min_frequency=2, initial alphabet = sorted corpus chars; HF merge order (max count, tie -> smallest (id_a,id_b)).
;;;; Encoding: ~1 MB pieces cut after the last newline (as in train_bpe.py), train / val[:1M] / val[1M:] separately,
;;;; HF merge_all semantics (lowest merge rank first, leftmost on ties). Output: vocabV.hex, mergesV.txt, tokensV.u16.
;;;; Usage: sbcl --dynamic-space-size 6000 --script bpe.lisp train V CORPUS OUTDIR
;;;;        sbcl --dynamic-space-size 6000 --script bpe.lisp encode-json BPEJSON CORPUS OUT.u16   (encode with an HF json, for checking)
(declaim (optimize (speed 3) (safety 0) (debug 0)))
(defpackage :bpe (:use :cl)) (in-package :bpe)
(deftype octets () '(simple-array (unsigned-byte 8) (*)))
(defconstant +nval+ 9988894)

(defun read-octets (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let ((b (make-array (file-length s) :element-type '(unsigned-byte 8)))) (read-sequence b s) b)))

(declaim (inline alpha-p digit-p space-p))
(defun alpha-p (c) (declare (fixnum c)) (or (<= 65 c 90) (<= 97 c 122)))
(defun digit-p (c) (declare (fixnum c)) (<= 48 c 57))
(defun space-p (c) (declare (fixnum c)) (or (= c 32) (<= 9 c 13)))
(defun punct-p (c) (declare (fixnum c)) (not (or (alpha-p c) (digit-p c) (space-p c))))

(defun pretokenize (txt s e fn)
  "Call FN on (start end) of every pre-token of TXT[s,e). Equivalent to the HF Split(Isolated) regex above on ASCII."
  (declare (octets txt) (fixnum s e) (function fn))
  (let ((i s))
    (declare (fixnum i))
    (flet ((run (j pred) (declare (fixnum j) (function pred)) (loop while (and (< j e) (funcall pred (aref txt j))) do (incf j)) j))
      (loop while (< i e) do
        (let* ((c (aref txt i)) (sp (and (= c 32) (< (1+ i) e))) (n (if sp (aref txt (1+ i)) 0)) (j 0))
          (declare (fixnum j))
          (setf j (cond ((or (alpha-p c) (and sp (alpha-p n))) (run (if (alpha-p c) i (1+ i)) #'alpha-p))
                        ((or (digit-p c) (and sp (digit-p n))) (run (if (digit-p c) i (1+ i)) #'digit-p))
                        ((or (punct-p c) (and sp (punct-p n))) (run (if (punct-p c) i (1+ i)) #'punct-p))
                        (t (let ((k (run i #'space-p)))   ; \s+(?!\S) then \s+
                             (declare (fixnum k))
                             (cond ((= k e) k) ((> (- k i) 1) (1- k)) (t k))))))
          (funcall fn i j) (setf i j))))))

;;; ---------- trainer ----------
(defun train (txt vstart vsize)
  (declare (octets txt) (fixnum vstart vsize))
  (let ((wc (make-hash-table :test 'equal)) (alpha (make-array 256 :initial-element nil)))
    (dotimes (i (length txt)) (setf (svref alpha (aref txt i)) t))   ; initial_alphabet = sorted(set(whole corpus))
    (loop for c0 of-type fixnum from 0 below vstart by 1000000
          do (pretokenize txt c0 (min vstart (+ c0 1000000))
                          (lambda (a b) (let ((k (map 'string #'code-char (subseq txt a b)))) (incf (the fixnum (gethash k wc 0)))))))
    (format t "unique words ~d~%" (hash-table-count wc)) (finish-output)
    (let* ((id->tok (make-array 0 :adjustable t :fill-pointer 0)) (tok->id (make-hash-table :test 'equal))
           (nw (hash-table-count wc)) (words (make-array nw)) (counts (make-array nw :element-type 'fixnum))
           (pc (make-hash-table :test 'eql)) (where (make-hash-table :test 'eql)) (merges '()))
      (dotimes (c 256) (when (svref alpha c) (let ((s (string (code-char c)))) (setf (gethash s tok->id) (fill-pointer id->tok)) (vector-push-extend s id->tok))))
      (let ((iw 0)) (declare (fixnum iw))
        (maphash (lambda (k v) (setf (aref words iw) (map '(vector fixnum) (lambda (ch) (gethash (string ch) tok->id)) k)
                                     (aref counts iw) v) (incf iw)) wc))
      (flet ((key (a b) (declare (fixnum a b)) (logior (ash a 20) b)))
        (dotimes (iw nw)
          (let ((w (aref words iw)))
            (loop for p from 0 below (1- (length w))
                  do (let ((k (key (aref w p) (aref w (1+ p))))) (incf (the fixnum (gethash k pc 0)) (aref counts iw))
                       (push iw (gethash k where))))))
        ;; max-heap of (count . key), order: count desc, then pair (a,b) asc == key asc
        (let ((heap (make-array 0 :adjustable t :fill-pointer 0)))
          (labels ((better (x y) (or (> (the fixnum (car x)) (the fixnum (car y))) (and (= (the fixnum (car x)) (the fixnum (car y))) (< (the fixnum (cdr x)) (the fixnum (cdr y))))))
                   (hpush (x) (vector-push-extend x heap)
                     (let ((i (1- (fill-pointer heap))))
                       (loop while (> i 0) do (let ((p (floor (1- i) 2))) (if (better (aref heap i) (aref heap p)) (progn (rotatef (aref heap i) (aref heap p)) (setf i p)) (return))))))
                   (hpop () (let ((top (aref heap 0)) (last (vector-pop heap)))
                              (when (> (fill-pointer heap) 0)
                                (setf (aref heap 0) last)
                                (let ((i 0) (n (fill-pointer heap)))
                                  (loop (let* ((l (+ 1 (* 2 i))) (r (1+ l)) (b i))
                                          (when (and (< l n) (better (aref heap l) (aref heap b))) (setf b l))
                                          (when (and (< r n) (better (aref heap r) (aref heap b))) (setf b r))
                                          (if (= b i) (return) (progn (rotatef (aref heap i) (aref heap b)) (setf i b)))))))
                              top)))
            (maphash (lambda (k v) (when (> v 0) (hpush (cons v k)))) pc)
            (loop
              (when (or (>= (fill-pointer id->tok) vsize) (zerop (fill-pointer heap))) (return))
              (let* ((top (hpop)) (k (cdr top)) (actual (gethash k pc 0)))
                (declare (fixnum k actual))
                (if (/= actual (the fixnum (car top)))
                    (hpush (cons actual k))
                    (progn
                      (when (or (< actual 1) (< actual 2)) (return))
                      (let* ((a (ash k -20)) (b (logand k #xFFFFF))
                             (nt (concatenate 'string (aref id->tok a) (aref id->tok b)))
                             (nid (or (gethash nt tok->id) (prog1 (fill-pointer id->tok) (setf (gethash nt tok->id) (fill-pointer id->tok)) (vector-push-extend nt id->tok))))
                             (upd (make-hash-table :test 'eql)))
                        (declare (fixnum a b nid))
                        (push (cons a b) merges)
                        (dolist (iw (let ((l (sort (copy-list (gethash k where)) #'<)) (o '())) (dolist (x l o) (unless (eql x (car o)) (push x o)))))
                          (let* ((w (aref words iw)) (cnt (aref counts iw)) (out (make-array (length w) :element-type 'fixnum :fill-pointer 0)) (i 0) (n (length w)))
                            (declare (fixnum i n cnt))
                            (flet ((ch (pair d) (incf (the fixnum (gethash pair pc 0)) (* d cnt)) (when (> d 0) (setf (gethash pair upd) (cons iw (gethash pair upd))))))
                              ;; HF Word::merge on a copy: left-to-right, non-overlapping
                              (let ((sy (coerce w 'list)) (res '()))
                                (declare (ignorable sy))
                                (loop while (< i n) do
                                  (if (and (< (1+ i) n) (= (aref w i) a) (= (aref w (1+ i)) b))
                                      (progn
                                        (when (> (fill-pointer out) 0)
                                          (let ((pv (aref out (1- (fill-pointer out))))) (ch (key pv a) -1) (ch (key pv nid) 1)))
                                        (vector-push nid out)
                                        (when (< (+ i 2) n) (let ((nx (aref w (+ i 2)))) (ch (key nid nx) 1) (ch (key b nx) -1)))
                                        (incf i 2))
                                      (progn (vector-push (aref w i) out) (incf i))))
                                (setf res nil)))
                            (setf (aref words iw) (coerce out '(simple-array fixnum (*))))))
                        (remhash k where)
                        (maphash (lambda (pair ws) (dolist (iw ws) (push iw (gethash pair where)))
                                   (let ((c (gethash pair pc 0))) (when (> c 0) (hpush (cons c pair))))) upd))))))))
        (values id->tok (nreverse merges))))))

;;; ---------- encoder ----------
(defun make-encoder (id->tok merges)
  "merges: list of (a . b) ids in rank order. Returns a function (txt s e) -> list of ids for one pre-token."
  (let ((rank (make-hash-table :test 'eql)) (tok->id (make-hash-table :test 'equal)) (cache (make-hash-table :test 'equal)) (r 0))
    (declare (fixnum r))
    (loop for i from 0 below (length id->tok) do (setf (gethash (aref id->tok i) tok->id) i))
    (dolist (m merges) (let ((k (logior (ash (the fixnum (car m)) 20) (the fixnum (cdr m)))))
                         (unless (gethash k rank) (setf (gethash k rank) (cons r (gethash (concatenate 'string (aref id->tok (car m)) (aref id->tok (cdr m))) tok->id)))))
                         (incf r))
    (lambda (txt s e)
      (declare (octets txt) (fixnum s e))
      (let ((key (map 'string #'code-char (subseq txt s e))))
        (or (gethash key cache)
            (setf (gethash key cache)
                  (let ((w (map 'list (lambda (ch) (gethash (string ch) tok->id)) key)))
                    (loop
                      (let ((best nil) (bpos nil) (bnew 0))
                        (loop for tail on w for p from 0 while (cdr tail)
                              do (let ((x (gethash (logior (ash (the fixnum (car tail)) 20) (the fixnum (cadr tail))) rank)))
                                   (when (and x (or (null best) (< (the fixnum (car x)) (the fixnum best)))) (setf best (car x) bpos p bnew (cdr x)))))
                        (unless best (return w))
                        (let ((tail (nthcdr bpos w))) (setf (car tail) bnew (cdr tail) (cddr tail))))))))))))

(defun encode-split (txt s e enc out)
  "train_bpe.py pieces(): ~1e6-char pieces cut after the last newline inside (i, j)."
  (declare (octets txt) (fixnum s e) (function enc))
  (let ((i s))
    (declare (fixnum i))
    (loop while (< i e) do
      (let ((j (min e (+ i 1000000))))
        (declare (fixnum j))
        (when (< j e) (let ((k (position 10 txt :start i :end j :from-end t))) (setf j (if (and k (> k i)) (1+ k) j))))
        (pretokenize txt i j (lambda (a b) (dolist (id (funcall enc txt a b)) (vector-push-extend id out))))
        (setf i j)))))

(defun encode-all (txt enc path)
  (let* ((n (length txt)) (vs (- n +nval+)) (out (make-array 30000000 :element-type '(unsigned-byte 16) :fill-pointer 0 :adjustable t)))
    (encode-split txt 0 vs enc out) (format t "train_tokens ~d~%" (fill-pointer out))
    (encode-split txt vs (+ vs 1000000) enc out) (format t "after val1m ~d~%" (fill-pointer out))
    (encode-split txt (+ vs 1000000) n enc out) (format t "total ~d~%" (fill-pointer out))
    (with-open-file (s path :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
      (let ((b (make-array (* 2 (fill-pointer out)) :element-type '(unsigned-byte 8))))
        (dotimes (i (fill-pointer out)) (let ((v (aref out i))) (setf (aref b (* 2 i)) (logand v 255) (aref b (1+ (* 2 i))) (ash v -8))))
        (write-sequence b s)))))

(defun json-merges (path)
  "Minimal reader for an HF tokenizer json: model.vocab is implied by vocabV.hex order; returns merges as string pairs."
  (let* ((s (map 'string #'code-char (read-octets path))) (p (search "\"merges\": [" s)) (i (+ p 11)) (res '()))
    (labels ((str () (loop until (char= (char s i) #\") do (incf i)) (incf i)
               (with-output-to-string (o)
                 (loop (let ((c (char s i))) (incf i)
                         (cond ((char= c #\") (return))
                               ((char= c #\\) (let ((d (char s i))) (incf i)
                                                (case d (#\n (write-char #\Newline o)) (#\t (write-char #\Tab o)) (#\u (write-char (code-char (parse-integer s :start i :end (+ i 4) :radix 16)) o) (incf i 4)) (t (write-char d o)))))
                               (t (write-char c o))))))))
      (loop (loop while (member (char s i) '(#\Space #\Newline #\,)) do (incf i))
            (if (char= (char s i) #\]) (return (nreverse res))
                (progn (incf i) (let* ((a (str)) (b (str))) (push (cons a b) res)) (loop until (char= (char s i) #\]) do (incf i)) (incf i)))))))

(defun hexstr (s) (format nil "~(~{~2,'0x~}~)" (map 'list #'char-code s)))
(defun unhex (h) (map 'string #'code-char (loop for i from 0 below (length h) by 2 collect (parse-integer h :start i :end (+ i 2) :radix 16))))

(let ((args (cdr sb-ext:*posix-argv*)))
  (cond ((string= (first args) "train")
         (let* ((v (parse-integer (second args))) (txt (read-octets (third args))) (dir (fourth args)) (t0 (get-internal-real-time)))
           (multiple-value-bind (id->tok merges) (train txt (- (length txt) +nval+) v)
             (format t "trained: vocab ~d merges ~d in ~,1fs~%" (length id->tok) (length merges) (/ (- (get-internal-real-time) t0) internal-time-units-per-second)) (finish-output)
             (with-open-file (o (format nil "~a/vocab~d.hex" dir v) :direction :output :if-exists :supersede)
               (loop for s across id->tok do (format o "~a~%" (hexstr s))))
             (with-open-file (o (format nil "~a/merges~d.txt" dir v) :direction :output :if-exists :supersede)
               (dolist (m merges) (format o "~d ~d~%" (car m) (cdr m))))
             (encode-all txt (make-encoder id->tok merges) (format nil "~a/tokens~d.u16" dir v))
             (format t "done in ~,1fs~%" (/ (- (get-internal-real-time) t0) internal-time-units-per-second)))))
        ((string= (first args) "encode-json")
         (let* ((hexf (fourth args)) (id->tok (coerce (with-open-file (s hexf) (loop for l = (read-line s nil) while l collect (unhex l))) 'vector))
                (t2i (let ((h (make-hash-table :test 'equal))) (loop for i from 0 for s across id->tok do (setf (gethash s h) i)) h))
                (merges (mapcar (lambda (m) (cons (gethash (car m) t2i) (gethash (cdr m) t2i))) (json-merges (second args)))))
           (encode-all (read-octets (third args)) (make-encoder id->tok merges) (fifth args))))))
