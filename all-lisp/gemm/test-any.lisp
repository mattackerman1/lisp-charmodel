;;;; Correctness of lgemm:sgemm vs OpenBLAS cblas_sgemm (random shapes, all transposes, offsets, beta 0/1/3.4445) + speed.
(load (or (sb-ext:posix-getenv "LGEMM") (merge-pathnames "../lgemm.lisp" *load-truename*)))
(defpackage :gt (:use :cl)) (in-package :gt)
(sb-alien:load-shared-object (or (sb-ext:posix-getenv "GPT_OPENBLAS") "/usr/lib/x86_64-linux-gnu/libopenblas.so.0"))
(sb-alien:define-alien-routine ("cblas_sgemm" %sgemm) sb-alien:void
  (order sb-alien:int) (ta sb-alien:int) (tb sb-alien:int) (m sb-alien:int) (n sb-alien:int) (k sb-alien:int)
  (alpha sb-alien:single-float) (a sb-sys:system-area-pointer) (lda sb-alien:int) (b sb-sys:system-area-pointer) (ldb sb-alien:int)
  (beta sb-alien:single-float) (c sb-sys:system-area-pointer) (ldc sb-alien:int))
(sb-alien:define-alien-routine ("openblas_set_num_threads" %set-threads) sb-alien:void (n sb-alien:int))
(%set-threads 1)
(defun ob (ta tb m n k alpha A ao lda B bo ldb beta C co ldc)
  (sb-sys:with-pinned-objects (A B C)
    (%sgemm 101 (if ta 112 111) (if tb 112 111) m n k alpha (sb-sys:sap+ (sb-sys:vector-sap A) (* 4 ao)) lda
            (sb-sys:sap+ (sb-sys:vector-sap B) (* 4 bo)) ldb beta (sb-sys:sap+ (sb-sys:vector-sap C) (* 4 co)) ldc)))
(defun rv (n) (let ((a (make-array n :element-type 'single-float))) (dotimes (i n a) (setf (aref a i) (- (random 2f0) 1f0)))))
(setf *random-state* (sb-ext:seed-random-state 7))
(let ((worst 0d0) (ntest 0))
  (dotimes (trial 400)
    (let* ((m (1+ (random 140))) (n (1+ (random 300))) (k (1+ (random 600))) (ta (zerop (random 2))) (tb (zerop (random 2)))
           (pad (random 5)) (lda (+ pad (if ta m k))) (ldb (+ pad (if tb k n))) (ldc (+ pad n)) (ao (random 9)) (bo (random 9)) (co (random 9))
           (alpha (nth (random 3) '(1f0 0.125f0 2.0315f0))) (beta (nth (random 3) '(0f0 1f0 3.4445f0)))
           (A (rv (+ ao (* lda (if ta k m))))) (B (rv (+ bo (* ldb (if tb n k))))) (C0 (rv (+ co (* ldc m) 16))) (C1 (copy-seq C0)) (C2 (copy-seq C0)))
      (ob ta tb m n k alpha A ao lda B bo ldb beta C1 co ldc)
      (lgemm:sgemm ta tb m n k alpha A ao lda B bo ldb beta C2 co ldc)
      (let ((e 0d0) (s 0d0))
        (dotimes (i (length C1)) (setf e (max e (abs (- (aref C1 i) (aref C2 i))))) (setf s (max s (abs (aref C1 i)))))
        (setf worst (max worst (/ e (max s 1d-30)))) (incf ntest)
        ;; untouched padding/outside cells must be bitwise equal
        (dotimes (i co) (assert (= (aref C1 i) (aref C2 i)))))))
  (format t "correctness: ~d random GEMMs (m<=140 n<=300 k<=600, all ta/tb, offsets, pads, beta 0/1/3.4445): max |lisp-openblas|/max|C| = ~,3e ~a~%"
          ntest worst (if (< worst 1d-5) "PASS" "FAIL")))
(defun now () (/ (get-internal-real-time) (float internal-time-units-per-second 1d0)))
(defun bench (name ta tb m n k nth)
  (let* ((A (rv (* m k))) (B (rv (* k n))) (Cs (loop repeat nth collect (rv (* m n)))) (flop (* 2d0 m n k)) (res '()))
    (dolist (impl '(:openblas :lisp))
      (let ((reps (max 3 (floor 2d9 flop))) (t0 0d0))
        (flet ((run (C) (dotimes (r reps) (if (eq impl :lisp) (lgemm:sgemm ta tb m n k 1f0 A 0 (if ta m k) B 0 (if tb k n) 0f0 C 0 n)
                                               (ob ta tb m n k 1f0 A 0 (if ta m k) B 0 (if tb k n) 0f0 C 0 n)))))
          (run (first Cs)) (setf t0 (now))
          (let ((ths (loop for C in (rest Cs) collect (let ((C C)) (sb-thread:make-thread (lambda () (run C)))))))
            (run (first Cs)) (mapc #'sb-thread:join-thread ths))
          (push (/ (* nth reps flop) (- (now) t0) 1d9) res))))
    (setf res (reverse res))
    (format t "~28a ~d thr: OpenBLAS ~6,1f GF/s  Lisp ~6,1f GF/s  ratio ~,2f~%" name nth (first res) (second res) (/ (second res) (first res)))))
(dolist (nth '(1 8))
  (bench "qkv fwd 512x768x256" nil nil 512 768 256 nth)
  (bench "fc2 wgrad T 1024x256x512" t nil 1024 256 512 nth)
  (bench "dX nT 512x1024x256" nil t 512 256 1024 nth)
  (bench "head fwd nT 512x16384x256" nil t 512 16384 256 nth)
  (bench "head wgrad T 16384x256x512" t nil 16384 256 512 nth)
  (bench "attn nT 64x64x32" nil t 64 64 32 nth)
  (bench "muon 256x256x1024" nil t 256 256 1024 nth))
