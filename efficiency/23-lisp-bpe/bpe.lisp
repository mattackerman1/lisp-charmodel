;;;; bpe.lisp -- Common Lisp port of 08-vocab-up/train_bpe.py (HF tokenizers BpeTrainer + BPE encode), SBCL.
;;;; Usage: sbcl --dynamic-space-size 6000 --script bpe.lisp V OUTDIR
;;;; Writes OUTDIR/{merges,vocab}V.hex, OUTDIR/tokensV.u16, prints TRAIN_WALL / ENCODE_WALL and does a decode round-trip check.
;;;; Reproduces HF exactly: pretokenizer Split(PAT, isolated) on 1M-char training chunks, alphabet sorted by code point,
;;;; merge queue ordered by (count desc, pair ids asc) with lazy count refresh, min_frequency=2, stop at |vocab|>=V;
;;;; encode = lowest-rank pair first, leftmost on ties, on the same ~1MB newline-cut pieces.
(declaim (optimize (speed 2) (safety 1) (debug 0)))
(defpackage :bpe (:use :cl)) (in-package :bpe)
(deftype octets () '(simple-array (unsigned-byte 8) (*)))
(defun now () (/ (get-internal-real-time) (float internal-time-units-per-second 1d0)))
(defvar *t0* (now))
(defun read-octets (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let* ((b (make-array (file-length s) :element-type '(unsigned-byte 8)))) (assert (= (read-sequence b s) (length b))) b)))
;; character classes of PAT = " ?[A-Za-z]+| ?[0-9]+| ?[^\sA-Za-z0-9]+|\s+(?!\S)|\s+"   (0=ws 1=letter 2=digit 3=other)
(declaim (inline cls))
(defun cls (c) (declare (type (unsigned-byte 8) c))
  (cond ((or (= c 32) (<= 9 c 13)) 0) ((or (<= 65 c 90) (<= 97 c 122)) 1) ((<= 48 c 57) 2) (t 3)))
(defun pretokenize (buf s e fn)
  "Call FN on each (start end) piece of buf[s,e), exactly as onig's isolated Split with PAT."
  (declare (type octets buf) (type fixnum s e) (type function fn))
  (let ((i s))
    (declare (type fixnum i))
    (loop while (< i e) do
      (let* ((c (aref buf i)) (k (cls c)) (j i))
        (declare (type fixnum j))
        (cond ((and (= c 32) (< (1+ i) e) (/= 0 (cls (aref buf (1+ i)))))
               (let ((k2 (cls (aref buf (1+ i))))) (setf j (+ i 2))
                 (loop while (and (< j e) (= k2 (cls (aref buf j)))) do (incf j))))
              ((/= k 0) (setf j (1+ i)) (loop while (and (< j e) (= k (cls (aref buf j)))) do (incf j)))
              (t (setf j (1+ i)) (loop while (and (< j e) (= 0 (cls (aref buf j)))) do (incf j))
                 (when (and (< j e) (> (- j i) 1)) (decf j))))   ; \s+(?!\S) backs off one; single ws -> \s+
        (funcall fn i j) (setf i j)))))

(defun main ()
  (let* ((v (parse-integer (second sb-ext:*posix-argv*))) (outdir (third sb-ext:*posix-argv*))
         (buf (read-octets "../../huge/corpus.txt")) (nall (length buf)) (nval 9988894) (vstart (- nall nval))
         (id2w (make-array 0 :adjustable t :fill-pointer 0)) (w2id (make-hash-table :test 'equal))
         (bid (make-array 256 :initial-element -1)))
    (declare (type octets buf) (type fixnum v vstart))
    (assert (= vstart 89900043))
    ;; alphabet: all chars of the whole corpus, sorted by code point
    (let ((seen (make-array 256 :element-type 'bit :initial-element 0)))
      (loop for c across buf do (setf (sbit seen c) 1))
      (dotimes (c 256) (when (= 1 (sbit seen c))
                         (let ((s (string (code-char c)))) (setf (aref bid c) (length id2w) (gethash s w2id) (length id2w)) (vector-push-extend s id2w)))))
    (format t "alphabet ~d~%" (length id2w))
    ;; word counts over 1M-char chunks of train
    (let ((wc (make-hash-table :test 'equal)))
      (loop for cs from 0 below vstart by 1000000
            do (pretokenize buf cs (min vstart (+ cs 1000000))
                            (lambda (a b) (let ((w (map 'simple-base-string #'code-char (subseq buf a b)))) (incf (the fixnum (gethash w wc 0)))))))
      (let* ((nw (hash-table-count wc)) (words (make-array nw)) (counts (make-array nw :element-type 'fixnum)) (stamp (make-array nw :element-type 'fixnum :initial-element -1))
             (pc (make-hash-table :test 'eql :size 400000)) (where (make-hash-table :test 'eql :size 400000))
             (heap (make-array 1024 :element-type 'fixnum :adjustable t :fill-pointer 0)) (merges '()) (i 0))
        (declare (type fixnum i))
        (format t "unique words ~d (~,1fs)~%" nw (- (now) *t0*))
        (maphash (lambda (w c) (setf (aref words i) (map '(simple-array fixnum (*)) (lambda (ch) (aref bid (char-code ch))) w) (aref counts i) c) (incf i)) wc)
        (setf wc nil)
        (labels ((key (a b) (+ (* a 65536) b))
                 (prio (cnt pk) (+ (ash cnt 32) (- #xFFFFFFFF pk)))
                 (hpush (x) (vector-push-extend x heap)
                   (let ((j (1- (fill-pointer heap))))
                     (loop while (> j 0) do (let ((p (ash (1- j) -1))) (if (> x (aref heap p)) (progn (setf (aref heap j) (aref heap p)) (setf j p)) (return))))
                     (setf (aref heap j) x)))
                 (hpop () (let* ((top (aref heap 0)) (x (vector-pop heap)) (n (fill-pointer heap)))
                            (when (> n 0)
                              (let ((j 0)) (loop (let* ((l (1+ (* 2 j))) (r (1+ l)) (m j) (mv x))
                                                   (when (and (< l n) (> (aref heap l) mv)) (setf m l mv (aref heap l)))
                                                   (when (and (< r n) (> (aref heap r) mv)) (setf m r mv (aref heap r)))
                                                   (if (= m j) (return) (progn (setf (aref heap j) mv) (setf j m)))))
                                (setf (aref heap j) x)))
                            top))
                 (addwhere (pk w) (let ((vv (or (gethash pk where) (setf (gethash pk where) (make-array 4 :element-type 'fixnum :adjustable t :fill-pointer 0)))))
                                    (vector-push-extend w vv))))
          (dotimes (w nw) (let ((s (aref words w)) (c (aref counts w)))
                            (loop for j from 0 below (1- (length s)) do (let ((pk (key (aref s j) (aref s (1+ j))))) (incf (the fixnum (gethash pk pc 0)) c) (addwhere pk w)))))
          (maphash (lambda (pk c) (when (> c 0) (hpush (prio c pk)))) pc)
          (let ((it 0) (upd (make-hash-table :test 'eql)))
            (loop
              (when (>= (hash-table-count w2id) v) (return))
              (when (= 0 (fill-pointer heap)) (return))
              (let* ((top (hpop)) (cnt (ash top -32)) (pk (- #xFFFFFFFF (ldb (byte 32 0) top))) (cur (gethash pk pc 0)))
                (if (/= cnt cur) (hpush (prio cur pk))
                    (progn
                      (when (or (< cnt 1) (> 2 cnt)) (return))
                      (let* ((a (ash pk -16)) (b (ldb (byte 16 0) pk)) (nt (concatenate 'string (aref id2w a) (aref id2w b)))
                             (nid (or (gethash nt w2id) (prog1 (length id2w) (setf (gethash nt w2id) (length id2w)) (vector-push-extend nt id2w)))))
                        (push (list a b nid) merges) (incf it) (clrhash upd)
                        (loop for w across (gethash pk where #()) unless (= (aref stamp w) it) do
                          (setf (aref stamp w) it)
                          (let* ((s (aref words w)) (c (aref counts w)) (out (make-array (length s) :element-type 'fixnum :fill-pointer 0)) (n (length s)) (j 0))
                            (declare (type fixnum j n c))
                            (flet ((chg (x y d) (let ((k2 (key x y))) (incf (the fixnum (gethash k2 pc 0)) (* d c)) (when (> d 0) (addwhere k2 w) (setf (gethash k2 upd) t)))))
                              ;; same left-to-right scan as HF Word::merge (prev uses the already-merged output symbol)
                              (loop while (< j n) do
                                (if (and (= (aref s j) a) (< (1+ j) n) (= (aref s (1+ j)) b))
                                    (progn (when (> (fill-pointer out) 0) (let ((p (aref out (1- (fill-pointer out))))) (chg p a -1) (chg p nid 1)))
                                           (vector-push nid out)
                                           (when (< (+ j 2) n) (chg b (aref s (+ j 2)) -1) (chg nid (aref s (+ j 2)) 1))
                                           (incf j 2))
                                    (progn (vector-push (aref s j) out) (incf j)))))
                            (setf (aref words w) (coerce out '(simple-array fixnum (*))))))
                        (maphash (lambda (k2 x) (declare (ignore x)) (let ((c2 (gethash k2 pc 0))) (when (> c2 0) (hpush (prio c2 k2))))) upd)))))))
          (setf merges (nreverse merges))
          (format t "TRAIN_WALL ~,2f merges ~d vocab ~d~%" (- (now) *t0*) (length merges) (length id2w)) (finish-output)
          (flet ((hex (s) (format nil "~(~{~2,'0x~}~)" (map 'list #'char-code s))))
            (with-open-file (f (format nil "~a/merges~d.hex" outdir v) :direction :output :if-exists :error)
              (dolist (m merges) (format f "~a ~a~%" (hex (aref id2w (first m))) (hex (aref id2w (second m))))))
            (with-open-file (f (format nil "~a/vocab~d.hex" outdir v) :direction :output :if-exists :error)
              (loop for s across id2w do (format f "~a~%" (hex s)))))
          ;; ---- encode ----
          (setf words nil where nil pc nil heap nil) (sb-ext:gc :full t)
          (let* ((t1 (now)) (ranks (make-hash-table :test 'eql)) (cache (make-hash-table :test 'equal))
                 (out (make-array 30000000 :element-type '(unsigned-byte 16) :fill-pointer 0)))
            (loop for (a b nid) in merges for r from 0 do (let ((k (key a b))) (unless (gethash k ranks) (setf (gethash k ranks) (cons r nid)))))
            (labels ((enc-word (st en)
                       (let* ((w (map 'simple-base-string #'code-char (subseq buf st en))) (ids (gethash w cache)))
                         (unless ids
                           (let ((s (map 'list (lambda (ch) (aref bid (char-code ch))) w)))
                             (loop (let ((best nil) (bc nil))
                                     (loop for c on s while (cdr c) do (let ((rk (gethash (key (car c) (cadr c)) ranks)))
                                                                         (when (and rk (or (null best) (< (car rk) (car best)))) (setf best rk bc c))))
                                     (if best (setf (car bc) (cdr best) (cdr bc) (cddr bc)) (return))))
                             (setf ids s (gethash w cache) s)))
                         (dolist (x ids) (vector-push-extend x out))))
                     (enc (s e)  ; same ~1 MB newline-cut pieces as Python
                       (let ((i s) (n0 (fill-pointer out)))
                         (loop while (< i e) do
                           (let ((j (min e (+ i 1000000))))
                             (when (< j e) (let ((k (position 10 buf :start i :end j :from-end t))) (when (and k (> k i)) (setf j (1+ k)))))
                             (pretokenize buf i j #'enc-word) (setf i j)))
                         (- (fill-pointer out) n0))))
              (let* ((ntr (enc 0 vstart)) (nv1 (enc vstart (+ vstart 1000000))) (nv2 (enc (+ vstart 1000000) nall)))
                (format t "ENCODE_WALL ~,2f train_tokens ~d val_tokens ~d val1m_tokens ~d~%" (- (now) t1) ntr (+ nv1 nv2) nv1) (finish-output)
                (with-open-file (f (format nil "~a/tokens~d.u16" outdir v) :direction :output :if-exists :error :element-type '(unsigned-byte 8))
                  (let ((b (make-array (* 2 (length out)) :element-type '(unsigned-byte 8))))
                    (dotimes (k (length out)) (setf (aref b (* 2 k)) (ldb (byte 8 0) (aref out k)) (aref b (1+ (* 2 k))) (ldb (byte 8 8) (aref out k))))
                    (write-sequence b f)))
                ;; decode round-trip: concatenated vocab strings of train tokens == train chars, val tokens == val chars
                (let ((pos 0) (ok t))
                  (declare (type fixnum pos))
                  (dotimes (k (length out)) (loop for ch across (aref id2w (aref out k)) do (unless (and (< pos nall) (= (char-code ch) (aref buf pos))) (setf ok nil)) (incf pos))
                    (when (= (1+ k) ntr) (format t "ROUNDTRIP train ~a (pos ~d = vstart ~d)~%" (and ok (= pos vstart)) pos vstart)))
                  (format t "ROUNDTRIP val+all ~a (pos ~d = nall ~d)~%" (and ok (= pos nall)) pos nall))))))))))
(main)
