;; sbcl --script count.lisp FILE FIRST-NAME : prints lines/atoms/conses for whole file, model/ops portion (FIRST..forward-backward), and kernels
(require :sb-simd)
(defun size (x) (cond ((consp x) (+ 1 (size (car x)) (size (cdr x)))) ((null x) 0) (t 1)))  ; conses + non-nil atoms
(defun conses (x) (if (consp x) (+ 1 (conses (car x)) (conses (cdr x))) 0))
(let* ((file (second sb-ext:*posix-argv*)) (first (third sb-ext:*posix-argv*))
       (kernels '("+GC+" "GELU64" "GELU-BACK64" "*EW32*" "VEXP-NEG32" "VTANH32" "GELU32" "GELU-BACK32" "SOFTMAX-ROW"))
       (forms nil) (*read-eval* nil))
  (with-open-file (s file)
    (loop for f = (read s nil :eof) until (eq f :eof)
          do (push f forms)
             (when (and (consp f) (member (car f) '(defpackage in-package))) (eval f))))
  (setf forms (nreverse forms))
  (flet ((nm (f) (and (consp f) (consp (cdr f)) (let ((x (second f))) (cond ((symbolp x) (symbol-name x)) ((and (consp x) (symbolp (car x))) (symbol-name (car x))))))))
    (let* ((i0 (position first forms :key #'nm :test #'equal)) (i1 (position "FORWARD-BACKWARD" forms :key #'nm :test #'equal))
           (ops (subseq forms i0 (1+ i1)))
           (ker (remove-if-not (lambda (f) (or (member (nm f) kernels :test #'equal)
                                               (and (consp f) (eq (car f) 'declaim) (consp (second f)) (member (symbol-name (car (second f))) '("INLINE")) )))
                               ops)))
      (format t "whole: ~d forms, tree size ~d (conses ~d)~%" (length forms) (size forms) (conses forms))
      (format t "ops:   ~d forms, tree size ~d (conses ~d)~%" (length ops) (size ops) (conses ops))
      (format t "ops w/o shared kernels: tree size ~d (kernel forms ~d, size ~d)~%" (- (size ops) (size ker)) (length ker) (size ker)))))
