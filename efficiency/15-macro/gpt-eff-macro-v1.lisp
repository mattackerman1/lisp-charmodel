(declaim (sb-ext:muffle-conditions sb-ext:compiler-note))
;;;; gpt-eff-macro.lisp -- gpt-eff.lisp rewritten with DEFOP/TAPE: each op's forward and backward come from one definition (see MACRO.md)
;;;; gpt-eff.lisp -- gpt-huge.lisp + LR-schedule options (sched=cosine|wsd warm= decay= lrmin=) and separated val series:
;;;;   <tag>-val1m.csv = val on the first VAL1M val chars every fullval-every s AND at the end; <tag>-final.csv = full 10% val at the end only.
;;;; gpt-huge.lisp -- gpt-fast.lisp with octet (ASCII) corpus loading for ~100 MB corpora and fullval-targets= (cap on periodic val).
;;;; gpt-fast.lisp -- faster gpt-big.lisp with the same maths (same model, init, RNG streams, dropout masks, optimizer).
;;;; Speedups vs gpt-big.lisp (see REPORT.md):
;;;;  1. GELU: tanh computed once in the forward pass and cached (double) for the backward; GELU fwd/bwd and the
;;;;     exp() in both softmaxes vectorized with sb-simd AVX2 (4 x double), same operation sequence => bitwise-equal.
;;;;  2. AdamW + cross-worker gradient reduction run in parallel on the worker threads (whole parameter tensors per
;;;;     thread, LPT-balanced), vectorized 8 x float; grad-norm summed in the original order => bitwise-equal.
;;;;  3. Persistent thread pool (mutex/condvar generation barrier) instead of make-thread/join-thread every step.
;;;;  4. Element-wise loops (dropout multiply, residual adds, bias grads, LN apply, softmax normalize) vectorized;
;;;;     branch-free dropout mask generation (same xorshift stream).
;;;; Single-float only (FT=double is not supported here; use gpt-big.lisp for the double-precision gradcheck).
(eval-when (:compile-toplevel :load-toplevel :execute) (require :sb-simd))
(defpackage :gpt (:use :cl) (:local-nicknames (:v :sb-simd-avx2))) (in-package :gpt)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defparameter *ft* 'single-float)
  (when (equal (sb-ext:posix-getenv "FT") "double") (error "gpt-fast.lisp is single-float only")))
(declaim (optimize (speed 3) (safety 0) (debug 0)))
(deftype fl () 'single-float)
(deftype fvec () '(simple-array single-float (*)))
(deftype dvec () '(simple-array double-float (*)))
(deftype idx () '(unsigned-byte 40))
(deftype dim () '(unsigned-byte 24))
(defmacro f (x) (coerce x *ft*))
(declaim (inline mkv)) (defun mkv (n) (make-array n :element-type 'single-float :initial-element 0f0))
(defun mkd (n) (make-array n :element-type 'double-float :initial-element 0d0))
(defun opt (key default)
  (let ((a (find-if (lambda (s) (and (> (length s) (length key)) (string= (concatenate 'string key "=") s :end2 (1+ (length key)))))
                    sb-ext:*posix-argv*)))
    (if a (subseq a (1+ (length key))) default)))
(defvar *rs* (sb-ext:seed-random-state 1))
(defvar *pdrop* 0d0)
(defun randn () (* (sqrt (* -2d0 (log (- 1d0 (random 1d0 *rs*))))) (cos (* 2 pi (random 1d0 *rs*)))))

;;; ---------- math helpers (double internally); scalar versions identical to gpt-big.lisp ----------
(defmacro horner (x &rest cs) (if (cdr cs) `(+ ,(car cs) (* ,x (horner ,x ,@(cdr cs)))) (car cs)))
(declaim (inline exp-neg tanh-d))
(defun exp-neg (y)
  (declare (double-float y))
  (if (< y -700d0) 0d0
      (let* ((n (floor (+ (* (the (double-float -700d0 0d0) y) 1.4426950408889634d0) 0.5d0)))
             (r (- (- y (* n 0.6931471803691238d0)) (* n 1.9082149292705877d-10)))
             (p (horner r 1d0 1d0 0.5d0 1.6666666666666666d-1 4.1666666666666664d-2 8.333333333333333d-3
                        1.388888888888889d-3 1.984126984126984d-4 2.48015873015873d-5 2.7557319223985893d-6
                        2.755731922398589d-7 2.505210838544172d-8 2.08767569878681d-9)))
        (declare (type (integer -1010 1) n))
        (* p (sb-kernel:make-double-float (ash (+ n 1023) 20) 0)))))
(defun tanh-d (x)
  (declare (double-float x))
  (if (> (abs x) 19d0) (if (> x 0d0) 1d0 -1d0)
      (let* ((e (exp-neg (* -2d0 (abs x)))) (th (/ (- 1d0 e) (+ 1d0 e)))) (if (< x 0d0) (- th) th))))

;;; ---------- SIMD versions: same IEEE operations in the same order (no FMA), 4 lanes ----------
(defmacro vhorner (x &rest cs) (if (cdr cs) `(v:f64.4+ (v:f64.4 ,(car cs)) (v:f64.4* ,x (vhorner ,x ,@(cdr cs)))) `(v:f64.4 ,(car cs))))
(declaim (inline vexp-neg vtanh))
(defun vexp-neg (y)
  "Lane-wise EXP-NEG. floor() via round-to-nearest + correction; 2^n built in the exponent field."
  (let* ((big (v:f64.4< y (v:f64.4 -700d0)))
         (yc (v:f64.4-max y (v:f64.4 -700d0)))
         (z (v:f64.4+ (v:f64.4* yc (v:f64.4 1.4426950408889634d0)) (v:f64.4 0.5d0)))
         (rn (v:f64.4-round z))
         (n (v:f64.4-if (v:f64.4> rn z) (v:f64.4- rn (v:f64.4 1d0)) rn))
         (r (v:f64.4- (v:f64.4- yc (v:f64.4* n (v:f64.4 0.6931471803691238d0))) (v:f64.4* n (v:f64.4 1.9082149292705877d-10))))
         (p (vhorner r 1d0 1d0 0.5d0 1.6666666666666666d-1 4.1666666666666664d-2 8.333333333333333d-3
                     1.388888888888889d-3 1.984126984126984d-4 2.48015873015873d-5 2.7557319223985893d-6
                     2.755731922398589d-7 2.505210838544172d-8 2.08767569878681d-9))
         (sc (v:f64.4! (v:u64.4-shiftl (v:u64.4- (v:u64.4! (v:f64.4+ n (v:f64.4 (+ 1023d0 4503599627370496d0))))
                                                 (v:u64.4 #x4330000000000000)) 52))))
    (v:f64.4-if big (v:f64.4 0d0) (v:f64.4* p sc))))
(defun vtanh (x)
  (let* ((sign (v:f64.4-and x (v:f64.4! (v:u64.4 #x8000000000000000))))
         (ax (v:f64.4-and x (v:f64.4! (v:u64.4 #x7FFFFFFFFFFFFFFF))))
         (e (vexp-neg (v:f64.4* (v:f64.4 -2d0) (v:f64.4-min ax (v:f64.4 19d0)))))
         (th (v:f64.4/ (v:f64.4- (v:f64.4 1d0) e) (v:f64.4+ (v:f64.4 1d0) e))))
    (v:f64.4-xor (v:f64.4-if (v:f64.4> ax (v:f64.4 19d0)) (v:f64.4 1d0) th) sign)))

;;; element-wise float helpers (8 lanes + scalar tail).
;;; NOTE: VZEROUPPER is only issued where no YMM value is live afterwards (it would clobber hoisted broadcasts).
(defmacro do8 ((q n) vec-body scalar-body)
  `(let ((n8 (logand ,n (lognot 7))))
     (declare (idx n8))
     (loop for ,q of-type idx from 0 below n8 by 8 do ,vec-body)
     (loop for ,q of-type idx from n8 below ,n do ,scalar-body)))
(defun vmul (a m n) (declare (fvec a m) (idx n))
  (do8 (q n) (setf (v:f32.8-aref a q) (v:f32.8* (v:f32.8-aref a q) (v:f32.8-aref m q)))
       (setf (aref a q) (* (aref a q) (aref m q)))))
(defun vmul-into (o a m n) (declare (fvec o a m) (idx n))
  (do8 (q n) (setf (v:f32.8-aref o q) (v:f32.8* (v:f32.8-aref a q) (v:f32.8-aref m q)))
       (setf (aref o q) (* (aref a q) (aref m q)))))
(defun vmul-off (o oo a ao m mo n)   ; o[oo+q] = a[ao+q]*m[mo+q]
  (declare (fvec o a m) (idx oo ao mo n))
  (do8 (q n) (setf (v:f32.8-aref o (+ oo q)) (v:f32.8* (v:f32.8-aref a (+ ao q)) (v:f32.8-aref m (+ mo q))))
       (setf (aref o (+ oo q)) (* (aref a (+ ao q)) (aref m (+ mo q))))))
(defun vadd (a b n) (declare (fvec a b) (idx n))   ; a += b
  (do8 (q n) (setf (v:f32.8-aref a q) (v:f32.8+ (v:f32.8-aref a q) (v:f32.8-aref b q)))
       (setf (aref a q) (+ (aref a q) (aref b q)))))

;;; ---------- BLAS ----------
;; HARDENING: GPT_OPENBLAS env overrides the library path (launchers point it at /home/box/opt/openblas, which survives box restarts)
(sb-alien:load-shared-object (or (sb-ext:posix-getenv "GPT_OPENBLAS") "/usr/lib/x86_64-linux-gnu/libopenblas.so.0"))
(sb-alien:define-alien-routine ("cblas_sgemm" %sgemm) sb-alien:void
  (order sb-alien:int) (ta sb-alien:int) (tb sb-alien:int) (m sb-alien:int) (n sb-alien:int) (k sb-alien:int)
  (alpha sb-alien:single-float) (a sb-sys:system-area-pointer) (lda sb-alien:int) (b sb-sys:system-area-pointer) (ldb sb-alien:int)
  (beta sb-alien:single-float) (c sb-sys:system-area-pointer) (ldc sb-alien:int))
(sb-alien:define-alien-routine ("openblas_set_num_threads" %set-threads) sb-alien:void (n sb-alien:int))
;; #5 low precision: prec=bf16 routes GEMMs with m*n*k >= lpmin through 05-precision/libgemmlp.so (inputs rounded to bf16,
;; MKL AMX bf16 GEMM, fp32 accumulate/output); prec=mklf32 routes the same calls to MKL fp32 sgemm (library control).
(defvar *gemm-mode* 0) (declaim (type fixnum *gemm-mode*)) (defvar *lp-min* 1000000) (declaim (type fixnum *lp-min*))
(let ((lp (merge-pathnames "05-precision/libgemmlp.so" (directory-namestring *load-truename*))))
  (when (probe-file lp) (sb-alien:load-shared-object lp)))
(macrolet ((def (lname cname)
             `(sb-alien:define-alien-routine (,cname ,lname) sb-alien:void
                (order sb-alien:int) (ta sb-alien:int) (tb sb-alien:int) (m sb-alien:int) (n sb-alien:int) (k sb-alien:int)
                (alpha sb-alien:single-float) (a sb-sys:system-area-pointer) (lda sb-alien:int) (b sb-sys:system-area-pointer) (ldb sb-alien:int)
                (beta sb-alien:single-float) (c sb-sys:system-area-pointer) (ldc sb-alien:int))))
  (def %bgemm "lp_gemm_bf16") (def %mgemm "lp_sgemm_mkl"))
(sb-alien:define-alien-routine ("lp_init" %lp-init) sb-alien:int (path sb-alien:c-string))
(defconstant +esz+ 4)
(declaim (inline gemm))
(defun gemm (ta tb m n k alpha A ao lda B bo ldb beta C co ldc)
  "Row-major C[m,n] = alpha op(A) op(B) + beta C; TA/TB true = transpose. Offsets in elements."
  (declare (fvec A B C) (idx ao bo co) (dim m n k lda ldb ldc) (type fl alpha beta))
  (sb-sys:with-pinned-objects (A B C)
    (let ((pa (sb-sys:sap+ (sb-sys:vector-sap A) (* +esz+ ao))) (pb (sb-sys:sap+ (sb-sys:vector-sap B) (* +esz+ bo)))
          (pc (sb-sys:sap+ (sb-sys:vector-sap C) (* +esz+ co))) (ta (if ta 112 111)) (tb (if tb 112 111)))
      (cond ((or (= *gemm-mode* 0) (< (* m n k) *lp-min*)) (%sgemm 101 ta tb m n k alpha pa lda pb ldb beta pc ldc))
            ((= *gemm-mode* 2) (%bgemm 101 ta tb m n k alpha pa lda pb ldb beta pc ldc))
            (t (%mgemm 101 ta tb m n k alpha pa lda pb ldb beta pc ldc))))))

;;; ---------- parameters (unchanged) ----------
(defconstant +ln1g+ 0) (defconstant +ln1b+ 1) (defconstant +wqkv+ 2) (defconstant +bqkv+ 3)
(defconstant +wproj+ 4) (defconstant +bproj+ 5) (defconstant +ln2g+ 6) (defconstant +ln2b+ 7)
(defconstant +wfc+ 8) (defconstant +bfc+ 9) (defconstant +wfc2+ 10) (defconstant +bfc2+ 11)
(defstruct (cfg (:conc-name c-)) (v 0 :type fixnum) (d 0 :type fixnum) (nl 0 :type fixnum) (nh 0 :type fixnum) (tt 0 :type fixnum))
(defstruct (model (:conc-name m-)) cfg wte wpe layers lnfg lnfb)
(defun model-vecs (m)
  (append (list (cons (m-wte m) t) (cons (m-wpe m) t))
          (loop for ly in (m-layers m)
                append (loop for i below 12 collect (cons (svref ly i) (member i (list +wqkv+ +wproj+ +wfc+ +wfc2+)))))
          (list (cons (m-lnfg m) nil) (cons (m-lnfb m) nil))))
(defun make-model* (c &optional (zero nil))
  (let* ((v (c-v c)) (d (c-d c)) (nl (c-nl c)) (tt (c-tt c)) (rstd (/ 0.02d0 (sqrt (* 2d0 nl)))))
    (flet ((rnd (n sd) (let ((a (mkv n))) (unless zero (dotimes (i n) (setf (aref a i) (coerce (* sd (randn)) 'fl)))) a))
           (ones (n) (let ((a (mkv n))) (unless zero (fill a (f 1))) a)))
      (make-model :cfg c :wte (rnd (* v d) 0.02d0) :wpe (rnd (* tt d) 0.02d0)
                  :layers (loop repeat nl collect
                                (vector (ones d) (mkv d) (rnd (* d 3 d) 0.02d0) (mkv (* 3 d))
                                        (rnd (* d d) rstd) (mkv d) (ones d) (mkv d)
                                        (rnd (* d 4 d) 0.02d0) (mkv (* 4 d)) (rnd (* 4 d d) rstd) (mkv d)))
                  :lnfg (ones d) :lnfb (mkv d)))))
(defun nparams (m) (reduce #'+ (mapcar (lambda (p) (length (the fvec (car p)))) (model-vecs m))))

;;; ---------- worker ----------
(defstruct (wk (:conc-name w-)) (b 0 :type fixnum) grads
  xs ln1h ln1r xn1 qkv att y xmid ln2h ln2r xn2 hfc gel gth
  lnfh lnfr xf P dx tmp dqkv dy dg dA ids tgt (loss 0d0 :type double-float) (count 0 :type fixnum)
  (drop nil) (newmask t) rng me m1 m2 ma attd dm ebuf
  (poff 0 :type fixnum))   ; position offset of this worker's sequences (short-context training with posoff=1)
(defun make-wk* (c b)
  (let* ((d (c-d c)) (tt (c-tt c)) (nl (c-nl c)) (r (* b tt)) (v (c-v c)) (nh (c-nh c)))
    (flet ((per (n) (coerce (loop repeat nl collect (mkv n)) 'simple-vector)))
      (make-wk :b b :grads (make-model* c t)
               :xs (coerce (loop repeat (1+ nl) collect (mkv (* r d))) 'simple-vector)
               :ln1h (per (* r d)) :ln1r (per r) :xn1 (per (* r d)) :qkv (per (* r 3 d)) :att (per (* b nh tt tt))
               :y (per (* r d)) :xmid (per (* r d)) :ln2h (per (* r d)) :ln2r (per r) :xn2 (per (* r d))
               :hfc (per (* r 4 d)) :gel (per (* r 4 d))
               :gth (coerce (loop repeat nl collect (if *ew32* (mkv (* r 4 d)) (mkd (* r 4 d)))) 'simple-vector)   ; cached tanh for GELU backward
               :lnfh (mkv (* r d)) :lnfr (mkv r) :xf (mkv (* r d)) :P (mkv (* r v))
               :dx (mkv (* r d)) :tmp (mkv (* r d)) :dqkv (mkv (* r 3 d)) :dy (mkv (* r d)) :dg (mkv (* r 4 d)) :dA (mkv (* tt tt))
               :ids (make-array r :element-type 'fixnum) :tgt (make-array r :element-type 'fixnum)
               :rng (make-array 1 :element-type '(unsigned-byte 64) :initial-element (+ 1 (random (expt 2 62) *rs*)))
               :me (mkv (* r d)) :m1 (per (* r d)) :m2 (per (* r d)) :ma (per (* b nh tt tt)) :attd (per (* b nh tt tt)) :dm (mkv (* r d))
               :ebuf (mkd (max tt v 8))))))

(defun fill-mask (st mask n)
  "Inverted-dropout mask: 0 with prob *pdrop*, else 1/(1-p). Same xorshift64 stream as gpt-big.lisp, branch-free select."
  (declare (type (simple-array (unsigned-byte 64) (1)) st) (fvec mask) (idx n))
  (let* ((x (aref st 0)) (thr (round (* *pdrop* 16777216))) (ks (coerce (/ 1d0 (- 1d0 *pdrop*)) 'fl))
         (tbl (make-array 2 :element-type 'single-float :initial-contents (list 0f0 ks))))
    (declare (type (unsigned-byte 64) x) (type (signed-byte 32) thr) (type (simple-array single-float (2)) tbl))
    (dotimes (i n)
      (setf x (logxor x (logand (ash x 13) #xFFFFFFFFFFFFFFFF)))
      (setf x (logxor x (ash x -7)))
      (setf x (logxor x (logand (ash x 17) #xFFFFFFFFFFFFFFFF)))
      (setf (aref mask i) (aref tbl (+ 1 (ash (the (signed-byte 32) (- (the (unsigned-byte 24) (ash x -40)) thr)) -31)))))
    (setf (aref st 0) x)))


;;; ---------- element-wise kernels (GELU, softmax row) ----------
(defconstant +gc+ 0.7978845608028654d0)   ; sqrt(2/pi)
(defun gelu64 (Hh G TC n)
  "G = gelu(Hh); TC caches tanh(...) (double) for GELU-BACK."
  (declare (fvec Hh G) (dvec TC) (idx n))
  (let ((n4 (logand n (lognot 3))))
    (declare (idx n4))
    (loop for q of-type idx from 0 below n4 by 4
          do (let* ((x (v:f64.4-from-f32.4 (v:f32.4-aref Hh q)))
                    (th (vtanh (v:f64.4* (v:f64.4 +gc+) (v:f64.4+ x (v:f64.4* (v:f64.4* (v:f64.4* (v:f64.4 0.044715d0) x) x) x))))))
               (setf (v:f64.4-aref TC q) th
                     (v:f32.4-aref G q) (v:f32.4-from-f64.4 (v:f64.4* (v:f64.4* (v:f64.4 0.5d0) x) (v:f64.4+ (v:f64.4 1d0) th))))))
    (sb-simd-avx:vzeroupper)
    (loop for q from n4 below n
          do (let* ((x (coerce (aref Hh q) 'double-float)) (th (tanh-d (* +gc+ (+ x (* 0.044715d0 x x x))))))
               (setf (aref TC q) th (aref G q) (coerce (* 0.5d0 x (+ 1d0 th)) 'fl))))))
(defun gelu-back64 (Hh TC dG n)       ; dG *= gelu'(h), using cached tanh
  (declare (fvec Hh dG) (dvec TC) (idx n))
  (let ((n4 (logand n (lognot 3))) (c3 (* 3d0 0.044715d0)))
    (declare (idx n4) (double-float c3))
    (loop for q of-type idx from 0 below n4 by 4
          do (let* ((x (v:f64.4-from-f32.4 (v:f32.4-aref Hh q))) (t1 (v:f64.4-aref TC q))
                    (dd (v:f64.4+ (v:f64.4* (v:f64.4 0.5d0) (v:f64.4+ (v:f64.4 1d0) t1))
                                  (v:f64.4* (v:f64.4* (v:f64.4* (v:f64.4* (v:f64.4 0.5d0) x) (v:f64.4- (v:f64.4 1d0) (v:f64.4* t1 t1))) (v:f64.4 +gc+))
                                            (v:f64.4+ (v:f64.4 1d0) (v:f64.4* (v:f64.4* (v:f64.4 c3) x) x))))))
               (setf (v:f32.4-aref dG q) (v:f32.4* (v:f32.4-aref dG q) (v:f32.4-from-f64.4 dd)))))
    (sb-simd-avx:vzeroupper)
    (loop for q from n4 below n
          do (let* ((x (coerce (aref Hh q) 'double-float)) (t1 (aref TC q))
                    (dd (+ (* 0.5d0 (+ 1d0 t1)) (* 0.5d0 x (- 1d0 (* t1 t1)) +gc+ (+ 1d0 (* 3d0 0.044715d0 x x))))))
               (setf (aref dG q) (* (aref dG q) (coerce dd 'fl)))))))

;;; #5 cheap lower-precision alternative (ew=f32): GELU forward/backward in single precision, 8 lanes (f32.8) instead of
;;; double 4 lanes; tanh cache stored as single. Cephes-style expf (rel. err ~1e-7).
(defvar *ew32* nil)
(declaim (inline vexp-neg32 vtanh32))
(defun vexp-neg32 (y)
  (let* ((yc (v:f32.8-max y (v:f32.8 -87f0)))
         (n (v:f32.8-round (v:f32.8* yc (v:f32.8 1.442695f0))))
         (r (v:f32.8- (v:f32.8- yc (v:f32.8* n (v:f32.8 0.693359375f0))) (v:f32.8* n (v:f32.8 -2.12194440f-4))))
         (p (v:f32.8+ (v:f32.8+ (v:f32.8* (v:f32.8* r r)
                                          (v:f32.8+ (v:f32.8 5.0000001201f-1)
                                                    (v:f32.8* r (v:f32.8+ (v:f32.8 1.6666665459f-1)
                                                                          (v:f32.8* r (v:f32.8+ (v:f32.8 4.1665795894f-2)
                                                                                                (v:f32.8* r (v:f32.8+ (v:f32.8 8.3334519073f-3)
                                                                                                                      (v:f32.8* r (v:f32.8+ (v:f32.8 1.3981999507f-3)
                                                                                                                                            (v:f32.8* r (v:f32.8 1.9875691500f-4))))))))))))
                                r)
                      (v:f32.8 1f0)))
         (sc (v:f32.8! (v:s32.8-shiftl (v:s32.8+ (v:s32.8-from-f32.8 n) (v:s32.8 127)) 23))))
    (v:f32.8-if (v:f32.8< y (v:f32.8 -87f0)) (v:f32.8 0f0) (v:f32.8* p sc))))
(defun vtanh32 (x)
  (let* ((sign (v:f32.8-and x (v:f32.8! (v:u32.8 #x80000000))))
         (ax (v:f32.8-and x (v:f32.8! (v:u32.8 #x7FFFFFFF))))
         (e (vexp-neg32 (v:f32.8* (v:f32.8 -2f0) (v:f32.8-min ax (v:f32.8 9f0)))))
         (th (v:f32.8/ (v:f32.8- (v:f32.8 1f0) e) (v:f32.8+ (v:f32.8 1f0) e))))
    (v:f32.8-xor th sign)))
(defun gelu32 (Hh G TC n)
  (declare (fvec Hh G TC) (idx n))
  (let ((n8 (logand n (lognot 7))) (gc (coerce +gc+ 'single-float)))
    (declare (idx n8))
    (loop for q of-type idx from 0 below n8 by 8
          do (let* ((x (v:f32.8-aref Hh q))
                    (th (vtanh32 (v:f32.8* (v:f32.8 gc) (v:f32.8+ x (v:f32.8* (v:f32.8* (v:f32.8* (v:f32.8 0.044715f0) x) x) x))))))
               (setf (v:f32.8-aref TC q) th (v:f32.8-aref G q) (v:f32.8* (v:f32.8* (v:f32.8 0.5f0) x) (v:f32.8+ (v:f32.8 1f0) th)))))
    (loop for q from n8 below n
          do (let* ((x (aref Hh q)) (th (coerce (tanh-d (coerce (* gc (+ x (* 0.044715f0 x x x))) 'double-float)) 'single-float)))
               (setf (aref TC q) th (aref G q) (* 0.5f0 x (+ 1f0 th)))))))
(defun gelu-back32 (Hh TC dG n)
  (declare (fvec Hh TC dG) (idx n))
  (let ((n8 (logand n (lognot 7))) (gc (coerce +gc+ 'single-float)) (c3 (* 3f0 0.044715f0)))
    (declare (idx n8))
    (loop for q of-type idx from 0 below n8 by 8
          do (let* ((x (v:f32.8-aref Hh q)) (t1 (v:f32.8-aref TC q))
                    (dd (v:f32.8+ (v:f32.8* (v:f32.8 0.5f0) (v:f32.8+ (v:f32.8 1f0) t1))
                                  (v:f32.8* (v:f32.8* (v:f32.8* (v:f32.8* (v:f32.8 0.5f0) x) (v:f32.8- (v:f32.8 1f0) (v:f32.8* t1 t1))) (v:f32.8 gc))
                                            (v:f32.8+ (v:f32.8 1f0) (v:f32.8* (v:f32.8* (v:f32.8 c3) x) x))))))
               (setf (v:f32.8-aref dG q) (v:f32.8* (v:f32.8-aref dG q) dd))))
    (loop for q from n8 below n
          do (let* ((x (aref Hh q)) (t1 (aref TC q))
                    (dd (+ (* 0.5f0 (+ 1f0 t1)) (* 0.5f0 x (- 1f0 (* t1 t1)) gc (+ 1f0 (* c3 x x))))))
               (setf (aref dG q) (* (aref dG q) dd))))))
(defun gelu (Hh G TC n) (if (typep TC 'dvec) (gelu64 Hh G TC n) (gelu32 Hh G TC n)))
(defun gelu-back (Hh TC dG n) (if (typep TC 'dvec) (gelu-back64 Hh TC dG n) (gelu-back32 Hh TC dG n)))

(declaim (inline softmax-row))
(defun softmax-row (A o L EB)
  "In place on A[o..o+L): e_j = exp-neg(float(A_j - max)) (vectorized), sum in double in the original sequential order,
   A_j = float(e_j_float * (1/sum)). Returns the sum. EB is a double scratch buffer of length >= L."
  (declare (fvec A) (dvec EB) (idx o) (dim L))
  (let ((mx (aref A o)) (sm 0d0) (L4 (logand L (lognot 3))))
    (declare (type fl mx) (double-float sm) (dim L4))
    (loop for j from 1 below L do (setf mx (max mx (aref A (+ o j)))))
    (let ((vmx (v:f32.4 mx)))
      (loop for j of-type idx from 0 below L4 by 4
            do (let ((e (vexp-neg (v:f64.4-from-f32.4 (v:f32.4- (v:f32.4-aref A (+ o j)) vmx)))))
                 (setf (v:f64.4-aref EB j) e (v:f32.4-aref A (+ o j)) (v:f32.4-from-f64.4 e)))))
    (sb-simd-avx:vzeroupper)
    (loop for j from L4 below L
          do (let ((e (exp-neg (coerce (- (aref A (+ o j)) mx) 'double-float)))) (setf (aref EB j) e (aref A (+ o j)) (coerce e 'fl))))
    (dotimes (j L) (incf sm (aref EB j)))
    sm))

;;; ---------- DEFOP: one definition per op -> forward function NAME and backward function NAME-BACK ----------
;;; (defop name (params...) :grads (g...) :decl (decls for params) :gdecl (decls for grads) :wrap form :fwd body :bwd body)
;;;  - NAME takes PARAMS; NAME-BACK takes PARAMS + GRADS (the backward sees every forward argument, e.g. saved activations).
;;;  - :WRAP is shared scaffolding (loops / bindings common to both directions); %BODY marks where :FWD / :BWD go,
;;;    (%fwd x) / (%bwd x) inside it are kept in that direction only.
;;;  - TAPE (below) writes the model once as a list of op calls; it emits the forward calls in order and the backward
;;;    calls in reverse order (loops reversed too), passing grad buffers given at the call site as :keyword args.
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defvar *ops* (make-hash-table))   ; name -> grads list
  (defun back-name (name) (intern (format nil "~a-BACK" name)))
  (defun expand-wrap (wrap body back)   ; %BODY -> body; (%fwd x) / (%bwd x) -> x in that direction, nil in the other
    (cond ((eq wrap '%body) `(progn ,@body))
          ((atom wrap) wrap)
          ((member (car wrap) '(%fwd %bwd)) (when (eq back (eq (car wrap) '%bwd)) (second wrap)))
          (t (cons (expand-wrap (car wrap) body back) (expand-wrap (cdr wrap) body back))))))
(defmacro defop (name params &key grads decl gdecl (wrap '%body) fwd bwd)
  `(progn
     (eval-when (:compile-toplevel :load-toplevel :execute) (setf (gethash ',name *ops*) ',grads))
     (defun ,name ,params (declare ,@decl) ,(expand-wrap wrap fwd nil))
     (defun ,(back-name name) (,@params ,@grads)
       (declare (ignorable ,@params) ,@decl ,@gdecl) ,(expand-wrap wrap bwd t))))
(defmacro tape (backprop bwd-let &body steps)
  "STEP = (op args... :grad buf ...) | (:fwd form) forward-only | (:loop (var n) bindings [declare] steps...)."
  (labels ((call (s back)
             (let* ((k (position-if #'keywordp (cdr s))) (pos (subseq (cdr s) 0 k)) (kw (and k (nthcdr (1+ k) s))))
               (if back
                   `(,(back-name (car s)) ,@pos ,@(mapcar (lambda (g) (getf kw (intern (symbol-name g) :keyword)))
                                                          (gethash (car s) *ops*)))
                   `(,(car s) ,@pos))))
           (walk (s back)
             (case (car s)
               (:fwd (unless back (list (second s))))
               (:loop (destructuring-bind ((v n) binds &rest body) (cdr s)
                        (let* ((dcl (when (eq (caar body) 'declare) (list (pop body))))
                               (inner `(let ,binds ,@dcl ,@(mapcan (lambda (x) (walk x back)) (if back (reverse body) body)))))
                          (list (if back `(loop for ,v from (1- ,n) downto 0 do ,inner) `(dotimes (,v ,n) ,inner))))))
               (t (list (call s back))))))
    `(progn ,@(mapcan (lambda (s) (walk s nil)) steps)
            (when ,backprop (let* ,bwd-let ,@(mapcan (lambda (s) (walk s t)) (reverse steps)))))))

;;; ---------- ops ----------
;; the dropout multiply sits outside the per-row loop: (%fwd x) / (%bwd x) in :WRAP appear in one direction only
(defop embed (w x0 wte wpe ids R d nt me)   ; x = wte[id] + wpe[pos], then embedding dropout (ME = mask or nil)
  :grads (dx gwte gwpe) :decl ((fvec x0 wte wpe) ((simple-array fixnum (*)) ids) (dim R d nt)) :gdecl ((fvec dx gwte gwpe))
  :wrap (progn (%bwd (when me (vmul dx me (* R d))))
               (dotimes (r R) (let ((o (* r d)) (eo (* (aref ids r) d)) (po (* (+ (mod r nt) (w-poff w)) d))) (declare (idx o eo po)) %body))
               (%fwd (when me (vmul x0 me (* R d)))))
  :fwd ((dotimes (j d) (setf (aref x0 (+ o j)) (+ (aref wte (+ eo j)) (aref wpe (+ po j))))))
  :bwd ((dotimes (j d) (incf (aref gwte (+ eo j)) (aref dx (+ o j))) (incf (aref gwpe (+ po j)) (aref dx (+ o j))))))

(defop layernorm (X R d g b H rs Y)   ; Y = g*(X-mean)/sqrt(var+1e-5) + b per row; xhat -> H, 1/std -> RS
  :grads (dY dg db dX accumulate) :decl ((fvec X g b H rs Y) (dim R d)) :gdecl ((fvec dY dg db dX))
  :wrap (dotimes (r R) (let ((o (* r d)) (s1 0d0) (s2 0d0)) (declare (idx o) (double-float s1 s2)) %body))
  :fwd ((dotimes (j d) (incf s1 (aref X (+ o j)))) (setf s1 (/ s1 d))
        (dotimes (j d) (let ((z (- (aref X (+ o j)) s1))) (incf s2 (* z z)))) (setf s2 (/ s2 d))
        (let ((s (/ 1d0 (sqrt (the (double-float 0d0) (+ s2 1d-5))))))
          (setf (aref rs r) (coerce s 'fl))
          (dotimes (j d)
            (let ((xh (coerce (* (- (aref X (+ o j)) s1) s) 'fl)))
              (setf (aref H (+ o j)) xh (aref Y (+ o j)) (+ (* (aref g j) xh) (aref b j)))))))
  :bwd ((dotimes (j d)
          (let* ((dy (aref dY (+ o j))) (dxh (* dy (aref g j))))
            (incf (aref dg j) (* dy (aref H (+ o j)))) (incf (aref db j) dy)
            (incf s1 dxh) (incf s2 (* dxh (aref H (+ o j))))))
        (setf s1 (/ s1 d) s2 (/ s2 d))
        (let ((s (aref rs r)))
          (dotimes (j d)
            (let ((v (* s (coerce (- (* (aref dY (+ o j)) (aref g j)) s1 (* (aref H (+ o j)) s2)) 'fl))))
              (if accumulate (incf (aref dX (+ o j)) v) (setf (aref dX (+ o j)) v)))))))

(defop linear (X R din W bias Y dout mask)   ; Y = X W + bias, then (optional) dropout MASK on the output
  :grads (dY gW gb dX dm) :decl ((fvec X W bias Y) (dim R din dout)) :gdecl ((fvec gW gb))
  :fwd ((dotimes (r R) (replace Y bias :start1 (* r dout)))
        (gemm nil nil R dout din (f 1) X 0 din W 0 dout (f 1) Y 0 dout)
        (when mask (vmul Y mask (* R dout))))
  :bwd ((let ((dY (if mask (progn (vmul-into dm dY mask (* R dout)) dm) dY)))
          (declare (fvec dY))
          (gemm t nil din dout R (f 1) X 0 din dY 0 dout (f 1) gW 0 dout)
          (let ((d8 (logand dout (lognot 7))))       ; bias grad: per column, rows summed in the original order
            (declare (dim d8))
            (dotimes (r R)
              (let ((o (* r dout))) (declare (idx o))
                (loop for j of-type idx from 0 below d8 by 8 do (setf (v:f32.8-aref gb j) (v:f32.8+ (v:f32.8-aref gb j) (v:f32.8-aref dY (+ o j)))))
                (sb-simd-avx:vzeroupper)
                (loop for j from d8 below dout do (incf (aref gb j) (aref dY (+ o j)))))))
          (when dX (gemm nil t R din dout (f 1) dY 0 dout W 0 dout (f 0) dX 0 din)))))

(defop gelu (Hh G TC n)   ; G = gelu(Hh), tanh cached in TC (double, or single with ew=f32); backward: dG *= gelu'(Hh)
  :grads (dG)
  :fwd ((if (typep TC 'dvec) (gelu64 Hh G TC n) (gelu32 Hh G TC n)))
  :bwd ((if (typep TC 'dvec) (gelu-back64 Hh TC dG n) (gelu-back32 Hh TC dG n))))

(defop attention (c qkv att y b nt E ma attd)   ; causal multi-head attention; MA = dropout mask on probs (or nil)
  :grads (dy dqkv dA) :decl ((fvec qkv att y) (dvec E) (dim b nt)) :gdecl ((fvec dy dqkv dA))
  :wrap (let* ((d (c-d c)) (nh (c-nh c)) (hd (floor d nh)) (d3 (* 3 d)) (scale (coerce (/ 1d0 (sqrt (float hd 1d0))) 'fl)))
          (declare (dim d nh hd d3))
          (dotimes (s b)
            (dotimes (h nh)
              (let* ((qo (+ (* s nt d3) (* h hd))) (ko (+ qo d)) (vo (+ qo d d))
                     (ao (* (+ (* s nh) h) nt nt)) (yo (+ (* s nt d) (* h hd))))
                (declare (idx qo ko vo ao yo))
                %body))))
  :fwd ((gemm nil t nt nt hd scale qkv qo d3 qkv ko d3 (f 0) att ao nt)
        (dotimes (i nt)
          (let* ((o (+ ao (* i nt))) (L (1+ i)) (L4 (logand L (lognot 3))) (inv (/ 1d0 (softmax-row att o L E))) (vinv (v:f64.4 inv)))
            (declare (idx o) (dim L L4) (double-float inv))
            (loop for j of-type idx from 0 below L4 by 4
                  do (setf (v:f32.4-aref att (+ o j)) (v:f32.4-from-f64.4 (v:f64.4* vinv (v:f64.4-from-f32.4 (v:f32.4-aref att (+ o j)))))))
            (sb-simd-avx:vzeroupper)
            (loop for j from L4 below L do (setf (aref att (+ o j)) (coerce (* inv (aref att (+ o j))) 'fl)))
            (loop for j from L below nt do (setf (aref att (+ o j)) (f 0)))))
        (if ma
            (progn (vmul-off attd ao att ao ma ao (* nt nt))
                   (gemm nil nil nt hd nt (f 1) attd ao nt qkv vo d3 (f 0) y yo d))
            (gemm nil nil nt hd nt (f 1) att ao nt qkv vo d3 (f 0) y yo d)))
  :bwd ((gemm nil t nt nt hd (f 1) dy yo d qkv vo d3 (f 0) dA 0 nt)
        (when ma (vmul-off dA 0 dA 0 ma ao (* nt nt)))
        (gemm t nil nt hd nt (f 1) (if ma attd att) ao nt dy yo d (f 0) dqkv vo d3)
        (dotimes (i nt)
          (let ((o (* i nt)) (sd 0d0))
            (declare (idx o) (double-float sd))
            (loop for j from 0 to i do (incf sd (* (aref att (+ ao o j)) (aref dA (+ o j)))))
            (let* ((sdf (coerce sd 'fl)) (vsd (v:f32.8 sdf)) (L (1+ i)) (L8 (logand L (lognot 7))))
              (declare (dim L L8))
              (loop for j of-type idx from 0 below L8 by 8
                    do (setf (v:f32.8-aref dA (+ o j)) (v:f32.8* (v:f32.8-aref att (+ ao o j)) (v:f32.8- (v:f32.8-aref dA (+ o j)) vsd))))
              (sb-simd-avx:vzeroupper)
              (loop for j from L8 below L do (setf (aref dA (+ o j)) (* (aref att (+ ao o j)) (- (aref dA (+ o j)) sdf))))
              (loop for j from L below nt do (setf (aref dA (+ o j)) (f 0))))))
        (gemm nil nil nt hd nt scale dA 0 nt qkv ko d3 (f 0) dqkv qo d3)
        (gemm t nil nt hd nt scale dA 0 nt qkv qo d3 (f 0) dqkv ko d3)))

(defop head (w xf wte P R v d nt sf tgt E)   ; tied-embedding logits, softmax, cross-entropy on positions >= SF
  :grads (gwte dxf scale) :decl ((fvec xf wte P) (dim R v d nt sf) ((simple-array fixnum (*)) tgt) (dvec E))
  :gdecl ((fvec gwte dxf) (type fl scale))
  :fwd ((let ((loss 0d0)) (declare (double-float loss))
          (gemm nil t R v d (f 1) xf 0 d wte 0 d (f 0) P 0 v)
          (dotimes (r R)
            (let* ((o (* r v)) (scored (>= (mod r nt) sf)) (inv (/ 1d0 (softmax-row P o v E))))
              (declare (idx o) (double-float inv))
              (if scored
                  (progn (decf loss (log (max 1d-300 (* inv (aref P (+ o (aref tgt r))))))) (incf (w-count w))
                         (loop for j from o below (+ o v) do (setf (aref P j) (coerce (* inv (aref P j)) 'fl))))
                  (fill P (f 0) :start o :end (+ o v)))))
          (incf (w-loss w) loss)))
  :bwd ((let ((vs (v:f32.8 scale)))
          (dotimes (r R) (let ((o (* r v)))
                           (declare (idx o))
                           (when (>= (mod r nt) sf) (decf (aref P (+ o (aref tgt r))) (f 1)))
                           (do8 (j v) (setf (v:f32.8-aref P (+ o j)) (v:f32.8* vs (v:f32.8-aref P (+ o j))))
                                (setf (aref P (+ o j)) (* scale (aref P (+ o j))))))))
        (gemm t nil v d R (f 1) P 0 v xf 0 d (f 1) gwte 0 d)
        (gemm nil nil R d v (f 1) P 0 v wte 0 d (f 0) dxf 0 d)))

;;; ---------- the model, written once: TAPE derives the backward pass (same order of operations as gpt-big.lisp) ----------
(defun forward-backward (m w nt sf backprop scale)
  (declare (dim nt sf) (type fl scale))
  (let* ((c (m-cfg m)) (d (c-d c)) (nl (c-nl c)) (b (w-b w)) (R (* b nt)) (d3 (* 3 d)) (d4 (* 4 d)) (drop (w-drop w))
         (E (w-ebuf w)) (layers (coerce (m-layers m) 'simple-vector)) (dx (w-dx w)) (tmp (w-tmp w)) (dm (w-dm w)))
    (declare (dim d nl b R d3 d4) (dvec E))
    (macrolet ((L (acc) `(svref (,acc w) l)) (P (i) `(svref ly ,i)) (GR (i) `(svref (the simple-vector (svref glayers l)) ,i)))
      (tape backprop ((g (w-grads w)) (glayers (coerce (m-layers g) 'simple-vector)))
        (:fwd (when (and drop (w-newmask w))
                (fill-mask (w-rng w) (w-me w) (* R d))
                (dotimes (l nl) (fill-mask (w-rng w) (L w-m1) (* R d)) (fill-mask (w-rng w) (L w-m2) (* R d))
                                (fill-mask (w-rng w) (L w-ma) (* b (c-nh c) nt nt)))))
        (embed w (svref (w-xs w) 0) (m-wte m) (m-wpe m) (w-ids w) R d nt (and drop (w-me w)) :dx dx :gwte (m-wte g) :gwpe (m-wpe g))
        (:loop (l nl) ((ly (svref layers l)) (X (L w-xs)) (Xo (svref (w-xs w) (1+ l))) (xmid (L w-xmid)))
          (declare (simple-vector ly) (fvec X Xo xmid))
          (layernorm X R d (P +ln1g+) (P +ln1b+) (L w-ln1h) (L w-ln1r) (L w-xn1) :dY tmp :dg (GR +ln1g+) :db (GR +ln1b+) :dX dx :accumulate t)
          (linear (L w-xn1) R d (P +wqkv+) (P +bqkv+) (L w-qkv) d3 nil :dY (w-dqkv w) :gW (GR +wqkv+) :gb (GR +bqkv+) :dX tmp)
          (attention c (L w-qkv) (L w-att) (L w-y) b nt E (and drop (L w-ma)) (and drop (L w-attd)) :dy (w-dy w) :dqkv (w-dqkv w) :dA (w-dA w))
          (linear (L w-y) R d (P +wproj+) (P +bproj+) xmid d (and drop (L w-m1)) :dY dx :gW (GR +wproj+) :gb (GR +bproj+) :dX (w-dy w) :dm dm)
          (:fwd (vadd xmid X (* R d)))          ; residual: its backward is the :accumulate t of the layernorms
          (layernorm xmid R d (P +ln2g+) (P +ln2b+) (L w-ln2h) (L w-ln2r) (L w-xn2) :dY tmp :dg (GR +ln2g+) :db (GR +ln2b+) :dX dx :accumulate t)
          (linear (L w-xn2) R d (P +wfc+) (P +bfc+) (L w-hfc) d4 nil :dY (w-dg w) :gW (GR +wfc+) :gb (GR +bfc+) :dX tmp)
          (gelu (L w-hfc) (L w-gel) (L w-gth) (* R d4) :dG (w-dg w))
          (linear (L w-gel) R d4 (P +wfc2+) (P +bfc2+) Xo d (and drop (L w-m2)) :dY dx :gW (GR +wfc2+) :gb (GR +bfc2+) :dX (w-dg w) :dm dm)
          (:fwd (vadd Xo xmid (* R d))))
        (layernorm (svref (w-xs w) nl) R d (m-lnfg m) (m-lnfb m) (w-lnfh w) (w-lnfr w) (w-xf w) :dY tmp :dg (m-lnfg g) :db (m-lnfb g) :dX dx)
        (head w (w-xf w) (m-wte m) (w-P w) R (c-v c) d nt sf (w-tgt w) E :gwte (m-wte g) :dxf tmp :scale scale)))))

;;; ---------- persistent thread pool ----------
(defstruct (pool (:conc-name p-)) (n 1 :type fixnum) (gen 0 :type fixnum) (done 0 :type fixnum) job threads
  (mx (sb-thread:make-mutex)) (cv (sb-thread:make-waitqueue)) (cvd (sb-thread:make-waitqueue)))
(defun pool-loop (p i)
  (let ((seen 0))
    (loop
      (let (job)
        (sb-thread:with-mutex ((p-mx p))
          (loop while (= (p-gen p) seen) do (sb-thread:condition-wait (p-cv p) (p-mx p)))
          (setf seen (p-gen p) job (p-job p)))
        (when (eq job :quit) (return))
        (funcall (the function job) i)
        (sb-thread:with-mutex ((p-mx p))
          (when (= (incf (p-done p)) (1- (p-n p))) (sb-thread:condition-broadcast (p-cvd p))))))))
(defun make-pool* (n)
  (let ((p (make-pool :n n)))
    (setf (p-threads p) (loop for i from 1 below n collect (let ((i i)) (sb-thread:make-thread (lambda () (pool-loop p i)) :name (format nil "w~d" i)))))
    p))
(defun run-pool (p fn)
  "Call FN on 0..n-1 in parallel (0 on the calling thread); return when all are done."
  (declare (function fn))
  (if (= (p-n p) 1) (funcall fn 0)
      (progn
        (sb-thread:with-mutex ((p-mx p)) (setf (p-job p) fn (p-done p) 0) (incf (p-gen p)) (sb-thread:condition-broadcast (p-cv p)))
        (funcall fn 0)
        (sb-thread:with-mutex ((p-mx p))
          (loop until (= (p-done p) (1- (p-n p))) do (sb-thread:condition-wait (p-cvd p) (p-mx p))))
        nil)))
(defun stop-pool (p)
  (when (> (p-n p) 1)
    (sb-thread:with-mutex ((p-mx p)) (setf (p-job p) :quit) (incf (p-gen p)) (sb-thread:condition-broadcast (p-cv p)))
    (mapc #'sb-thread:join-thread (p-threads p))))

;;; old-style helpers kept for the gradcheck
(defun sum-grads (workers)
  (let ((g0 (mapcar #'car (model-vecs (w-grads (car workers))))))
    (dolist (w (cdr workers))
      (loop for a in g0 for (bv) in (model-vecs (w-grads w))
            do (let ((a a) (bv bv)) (declare (fvec a bv)) (dotimes (i (length a)) (incf (aref a i) (aref bv i)) (setf (aref bv i) (f 0))))))
    g0))

;;; ---------- AdamW, parallel over parameter tensors ----------
(defstruct (adam (:conc-name a-)) ms vs (tn 0 :type fixnum)
  ps decays gs     ; simple-vectors over tensors: params, decay flags, per-tensor simple-vector of worker grad fvecs
  parts            ; dvec: per-tensor sum of squares of the reduced gradient
  assign           ; simple-vector (per thread) of lists of tensor indices
  (muon nil)       ; nil, or simple-vector over tensors: nil (AdamW) or a muon-buf (Muon)
  (mlr 0.02d0 :type double-float) (mmom 0.95d0 :type double-float))
(defun make-adam* (m &optional ws (nthreads 1))
  (let* ((mv (model-vecs m)) (nt (length mv))
         (o (make-adam :ms (mapcar (lambda (p) (mkv (length (the fvec (car p))))) mv)
                       :vs (mapcar (lambda (p) (mkv (length (the fvec (car p))))) mv))))
    (when ws
      (setf (a-ps o) (coerce (mapcar #'car mv) 'simple-vector)
            (a-decays o) (coerce (mapcar (lambda (p) (and (cdr p) t)) mv) 'simple-vector)
            (a-gs o) (let ((per (mapcar (lambda (w) (mapcar #'car (model-vecs (w-grads w)))) ws)))
                       (coerce (loop for i below nt collect (coerce (mapcar (lambda (l) (nth i l)) per) 'simple-vector)) 'simple-vector))
            (a-parts o) (mkd nt))
      ;; LPT: biggest tensors first, each to the least-loaded thread
      (let ((load (make-array nthreads :initial-element 0)) (asg (make-array nthreads :initial-element nil)))
        (dolist (i (sort (loop for i below nt collect i) #'> :key (lambda (i) (length (the fvec (svref (a-ps o) i))))))
          (let ((th (position (reduce #'min load) load)))
            (incf (aref load th) (length (the fvec (svref (a-ps o) i)))) (push i (aref asg th))))
        (setf (a-assign o) asg)))
    o))

(defun reduce-tensor (gw parts i)
  "g0 += g1 + ... (per element, workers in order; others zeroed); parts[i] = sum g0^2 in double, sequential."
  (declare (simple-vector gw) (dvec parts) (fixnum i))
  (let* ((g0 (svref gw 0)) (n (length g0)) (k (length gw)) (s 0d0))
    (declare (fvec g0) (idx n) (fixnum k) (double-float s))
    (loop for wi from 1 below k
          do (let ((bv (svref gw wi)) (z (v:f32.8 0f0)))
               (declare (fvec bv))
               (do8 (q n) (progn (setf (v:f32.8-aref g0 q) (v:f32.8+ (v:f32.8-aref g0 q) (v:f32.8-aref bv q))) (setf (v:f32.8-aref bv q) z))
                    (progn (incf (aref g0 q) (aref bv q)) (setf (aref bv q) (f 0))))))
    (loop for x across g0 do (incf s (* (coerce x 'double-float) x)))
    (setf (aref parts i) s)))

(defun adam-tensor (p g mm vv cs shrink lrc ic2)
  (declare (fvec p g mm vv) (type fl cs shrink lrc ic2))
  (let ((n (length p)) (vcs (v:f32.8 cs)) (vsh (v:f32.8 shrink)) (vlrc (v:f32.8 lrc)) (vic2 (v:f32.8 ic2))
        (b1 (v:f32.8 0.9f0)) (b1c (v:f32.8 0.1f0)) (b2 (v:f32.8 0.99f0)) (b2c (v:f32.8 0.01f0)) (eps (v:f32.8 1f-8)) (z (v:f32.8 0f0)))
    (declare (idx n))
    (do8 (i n)
         (let* ((gi (v:f32.8* vcs (v:f32.8-aref g i)))
                (m1 (v:f32.8+ (v:f32.8* b1 (v:f32.8-aref mm i)) (v:f32.8* b1c gi)))
                (v1 (v:f32.8+ (v:f32.8* b2 (v:f32.8-aref vv i)) (v:f32.8* (v:f32.8* b2c gi) gi))))
           (setf (v:f32.8-aref mm i) m1 (v:f32.8-aref vv i) v1
                 (v:f32.8-aref p i) (v:f32.8- (v:f32.8* vsh (v:f32.8-aref p i))
                                              (v:f32.8/ (v:f32.8* vlrc m1) (v:f32.8+ (v:f32.8-sqrt (v:f32.8* v1 vic2)) eps)))
                 (v:f32.8-aref g i) z))
         (let ((gi (* cs (aref g i))))
           (setf (aref mm i) (+ (* (f 0.9) (aref mm i)) (* (f 0.1) gi))
                 (aref vv i) (+ (* (f 0.99) (aref vv i)) (* (f 0.01) gi gi)))
           (setf (aref p i) (- (* shrink (aref p i)) (/ (* lrc (aref mm i)) (+ (sqrt (the (single-float 0f0) (* (aref vv i) ic2))) (f 1e-8)))))
           (setf (aref g i) (f 0))))))

;;; ---------- Muon: Newton-Schulz-orthogonalized Nesterov momentum for the 2-D block matrices ----------
;;; Follows Keller Jordan's reference: buf = mu*buf + g; u = g + mu*buf (Nesterov); X = u/(||u||_F+1e-7);
;;; 5 quintic NS iterations X <- aX + (bA + cA^2)X with A = XX^T (a,b,c = 3.4445,-4.7750,2.0315), done on the
;;; short side (X^T X when rows > cols); update W <- shrink*W - lr*sqrt(max(1, dout/din))*X.
;;; W is stored row-major din x dout (see LINEAR). Embeddings/tied head, LN gains/biases, biases stay on AdamW.
(defstruct (mbuf (:conc-name mb-)) (m 0 :type fixnum) (n 0 :type fixnum) mom x y a b2 (scale 1f0 :type single-float))
(defun make-mbuf* (m n)
  (let ((k (min m n)))
    (make-mbuf :m m :n n :mom (mkv (* m n)) :x (mkv (* m n)) :y (mkv (* m n)) :a (mkv (* k k)) :b2 (mkv (* k k))
               :scale (coerce (sqrt (max 1d0 (/ n m 1d0))) 'single-float))))
(defun newton-schulz (mb)
  "Orthogonalize MB-X in place (5 iterations). Returns the fvec holding the result."
  (let* ((m (mb-m mb)) (n (mb-n mb)) (x (mb-x mb)) (y (mb-y mb)) (a (mb-a mb)) (b2 (mb-b2 mb)) (mn (* m n)) (k (min m n)))
    (declare (fixnum m n mn k) (fvec x y a b2))
    (let ((s 0d0)) (declare (double-float s))
      (dotimes (i mn) (incf s (* (coerce (aref x i) 'double-float) (aref x i))))
      (let ((inv (coerce (/ 1d0 (+ (sqrt s) 1d-7)) 'single-float))) (dotimes (i mn) (setf (aref x i) (* inv (aref x i))))))
    (dotimes (it 5)
      (if (<= m n)
          (gemm nil t m m n (f 1) x 0 n x 0 n (f 0) a 0 m)        ; A = X X^T   (m x m)
          (gemm t nil n n m (f 1) x 0 n x 0 n (f 0) a 0 n))       ; A = X^T X   (n x n)
      (gemm nil nil k k k (f 2.0315) a 0 k a 0 k (f 0) b2 0 k)    ; B = c A^2
      (dotimes (i (* k k)) (setf (aref b2 i) (+ (aref b2 i) (* (f -4.7750) (aref a i)))))   ; B += b A
      (replace y x)
      (if (<= m n)
          (gemm nil nil m n m (f 1) b2 0 m x 0 n (f 3.4445) y 0 n)   ; Y = aX + B X
          (gemm nil nil m n n (f 1) x 0 n b2 0 n (f 3.4445) y 0 n))  ; Y = aX + X B
      (rotatef x y))
    x))
(defun muon-tensor (p g mb cs shrink lr mu)
  (declare (fvec p g) (type fl cs shrink lr mu))
  (let* ((mom (mb-mom mb)) (x (mb-x mb)) (n (length p)))
    (declare (fvec mom x) (idx n))
    (dotimes (i n)
      (let ((gi (* cs (aref g i))))
        (setf (aref mom i) (+ (* mu (aref mom i)) gi)
              (aref x i) (+ gi (* mu (aref mom i)))
              (aref g i) (f 0))))
    (let* ((r (newton-schulz mb)) (st (* lr (mb-scale mb))))
      (declare (fvec r) (type fl st))
      ;; NEWTON-SCHULZ rotates x/y: after an odd number of iterations the result lives in Y; keep the slots consistent
      (unless (eq r x) (rotatef (mb-x mb) (mb-y mb)))
      (dotimes (i n) (setf (aref p i) (- (* shrink (aref p i)) (* st (aref r i))))))))
(defun enable-muon (opt m mlr mmom)
  "Switch the block matrices (Wqkv, Wproj, Wfc, Wfc2 of every layer) of OPT to Muon."
  (let* ((d (c-d (m-cfg m))) (nt (length (a-ps opt))) (v (make-array nt :initial-element nil)))
    (loop for l below (c-nl (m-cfg m))
          do (loop for (j din dout) in (list (list +wqkv+ d (* 3 d)) (list +wproj+ d d) (list +wfc+ d (* 4 d)) (list +wfc2+ (* 4 d) d))
                   do (setf (svref v (+ 2 (* 12 l) j)) (make-mbuf* din dout))))
    (setf (a-muon opt) v (a-mlr opt) mlr (a-mmom opt) mmom)
    ;; re-balance threads: a Muon tensor costs ~ (5 NS iters) much more than an AdamW tensor of the same size
    (let* ((nth* (length (a-assign opt))) (load (make-array nth* :initial-element 0)) (asg (make-array nth* :initial-element nil))
           (cost (lambda (i) (* (length (the fvec (svref (a-ps opt) i))) (if (svref v i) 40 1)))))
      (dolist (i (sort (loop for i below nt collect i) #'> :key cost))
        (let ((th (position (reduce #'min load) load))) (incf (aref load th) (funcall cost i)) (push i (aref asg th))))
      (setf (a-assign opt) asg))
    opt))

(defun opt-step (pool opt lr wd &optional (lr0 lr))
  "Reduce worker grads, global-norm clip 1.0, AdamW -- all tensors in parallel on POOL. Returns the grad norm."
  (declare (double-float lr wd))
  (let ((asg (a-assign opt)) (gs (a-gs opt)) (parts (a-parts opt)))
    (declare (simple-vector asg gs) (dvec parts))
    (run-pool pool (lambda (th) (dolist (i (svref asg th)) (reduce-tensor (svref gs i) parts i))))
    (let* ((norm (sqrt (let ((s 0d0)) (declare (double-float s)) (loop for x across parts do (incf s x)) s)))
           (cs (coerce (if (> norm 1d0) (/ 1d0 norm) 1d0) 'fl)) (tn (incf (a-tn opt)))
           (c1 (- 1d0 (expt 0.9d0 tn))) (c2 (- 1d0 (expt 0.99d0 tn)))
           (lrc (coerce (/ lr c1) 'fl)) (ic2 (coerce (/ 1d0 c2) 'fl))
           (ps (a-ps opt)) (dec (a-decays opt)) (ms (coerce (a-ms opt) 'simple-vector)) (vs (coerce (a-vs opt) 'simple-vector))
           (sh-d (coerce (- 1d0 (* lr wd)) 'fl))
           (mu (a-muon opt)) (mlr (coerce (* (a-mlr opt) (/ lr lr0)) 'fl)) (mmom (coerce (a-mmom opt) 'fl)))
      (run-pool pool (lambda (th) (dolist (i (svref asg th))
                                    (let ((mb (and mu (svref mu i))))
                                      (if mb
                                          (muon-tensor (svref ps i) (svref (svref gs i) 0) mb cs sh-d mlr mmom)
                                          (adam-tensor (svref ps i) (svref (svref gs i) 0) (svref ms i) (svref vs i) cs
                                                       (if (svref dec i) sh-d (f 1)) lrc ic2))))))
      norm)))

;;; reference (serial) AdamW identical to gpt-big.lisp, used by the gradcheck/equivalence tests
(defun adamw (m opt grads lr wd)
  (declare (double-float lr wd))
  (let* ((norm (sqrt (loop for gr in grads sum (let ((gr gr)) (declare (fvec gr)) (loop for x across gr sum (* (coerce x 'double-float) x) of-type double-float)) of-type double-float)))
         (cs (coerce (if (> norm 1d0) (/ 1d0 norm) 1d0) 'fl)) (tn (incf (a-tn opt)))
         (c1 (- 1d0 (expt 0.9d0 tn))) (c2 (- 1d0 (expt 0.99d0 tn)))
         (lrc (coerce (/ lr c1) 'fl)) (ic2 (coerce (/ 1d0 c2) 'fl)))
    (loop for (p . decay) in (model-vecs m) for g in grads for mm in (a-ms opt) for vv in (a-vs opt)
          do (adam-tensor p g mm vv cs (coerce (if decay (- 1d0 (* lr wd)) 1d0) 'fl) lrc ic2))
    norm))
;;; ---------- gradient check (use FT=double) ----------
(defun gradcheck (&optional (p 0d0) short)
  "SHORT: short-context path -- workers built for T=8 x 2 seqs run 4 seqs of length 4 at position offset 3."
  (setf *pdrop* p)
  (let* ((gv (parse-integer (opt "gcv" "5"))) (c (make-cfg :v gv :d 8 :nl 2 :nh 2 :tt (if short 8 4))) (m (make-model* c)) (k 2) (b (if short 4 2)) (nt 4)
         (ws (loop repeat k collect (let ((w (make-wk* c 2))) (when short (setf (w-b w) 4 (w-poff w) 3)) w))) (scale (coerce (/ 1d0 (* k b nt)) 'fl))
         (eps (if (eq *ft* 'single-float) 1d-2 1d-5)) (worst 0d0) (wa 0d0) (cnt 0) (sd2 0d0) (sn2 0d0))
    ;; perturb all params (so LN gains/biases are not trivially 1/0)
    (dolist (pv (model-vecs m)) (let ((p (car pv))) (declare (fvec p)) (dotimes (i (length p)) (incf (aref p i) (coerce (* 0.3 (randn)) 'fl)))))
    (dolist (w ws) (dotimes (q (* b nt)) (setf (aref (w-ids w) q) (random gv *rs*) (aref (w-tgt w) q) (random gv *rs*))))
    (dolist (w ws) (setf (w-drop w) (> p 0d0) (w-newmask w) t))
    (flet ((loss (bp) (dolist (w ws) (setf (w-loss w) 0d0 (w-count w) 0) (forward-backward m w nt 0 bp scale) (setf (w-newmask w) nil))
                 (* (coerce scale 'double-float) (loop for w in ws sum (w-loss w)))))
      (loss t)
      (loop for (p) in (model-vecs m) for g in (sum-grads ws) for name from 0
            do (let ((p p) (g g)) (declare (fvec p g))
                 (dotimes (i (length p))
                   (let* ((old (aref p i)) (pp (coerce (+ old eps) 'fl)) (pm (coerce (- old eps) 'fl))
                          (lp (progn (setf (aref p i) pp) (loss nil))) (lm (progn (setf (aref p i) pm) (loss nil)))
                          (num (/ (- lp lm) (- (coerce pp 'double-float) (coerce pm 'double-float)))) (an (coerce (aref g i) 'double-float)))
                     (setf (aref p i) old) (incf cnt) (incf sd2 (expt (- num an) 2)) (incf sn2 (expt num 2))
                     (setf wa (max wa (abs (- num an))) worst (if (> (+ (abs num) (abs an)) 1d-7) (max worst (/ (abs (- num an)) (+ (abs num) (abs an)))) worst)))))))
    (format t "gradcheck~a FT=~a dropout=~a (masks fixed): tiny GPT (V=~d d=8 L=2 heads=2 T=4), 2 workers x 2 seqs, ~d params, eps=~a~%  max rel err (entries with |g|+|num|>1e-7) ~,3e, max abs err ~,3e, global |g-num|/|num| = ~,3e~%"
            (if short " [SHORT-CTX: buffers T=8, 2x4 seqs of 4 at pos offset 3]" "") *ft* p gv cnt eps worst wa (sqrt (/ sd2 sn2)))))

;;; ---------- training ----------
(defvar *steps-max* 0)
(defvar *last-val* nil)   ; (targets-scored characters-scored) of the last val-loss call
(defun muon-test ()
  "Two Muon steps on small random matrices (both orientations); dumps inputs/outputs for the numpy reference."
  (%set-threads 1)
  (with-open-file (o "/tmp/muontest.txt" :direction :output :if-exists :supersede)
    (dolist (sh '((6 10) (10 6) (8 8)))
      (destructuring-bind (m n) sh
        (let* ((mb (make-mbuf* m n)) (p (mkv (* m n))) (g1 (mkv (* m n))) (g2 (mkv (* m n))))
          (dotimes (i (* m n)) (setf (aref p i) (coerce (randn) 'fl) (aref g1 i) (coerce (randn) 'fl) (aref g2 i) (coerce (randn) 'fl)))
          (format o "shape ~d ~d~%p0 ~{~,9e~^ ~}~%g1 ~{~,9e~^ ~}~%g2 ~{~,9e~^ ~}~%" m n (coerce p 'list) (coerce g1 'list) (coerce g2 'list))
          (muon-tensor p (copy-seq g1) mb (f 0.5) (f 0.999) (f 0.02) (f 0.95))
          (format o "p1 ~{~,9e~^ ~}~%" (coerce p 'list))
          (muon-tensor p (copy-seq g2) mb (f 0.5) (f 0.999) (f 0.02) (f 0.95))
          (format o "p2 ~{~,9e~^ ~}~%" (coerce p 'list)))))))

;;; ---------- HARDENING: full training-state checkpoints (weights + Adam m/v + Muon momentum + step/time + RNGs) ----------
;;; <tag>-state-<step>.bin: raw LE f32 of state-vecs; <tag>-state-<step>.meta: readable plist (written last = commit marker).
;;; Both written to .tmp, fsync'd, then rename(2)d; only the newest KEEP pairs are kept.
(defun write-f32s (s vec)
  (let ((buf (make-array (length vec) :element-type '(unsigned-byte 32))))
    (dotimes (i (length vec)) (setf (aref buf i) (ldb (byte 32 0) (sb-kernel:single-float-bits (aref vec i)))))
    (write-sequence buf s)))
(defun read-f32s (s vec)
  (let ((buf (make-array (length vec) :element-type '(unsigned-byte 32))))
    (assert (= (read-sequence buf s) (length vec)))
    (dotimes (i (length vec)) (setf (aref vec i) (sb-kernel:make-single-float (let ((u (aref buf i))) (if (>= u #x80000000) (- u #x100000000) u)))))))
(defun state-vecs (m opt)
  (append (mapcar #'car (model-vecs m)) (a-ms opt) (a-vs opt)
          (when (a-muon opt) (loop for mb across (a-muon opt) when mb collect (mb-mom mb)))))
(defun fsync-stream (s)
  (finish-output s)
  (sb-alien:alien-funcall (sb-alien:extern-alien "fsync" (function sb-alien:int sb-alien:int)) (sb-sys:fd-stream-fd s)))
(defun atomic-rename (from to)
  (multiple-value-bind (ok err) (sb-unix:unix-rename (sb-ext:native-namestring from) (sb-ext:native-namestring to))
    (unless ok (error "rename ~a -> ~a failed: errno ~a" from to err))))
(defun save-state (tag step m opt plist keep)
  (let* ((bin (format nil "~a-state-~9,'0d.bin" tag step)) (meta (format nil "~a-state-~9,'0d.meta" tag step))
         (vecs (state-vecs m opt)) (nf (loop for v in vecs sum (length v))))
    (with-open-file (fo (concatenate 'string bin ".tmp") :direction :output :if-exists :supersede :element-type '(unsigned-byte 32))
      (dolist (v vecs) (write-f32s fo v)) (fsync-stream fo))
    (atomic-rename (concatenate 'string bin ".tmp") bin)
    (with-open-file (fo (concatenate 'string meta ".tmp") :direction :output :if-exists :supersede)
      (with-standard-io-syntax
        (let ((*print-readably* t))
          (prin1 (list* :version 1 :step step :nfloats nf :bin (file-namestring bin) plist) fo)))
      (terpri fo) (fsync-stream fo))
    (atomic-rename (concatenate 'string meta ".tmp") meta)
    ;; prune: keep the newest KEEP metas (names are zero-padded by step) and their bins
    (let ((metas (sort (mapcar #'sb-ext:native-namestring (directory (format nil "~a-state-*.meta" tag))) #'string>)))
      (dolist (old (nthcdr keep metas))
        (let ((ob (concatenate 'string (subseq old 0 (- (length old) 5)) ".bin")))
          (delete-file old) (when (probe-file ob) (delete-file ob)))))
    meta))
(defun load-state (meta m opt)
  "Fill weights + optimizer moments from META's bin; return the plist."
  (let* ((pl (with-open-file (s meta) (with-standard-io-syntax (let ((*read-eval* t)) (read s)))))
         (vecs (state-vecs m opt)) (nf (loop for v in vecs sum (length v)))
         (bin (merge-pathnames (getf pl :bin) meta)))
    (assert (eql (getf pl :version) 1))
    (unless (= nf (getf pl :nfloats))
      (error "resume: state file has ~d floats, this config needs ~d (different model or optim=?)" (getf pl :nfloats) nf))
    (with-open-file (fi bin :element-type '(unsigned-byte 32))
      (assert (= (file-length fi) nf)) (dolist (v vecs) (read-f32s fi v)))
    pl))

(defun main ()
  (setf *rs* (sb-ext:seed-random-state (parse-integer (opt "seed" "1"))))
  (setf *steps-max* (parse-integer (opt "steps" "0")))
  (%set-threads 1)
  (let ((pm (opt "prec" "fp32")))
    (setf *lp-min* (parse-integer (opt "lpmin" "1000000")) *ew32* (string= (opt "ew" "f64") "f32"))
    (format t "elementwise GELU precision: ~a~%" (if *ew32* "single (f32.8)" "double (f64.4, original)"))
    (unless (string= pm "fp32")
      (assert (zerop (%lp-init (opt "mkl" "/home/box/lisp-charmodel/venv/lib/libmkl_rt.so.3"))))
      (setf *gemm-mode* (if (string= pm "bf16") 2 1)))
    (format t "precision: GEMMs ~a (threshold m*n*k >= ~d; smaller GEMMs e.g. attention stay OpenBLAS fp32)~%" pm *lp-min*))
  (let* ((tokf (opt "tokens" nil))
         (bytes (if tokf (make-array 0 :element-type '(unsigned-byte 8)) (with-open-file (s (opt "data" "../input.txt") :element-type '(unsigned-byte 8))   ; ASCII corpus, read as octets
                  (let* ((b (make-array (file-length s) :element-type '(unsigned-byte 8))) (k (read-sequence b s))) (subseq b 0 k)))))
         (chars0 (let ((seen (make-array 256 :initial-element nil)))
                  (loop for x across bytes do (setf (svref seen x) t))
                  (coerce (loop for i below 256 when (svref seen i) collect (code-char i)) 'simple-vector)))
         (chars (if tokf   ; BPE mode: token strings from the hex vocab file (one token per line)
                    (with-open-file (s (opt "vocab" "")) (coerce (loop for l = (read-line s nil) while l
                                                                       collect (let ((st (make-string (floor (length l) 2))))
                                                                                 (dotimes (i (length st) st) (setf (char st i) (code-char (parse-integer l :start (* 2 i) :end (+ 2 (* 2 i)) :radix 16)))))) 'simple-vector))
                    chars0))
         (clen (map '(simple-array fixnum (*)) (lambda (x) (if (stringp x) (length x) 1)) chars))   ; characters per token
         (v (length chars)) (c2i (let ((ht (make-hash-table))) (loop for ch across chars for i from 0 do (setf (gethash (if (and (stringp ch) (= (length ch) 1)) (char ch 0) ch) ht) i)) ht))
         (data (if tokf
                   (with-open-file (s tokf :element-type '(unsigned-byte 16))   ; uint16 little-endian token ids
                     (let ((d (make-array (file-length s) :element-type '(unsigned-byte 16)))) (read-sequence d s) d))
                   (let ((lut (make-array 256 :element-type '(unsigned-byte 8) :initial-element 0)) (d (make-array (length bytes) :element-type '(unsigned-byte 8))))
                 (loop for ch across chars for i from 0 do (setf (aref lut (char-code ch)) i))
                 (loop for x across bytes for i from 0 do (setf (aref d i) (aref lut x))) d)))
         (nall (length data)) (vstart (if tokf (parse-integer (opt "vstart" "0")) (floor (* 0.9 nall))))             ; same fixed split as the ablation
         (tt (parse-integer (opt "ctx" "64"))) (c (make-cfg :v v :d (parse-integer (opt "d" "128")) :nl (parse-integer (opt "layers" "4"))
                                                       :nh (parse-integer (opt "heads" "4")) :tt tt))
         (k (parse-integer (opt "threads" "8"))) (bt (parse-integer (opt "batch" "32"))) (b (floor bt k))
         (lr0 (float (read-from-string (opt "lr" "1e-3")) 1d0)) (wd (float (read-from-string (opt "wd" "0.1")) 1d0))
         (budget (float (parse-integer (opt "secs" "480")) 1d0)) (warm (float (read-from-string (opt "warm" "0.02")) 1d0)) (sched (opt "sched" "cosine"))
         (dfrac (float (read-from-string (opt "decay" "0.2")) 1d0)) (lrmin (float (read-from-string (opt "lrmin" "0.1")) 1d0))
         (n1m (parse-integer (opt "fullval-targets" "1000000")))
         (ctx1 (parse-integer (opt "ctx1" (opt "ctx" "64")))) (switch (float (read-from-string (opt "switch" "1")) 1d0)) (posoff (string= (opt "posoff" "0") "1"))
         (pdrop (setf *pdrop* (float (read-from-string (opt "dropout" "0")) 1d0)))
         (m (make-model* c)) (ws (loop repeat k collect (make-wk* c b))) (opt (make-adam* m ws k)) (pool (make-pool* k))
         (scale (coerce (/ 1d0 (* bt tt)) 'fl)) (half (floor tt 2))
         (step 0) (t0 (get-internal-real-time)) (hist nil) (fhist nil) (eval-secs 0d0)
         (fevery (float (parse-integer (opt "fullval-every" "0")) 1d0)) (fnext (float (parse-integer (opt "fullval-every" "0")) 1d0))
         ;; #10 options (all off by default => identical behaviour): periodic FULL val, weight checkpoints, wall cap, early stop
         (pfull (string= (opt "periodic-full" "0") "1")) (ckpt (string= (opt "ckpt" "0") "1"))
         (wallmax (float (parse-integer (opt "wallmax" "0")) 1d0))
         (estop (parse-integer (opt "earlystop" "0"))) (etol (float (read-from-string (opt "estol" "0.003")) 1d0))
         (lhist nil) (stopnow nil)
         ;; HARDENING options (all off by default => identical behaviour): ackpt=SECS full-state checkpoint every SECS of wall time,
         ;; ackpt-steps=N also/instead every N steps (tests), ackpt-keep=2, resume=<tag>-state-*.meta continues exactly.
         (tbase 0d0) (ackpt (float (read-from-string (opt "ackpt" "0")) 1d0)) (ackpt-steps (parse-integer (opt "ackpt-steps" "0")))
         (ackpt-keep (parse-integer (opt "ackpt-keep" "2"))) (anext 0d0)
         ;; #13 cyclic warm restarts (sched=cyc): CYCLE s constant peak, then CDECAY s linear decay to 0, then jump back to peak.
         ;; Times are absolute training seconds = tsecs + TOFF (TOFF lets a crash-resume via init= continue the schedule). Full val + ckpt at each decay end.
         (ccon (float (read-from-string (opt "cycle" "7200")) 1d0)) (cdec (float (read-from-string (opt "cdecay" "720")) 1d0))
         (toff (float (read-from-string (opt "toff" "0")) 1d0)) (cidx (floor toff (+ ccon cdec))))
    (declare (fixnum step) (double-float eval-secs))
    (assert (= (* b k) bt)) (assert (zerop (mod (* b tt) ctx1)))
    (let ((initf (opt "init" "")))   ; #11: load raw f32 weight checkpoint (model-vecs order; weights only, optimizer state starts fresh)
      (when (plusp (length initf))
        (with-open-file (fi initf :element-type '(unsigned-byte 32))
          (assert (= (file-length fi) (loop for pv in (model-vecs m) sum (length (car pv)))))
          (dolist (pv (model-vecs m))
            (let ((vec (car pv))) (dotimes (i (length vec)) (setf (aref vec i) (sb-kernel:make-single-float (let ((u (read-byte fi))) (if (>= u #x80000000) (- u #x100000000) u)))))))
          (format t "INIT: loaded ~d f32 weights from ~a (no optimizer state; Adam/Muon moments start at zero)~%" (file-length fi) initf) (finish-output))))
    (when (string= (opt "optim" "adamw") "muon")
      (enable-muon opt m (float (read-from-string (opt "mlr" "0.02")) 1d0) (float (read-from-string (opt "mmom" "0.95")) 1d0))
      (format t "Muon on block matrices: mlr=~a (x WSD/cosine multiplier lr/lr0) momentum=~a nesterov, NS5, scale sqrt(max(1,dout/din)), wd shrink (1-lr*wd) as AdamW; AdamW for wte/wpe/LN/biases~%"
              (a-mlr opt) (a-mmom opt)))
    (let ((rf (opt "resume" "")))   ; HARDENING: exact resume from a full-state checkpoint
      (when (plusp (length rf))
        (let ((pl (load-state rf m opt)))
          (unless (= (length (getf pl :wrng)) k) (error "resume: checkpoint was written with threads=~d, now threads=~d" (length (getf pl :wrng)) k))
          (setf step (getf pl :step) tbase (getf pl :tsecs) fnext (getf pl :fnext) cidx (getf pl :cidx)
                hist (getf pl :hist) fhist (getf pl :fhist) lhist (getf pl :lhist) (a-tn opt) (getf pl :tn) *rs* (getf pl :rs))
          (loop for w in ws for r in (getf pl :wrng) do (setf (aref (w-rng w) 0) r))
          (format t "RESUME: ~a -> step ~d, train time ~,1fs, adam t=~d, ~d state floats (weights + Adam m/v~a), RNGs restored~%"
                  rf step tbase (a-tn opt) (getf pl :nfloats) (if (a-muon opt) " + Muon momentum" "")) (finish-output))))
    (labels ((secs () (/ (- (get-internal-real-time) t0) internal-time-units-per-second 1d0))
             (tsecs () (+ tbase (- (secs) eval-secs)))     ; training time = wall time minus evaluation time
             (write-full () (with-open-file (fo (format nil "~a-val1m.csv" (opt "tag" "gpt")) :direction :output :if-exists :supersede)
                              (format fo "step,train_seconds,val_1m~%") (dolist (r (reverse fhist)) (when (consp r) (format fo "~{~a~^,~}~%" r)))))
             (lr-at (fr) (cond ((< fr warm) (* lr0 (max 0.01d0 (/ fr warm))))
                               ((string= sched "cyc")
                                (let ((pos (mod (+ (* fr budget) toff) (+ ccon cdec))))
                                  (if (< pos ccon) lr0 (* lr0 (max 0d0 (- 1d0 (/ (- pos ccon) cdec)))))))
                               ((string= sched "lin") (* lr0 (max 0d0 (- 1d0 fr))))   ; #11: linear decay peak -> 0 over the whole budget
                               ((string= sched "const") lr0)   ; #10: warmup then constant peak (no decay)
                               ((string= sched "wsd")      ; warmup -> constant peak -> linear decay to lrmin*peak over the last DFRAC
                                (let ((d0 (- 1d0 dfrac))) (if (< fr d0) lr0 (* lr0 (+ lrmin (* (- 1d0 lrmin) (max 0d0 (/ (- 1d0 fr) dfrac))))))))
                               (t (+ (* lrmin lr0) (* (- 1d0 lrmin) lr0 0.5d0 (+ 1d0 (cos (* pi (min 1d0 (/ (- fr warm) (- 1d0 warm)))))))))))
             (load-window (w s0 start)       ; sequence slot s0 of worker w <- window starting at START
               (dotimes (i tt) (setf (aref (w-ids w) (+ (* s0 tt) i)) (aref data (+ start i))
                                     (aref (w-tgt w) (+ (* s0 tt) i)) (aref data (+ start i 1)))))
             (tchars (start count)   ; characters covered by the COUNT targets data[start..]
               (loop for j from start below (+ start count) sum (aref clen (aref data j))))
             (val-loss (ntargets)
               ;; Windows of length tt with stride tt/2; score only the second half of each window
               ;; (so every scored char has between tt/2 and tt-1 chars of context). First scored target = vstart.
               (dolist (w ws) (setf (w-drop w) nil))
               (let* ((e0 (secs)) (starts (loop for s from (- vstart 1 half) by half
                                                while (and (< (+ s half 1) (+ vstart ntargets)) (<= (+ s tt 1) nall))
                                                collect s)))
                 (dolist (w ws) (setf (w-loss w) 0d0 (w-count w) 0))
                 (loop while starts
                       do (let ((batch (loop repeat bt while starts collect (pop starts))))
                            ;; pad incomplete batches by repeating the last window, then discount
                            (let* ((nreal (length batch)) (padded (append batch (make-list (- bt nreal) :initial-element (car (last batch))))))
                              (loop for w in ws for kk from 0
                                    do (dotimes (s0 b) (load-window w s0 (nth (+ (* kk b) s0) padded))))
                              (let ((before (mapcar (lambda (w) (cons (w-loss w) (w-count w))) ws)))
                                (run-pool pool (lambda (i) (forward-backward m (nth i ws) tt half nil scale)))
                                ;; drop padded sequences' contribution: recompute is costly, so pads are excluded by
                                ;; re-running only the real ones when the batch is partial (last batch only)
                                (when (< nreal bt)
                                  (loop for w in ws for (l0 . c0) in before do (setf (w-loss w) l0 (w-count w) c0))
                                  (let ((w1 (make-wk* c 1)))
                                    (dolist (s batch)
                                      (load-window w1 0 s)
                                      (forward-backward m w1 tt half nil scale)
                                      (incf (w-loss (car ws)) (w-loss w1)) (incf (w-count (car ws)) (w-count w1))
                                      (setf (w-loss w1) 0d0 (w-count w1) 0))))))))
                 (incf eval-secs (- (secs) e0))
                 (let ((nats (loop for w in ws sum (w-loss w))) (cnt (loop for w in ws sum (w-count w))))
                   (if tokf   ; BPE: nats per CHARACTER = total nats / characters of the scored (contiguous from vstart) targets
                       (let ((ch (tchars vstart cnt))) (setf *last-val* (list cnt ch)) (/ nats ch))
                       (progn (setf *last-val* (list cnt cnt)) (/ nats cnt)))))))
      (format t "dropout=~a (emb, attn probs, attn/MLP residual outputs; off at eval)~%" pdrop)
      (when tokf (format t "BPE tokens: ~a vocab ~d, ~d train tokens, val from token ~d; losses reported in nats per CHARACTER~%" tokf v vstart vstart))
      (format t "config: GPT d=~d layers=~d heads=~d ctx=~d vocab=~d params=~d | batch ~d seqs (~d tokens), threads=~d (x ~d seqs), FT=~a~%"
              (c-d c) (c-nl c) (c-nh c) tt v (nparams m) bt (* bt tt) k b *ft*)
      (format t "AdamW lr=~a betas 0.9/0.99 wd=~a clip 1.0, schedule ~a warm=~a decay=~a lrmin=~a over ~ds of training time (eval excluded) | data ~a | train chars ~d, val chars ~d (last 10%)~%"
              lr0 wd sched warm dfrac lrmin (round budget) (opt "data" "../input.txt") vstart (- nall vstart))
      (format t "val protocol: windows of ~d, stride ~d, score 2nd half (context ~d..~d); periodic val = first 32000 val targets every 200 steps~%"
              tt half half (1- tt))
      (when (< ctx1 tt) (format t "short-context training: ctx ~d (~d seqs/step, same tokens/step) until ~,2f of the budget, then ctx ~d; posoff=~a; eval always at ctx ~d~%" ctx1 (* k (floor (* b tt) ctx1)) switch tt posoff tt))
      (when (string= sched "cyc")
        (format t "cyclic schedule: ~as constant + ~as linear decay to 0 per cycle, toff=~a, warm=~a~%" ccon cdec toff warm)
        (when (string= (opt "lrtrace" "0") "1")   ; print the schedule on a grid of training seconds (no training effect)
          (loop for i from 0 to 200 do (let ((tt* (* budget (/ i 200d0)))) (format t "LRTRACE t=~,2f lr=~,8f~%" (+ tt* toff) (lr-at (/ tt* budget)))))))
      (finish-output)
      (loop for el = (tsecs) while (and (< el budget) (or (zerop *steps-max*) (< step *steps-max*))
                                        (not stopnow) (or (zerop wallmax) (< (secs) wallmax)))
            do (let* ((ntc (if (and (< ctx1 tt) (< (/ el budget) switch)) ctx1 tt)) (bc (floor (* b tt) ntc)))
                 (when (and (< ctx1 tt) (= ntc tt) (null (find :sw fhist)))
                   (format t "SWITCH to ctx ~d at step ~d t=~,1fs~%" tt step el) (finish-output) (push :sw fhist))
                 (dolist (w ws)
                   (setf (w-b w) bc (w-poff w) (if (and posoff (< ntc tt)) (random (1+ (- tt ntc)) *rs*) 0))
                   (dotimes (s0 bc) (let ((st (random (- vstart ntc 1) *rs*)))
                                      (dotimes (i ntc) (setf (aref (w-ids w) (+ (* s0 ntc) i)) (aref data (+ st i))
                                                             (aref (w-tgt w) (+ (* s0 ntc) i)) (aref data (+ st i 1))))))
                   (setf (w-loss w) 0d0 (w-count w) 0 (w-drop w) (> pdrop 0d0) (w-newmask w) t))
                 (run-pool pool (lambda (i) (forward-backward m (nth i ws) ntc 0 t scale)))
                 (dolist (w ws) (setf (w-b w) b (w-poff w) 0)))
               (opt-step pool opt (lr-at (/ el budget)) wd lr0)
               (incf step)
               (when (zerop (mod step 200))
                 (let ((tl (/ (loop for w in ws sum (w-loss w))
                              (if tokf (loop for w in ws sum (let ((tg (w-tgt w))) (loop for q below (* b tt) sum (aref clen (aref tg q)))))
                                  (loop for w in ws sum (w-count w)))))
                       (vl (val-loss 32000)))
                   (format t "step ~6d  t=~6,1fs  wall=~6,1fs  lr=~,6f  train(last batch)=~,4f  val(subset)=~,4f~%" step (tsecs) (secs) (lr-at (/ (tsecs) budget)) tl vl)
                   (push (list step (tsecs) tl vl) hist) (finish-output)
                   (with-open-file (fo (format nil "~a.csv" (opt "tag" "gpt")) :direction :output :if-exists :supersede)
                     (format fo "step,seconds,train_batch,val_subset~%") (dolist (r (reverse hist)) (format fo "~{~a~^,~}~%" r)))))
               (when (and (or (and (> fevery 0d0) (>= (tsecs) fnext))
                              (and (string= sched "cyc") (> (floor (+ (tsecs) toff) (+ ccon cdec)) cidx)))
                          (< (tsecs) budget))
                 (if (and (string= sched "cyc") (> (floor (+ (tsecs) toff) (+ ccon cdec)) cidx))
                     (progn (setf cidx (floor (+ (tsecs) toff) (+ ccon cdec)))
                            (format t "CYCLE-END ~d at step ~d t=~,1fs (abs ~,1fs) lr now ~,6f~%" cidx step (tsecs) (+ (tsecs) toff) (lr-at (/ (tsecs) budget))))
                     (loop while (>= (tsecs) fnext) do (incf fnext fevery)))
                 (let* ((ts (tsecs)) (vf (val-loss n1m)))
                   (format t "VAL1M step ~d  t=~,1fs  val(first ~d val targets = ~d chars)=~,4f~%" step ts n1m (second *last-val*) vf) (finish-output)
                   (push (list step ts vf) fhist) (write-full)
                   (when pfull
                     (let* ((vfull (val-loss nall))
                            (rec (loop for r in hist repeat 10 collect (third r)))   ; train batch loss, last 10 logged points (2000 steps)
                            (tr (if rec (/ (reduce #'+ rec) (length rec)) 0d0)))
                       (push (list step ts (secs) vf vfull tr) lhist)
                       (format t "FULLVAL step ~d  t=~,1fs  wall=~,1fs  val1m=~,4f  full=~,4f  train(avg last 10 logs)=~,4f~%" step ts (secs) vf vfull tr)
                       (with-open-file (fo (format nil "~a-long.csv" (opt "tag" "gpt")) :direction :output :if-exists :supersede)
                         (format fo "step,train_seconds,wall_seconds,val_1m,val_full,train_recent~%")
                         (dolist (r (reverse lhist)) (format fo "~{~a~^,~}~%" r)))
                       (when ckpt   ; raw little-endian f32 dump of all parameters in model-vecs order (weights only; no optimizer state)
                         (with-open-file (fo (format nil "~a-ckpt-~6,'0d.f32" (opt "tag" "gpt") step) :direction :output :if-exists :supersede
                                             :element-type '(unsigned-byte 32))
                           (dolist (pv (model-vecs m))
                             (let ((vec (car pv))) (dotimes (i (length vec)) (write-byte (ldb (byte 32 0) (sb-kernel:single-float-bits (aref vec i))) fo))))))
                       (when (and (> estop 0) (>= (length lhist) (1+ estop)))
                         (let* ((fulls (mapcar #'fifth lhist)) (recent (subseq fulls 0 estop)) (best (reduce #'min fulls)))
                           (when (every (lambda (x) (> x (+ best etol))) recent)
                             (format t "EARLY STOP: last ~d full-val evals all > best ~,4f + ~a~%" estop best etol) (setf stopnow t))))
                       (finish-output)))))
               (when (or (and (> ackpt 0d0) (>= (secs) (if (zerop anext) (setf anext ackpt) anext)))
                         (and (> ackpt-steps 0) (zerop (mod step ackpt-steps))))
                 (let* ((e0 (secs))
                        (mf (save-state (opt "tag" "gpt") step m opt
                                        (list :tsecs (tsecs) :fnext fnext :cidx cidx :tn (a-tn opt) :rs *rs*
                                              :wrng (loop for w in ws collect (aref (w-rng w) 0))
                                              :hist hist :fhist fhist :lhist lhist :argv (cdr sb-ext:*posix-argv*))
                                        ackpt-keep)))
                   (incf eval-secs (- (secs) e0)) (setf anext (+ (secs) ackpt))   ; save time is excluded from training time
                   (format t "STATE step ~d t=~,1fs saved ~a (~,1fs)~%" step (tsecs) mf (- (secs) e0)) (finish-output))))
      (when (string= (opt "savefinal" "0") "1")   ; #12: dump final weights (same raw f32 format as ckpt=1)
        (with-open-file (fo (format nil "~a-final-~6,'0d.f32" (opt "tag" "gpt") step) :direction :output :if-exists :supersede :element-type '(unsigned-byte 32))
          (dolist (pv (model-vecs m)) (let ((vec (car pv))) (dotimes (i (length vec)) (write-byte (ldb (byte 32 0) (sb-kernel:single-float-bits (aref vec i))) fo)))))
        (format t "SAVED final weights ~a-final-~6,'0d.f32~%" (opt "tag" "gpt") step) (finish-output))
      (let ((s (tsecs)))
        (format t "trained ~d steps in ~,1fs training time (wall ~,1fs, eval ~,1fs): ~,2f steps/s, ~,0f tokens/s (training time)~%" step s (secs) eval-secs (/ step s) (/ (* step bt tt) s))
        (finish-output)
        (let ((v1 (val-loss n1m)))
          (format t "VAL1M step ~d  t=~,1fs  val(first ~d val targets = ~d chars)=~,4f  (end of training)~%" step s n1m (second *last-val*) v1)
          (push (list step s v1) fhist) (write-full))
        (when (string/= (opt "final" "1") "0")   ; final=0 skips the full-val pass (used for short LR-sweep runs)
        (let ((vl (val-loss nall))) (format t "FINAL: val(full fixed val, ~d targets scored, ~d chars)=~,4f nats/char~%" (first *last-val*) (second *last-val*) vl)
          (with-open-file (fo (format nil "~a-final.csv" (opt "tag" "gpt")) :direction :output :if-exists :supersede)
            (format fo "step,train_seconds,tokens_per_s,val_full10pct~%~d,~,1f,~,0f,~a~%" step s (/ (* step bt tt) s) vl))) (finish-output)))
      ;; sample 300 chars at T=0.8 from a newline, context window up to tt
      (let ((w (make-wk* c 1)) (ctx (list (or (gethash #\Newline c2i) 0))))
        (format t "~%=== sample (T=0.8) ===~%~a~%"
                (with-output-to-string (o)
                  (dotimes (q 300)
                    (let* ((cl (last ctx tt)) (nt (length cl)))
                      (loop for ch in cl for i from 0 do (setf (aref (w-ids w) i) ch (aref (w-tgt w) i) 0))
                      (forward-backward m w nt 0 nil (f 1))
                      (let* ((P (w-P w)) (o0 (* (1- nt) v))
                             (wt (loop for j below v collect (expt (max (coerce (aref P (+ o0 j)) 'double-float) 1d-300) 1.25d0)))
                             (u (* (random 1d0 *rs*) (reduce #'+ wt))) (acc 0d0) (ch (1- v)))
                        (loop for x in wt for j from 0 do (incf acc x) (when (> acc u) (setf ch j) (return)))
                        (princ (svref chars ch) o) (setf ctx (append ctx (list ch)))))))))
      (stop-pool pool))))

(let ((mode (opt "mode" "train")))
  (when (member "--run" sb-ext:*posix-argv* :test #'string=)
    (if (string= mode "muontest") (muon-test) (if (string= mode "gradcheck") (progn (gradcheck 0d0) (gradcheck 0d0 t) (gradcheck 0.2d0 t)) (main)))))
