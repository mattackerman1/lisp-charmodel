(require :sb-simd)
(defun size (x) (cond ((consp x) (+ 1 (size (car x)) (size (cdr x)))) ((null x) 0) (t 1)))
(let ((forms nil) (*read-eval* nil))
  (with-open-file (s (second sb-ext:*posix-argv*))
    (loop for f = (read s nil :eof) until (eq f :eof) do (push f forms) (when (and (consp f) (member (car f) '(defpackage in-package))) (eval f))))
  (dolist (f (nreverse forms))
    (when (and (consp f) (member (symbol-name (car f)) '("DEFUN" "DEFOP" "DEFMACRO" "EVAL-WHEN") :test #'string=))
      (let ((n (if (eq (car f) 'eval-when) "eval-when" (second f))))
        (when (member (string-downcase (string n)) '("layernorm" "ln-back" "linear" "linear-back" "gelu" "gelu-back" "attention" "attention-back" "forward-backward" "defop" "tape" "embed" "head" "eval-when") :test #'string=)
          (format t "~a ~d~%" (string-downcase (string n)) (size f)))))))
