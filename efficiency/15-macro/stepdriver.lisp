;; usage: sbcl --script stepdriver.lisp <file.lisp> <optim> <dropout> -- per-step training loss, same data/RNG path for both files
(load (second sb-ext:*posix-argv*))
(in-package :gpt)
(let* ((args sb-ext:*posix-argv*) (optim (third args)) (pdrop (float (read-from-string (fourth args)) 1d0))
       (bytes (with-open-file (s "../../input.txt" :element-type '(unsigned-byte 8)) (let ((b (make-array 1000000 :element-type '(unsigned-byte 8)))) (read-sequence b s) b)))
       (lut (make-array 256 :initial-element 0)) (v 0))
  (setf *rs* (sb-ext:seed-random-state 1) *pdrop* pdrop)
  (%set-threads 1)
  (loop for x across bytes do (when (zerop (aref lut x)) (setf (aref lut x) (incf v))))
  (let* ((data (map 'vector (lambda (x) (1- (aref lut x))) bytes)) (k 8) (b 4) (tt 64)
         (c (make-cfg :v v :d 128 :nl 4 :nh 4 :tt tt)) (m (make-model* c)) (ws (loop repeat k collect (make-wk* c b)))
         (opt (make-adam* m ws k)) (pool (make-pool* k)) (scale (coerce (/ 1d0 (* k b tt)) 'fl)))
    (when (string= optim "muon") (enable-muon opt m 0.02d0 0.95d0))
    (dotimes (step 60)
      (dolist (w ws)
        (dotimes (s0 b) (let ((st (random (- (length data) tt 1) *rs*)))
                          (dotimes (i tt) (setf (aref (w-ids w) (+ (* s0 tt) i)) (aref data (+ st i)) (aref (w-tgt w) (+ (* s0 tt) i)) (aref data (+ st i 1))))))
        (setf (w-loss w) 0d0 (w-count w) 0 (w-drop w) (> pdrop 0d0) (w-newmask w) t))
      (run-pool pool (lambda (i) (forward-backward m (nth i ws) tt 0 t scale)))
      (let ((gn (opt-step pool opt 1d-3 0.1d0)))
        (format t "step ~3d loss ~,12f gradnorm ~,12f~%" (1+ step) (/ (loop for w in ws sum (w-loss w)) (loop for w in ws sum (w-count w))) gn)))
    (format t "weights-sxhash ~a~%" (sxhash (with-output-to-string (o) (dolist (pv (model-vecs m)) (loop for x across (car pv) do (format o "~x," (sb-kernel:single-float-bits x)))))))
    (stop-pool pool)))
