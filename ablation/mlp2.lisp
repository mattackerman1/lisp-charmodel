;;;; mlp2.lisp -- flat MLP vs WaveNet-style hierarchical MLP (makemore part 5) on the new split.
;;;; Options: arch=flat|wavenet  emb=..  hid=..  secs=480  tag=..  mode=train|gradcheck
;;;; flat:    Emb(ctx 8) -> concat -> Linear+bias -> tanh -> Linear -> softmax
;;;; wavenet: Emb -> [FlattenConsecutive(2) -> Linear(no bias) -> BatchNorm -> tanh] x3 -> Linear -> softmax
;;;; FlattenConsecutive is free: a row-major (R x C) matrix is the same memory as (R/2 x 2C).
(load (compile-file "/home/box/lisp-nn/fast/fnn.lisp" :output-file "/tmp/fnn-abl.fasl" :verbose nil :print nil))
(in-package :fnn)
(declaim (optimize (speed 3) (safety 0)))
(defun opt (key default)
  (let ((a (find-if (lambda (s) (and (> (length s) (length key)) (string= (concatenate 'string key "=") s :end2 (1+ (length key)))))
                    sb-ext:*posix-argv*)))
    (if a (subseq a (1+ (length key))) default)))
(defconstant +ctx+ 8)
(defparameter *bmax* 32)

(defstruct ly kind (in 0 :type fixnum) (out 0 :type fixnum) (fold 1 :type fixnum)  ; fold: consecutive rows merged before this layer
  w b gw gb y dx xin (rows 0 :type fixnum)       ; linear / generic
  rmean rvar xhat istd)                          ; batchnorm (w=gamma, b=beta)

(defun make-dvec* (n &key (initial-element 0d0)) (make-array n :element-type 'double-float :initial-element (float initial-element 1d0)))
(defun mk-linear (in out bias scale fold)
  (let ((w (make-dvec (* in out))))
    (dotimes (i (length w)) (setf (aref w i) (* scale (randn))))
    (make-ly :kind :linear :in in :out out :fold fold :w w :gw (make-dvec (* in out))
             :b (and bias (make-dvec out)) :gb (and bias (make-dvec out)))))
(defun mk-bn (n) (make-ly :kind :bn :in n :out n :w (make-dvec* n :initial-element 1d0) :gw (make-dvec n)
                         :b (make-dvec n) :gb (make-dvec n) :rmean (make-dvec n) :rvar (make-dvec* n :initial-element 1d0)
                         :istd (make-dvec n)))
(defun mk-tanh (n) (make-ly :kind :tanh :in n :out n))
(defun ly-params (l) (remove nil (list (cons (ly-w l) (ly-gw l)) (and (ly-b l) (cons (ly-b l) (ly-gb l)))) :key #'car))

(defun alloc (layers rows0)
  "Allocate output/grad buffers given the number of input rows of the first layer."
  (let ((r rows0))
    (dolist (l layers)
      (setf r (/ r (ly-fold l)))
      (setf (ly-y l) (make-dvec (* r (ly-out l))) (ly-dx l) (make-dvec (* r (ly-in l))))
      (when (eq (ly-kind l) :bn) (setf (ly-xhat l) (make-dvec (* r (ly-out l))))))))

(defun ly-forward (l X r train)
  "X has R rows of (in) columns (after folding). Returns output buffer."
  (declare (dvec X) (dim r))
  (setf (ly-xin l) X (ly-rows l) r)
  (let ((in (ly-in l)) (out (ly-out l)) (Y (ly-y l)))
    (declare (dim in out) (dvec Y))
    (ecase (ly-kind l)
      (:linear (if (ly-b l) (dotimes (i r) (replace Y (the dvec (ly-b l)) :start1 (* i out))) (fill Y 0d0 :end (* r out)))
               (mm-add X (ly-w l) Y r in out))
      (:tanh (dotimes (q (* r out)) (setf (aref Y q) (fast-tanh (aref X q)))))
      (:bn (let ((g (ly-w l)) (be (ly-b l)) (rm (ly-rmean l)) (rv (ly-rvar l)) (xh (ly-xhat l)) (is (ly-istd l)))
             (declare (dvec g be rm rv xh is))
             (dotimes (j out)
               (let ((mu 0d0) (var 0d0))
                 (declare (double-float mu var))
                 (if train
                     (progn (dotimes (i r) (incf mu (aref X (+ (* i out) j)))) (setf mu (/ mu r))
                            (dotimes (i r) (let ((d (- (aref X (+ (* i out) j)) mu))) (incf var (* d d)))) (setf var (/ var r))
                            (setf (aref rm j) (+ (* 0.99d0 (aref rm j)) (* 0.01d0 mu))
                                  (aref rv j) (+ (* 0.99d0 (aref rv j)) (* 0.01d0 var))))
                     (setf mu (aref rm j) var (aref rv j)))
                 (let ((s (/ 1d0 (sqrt (+ var 1d-5)))))
                   (setf (aref is j) s)
                   (dotimes (i r)
                     (let* ((q (+ (* i out) j)) (x (* (- (aref X q) mu) s)))
                       (setf (aref xh q) x (aref Y q) (+ (* (aref g j) x) (aref be j)))))))))))
    Y))

(defun ly-backward (l dY need-dx)
  "Accumulate param grads; return dX (or NIL)."
  (declare (dvec dY))
  (let ((in (ly-in l)) (out (ly-out l)) (r (ly-rows l)) (X (ly-xin l)) (dX (ly-dx l)))
    (declare (dim in out r) (dvec X dX))
    (ecase (ly-kind l)
      (:linear (mtm-add X dY (ly-gw l) r in out)
               (when (ly-gb l) (dotimes (i r) (axpy 1d0 dY (* i out) (ly-gb l) 0 out)))
               (when need-dx (mmt dY (ly-w l) dX r out in)))
      (:tanh (let ((Y (ly-y l))) (declare (dvec Y))
               (dotimes (q (* r out)) (let ((y (aref Y q))) (setf (aref dX q) (* (aref dY q) (- 1d0 (* y y))))))))
      (:bn (let ((g (ly-w l)) (gg (ly-gw l)) (gbe (ly-gb l)) (xh (ly-xhat l)) (is (ly-istd l)))
             (declare (dvec g gg gbe xh is))
             (dotimes (j out)
               (let ((sd 0d0) (sdx 0d0))                ; sums of dxhat and dxhat*xhat
                 (declare (double-float sd sdx))
                 (dotimes (i r)
                   (let* ((q (+ (* i out) j)) (dy (aref dY q)))
                     (incf (aref gg j) (* dy (aref xh q))) (incf (aref gbe j) dy)
                     (incf sd (* dy (aref g j))) (incf sdx (* dy (aref g j) (aref xh q)))))
                 (let ((c (/ (aref is j) r)))
                   (dotimes (i r)
                     (let ((q (+ (* i out) j)))
                       (setf (aref dX q) (* c (- (* r (aref dY q) (aref g j)) sd (* (aref xh q) sdx))))))))))))
    dX))

(defstruct model emb gemb (e 0 :type fixnum) (v 0 :type fixnum) layers x0)

(defun build (arch v e hid)
  (let* ((emb (make-dvec (* v e))) (g53 (/ 5d0 3d0))
         (layers (if (string= arch "flat")
                     (list (mk-linear (* +ctx+ e) hid t (/ 1d0 (sqrt (float (* +ctx+ e) 1d0))) +ctx+)
                           (mk-tanh hid)
                           (mk-linear hid v t (/ 0.1d0 (sqrt (float hid 1d0))) 1))
                     (list (mk-linear (* 2 e) hid nil (/ g53 (sqrt (* 2d0 e))) 2) (mk-bn hid) (mk-tanh hid)
                           (mk-linear (* 2 hid) hid nil (/ g53 (sqrt (* 2d0 hid))) 2) (mk-bn hid) (mk-tanh hid)
                           (mk-linear (* 2 hid) hid nil (/ g53 (sqrt (* 2d0 hid))) 2) (mk-bn hid) (mk-tanh hid)
                           (mk-linear hid v t (/ 0.1d0 (sqrt (float hid 1d0))) 1)))))
    (dotimes (i (length emb)) (setf (aref emb i) (randn)))
    (alloc layers (* *bmax* +ctx+))
    (make-model :emb emb :gemb (make-dvec (* v e)) :e e :v v :layers layers :x0 (make-dvec (* *bmax* +ctx+ e)))))

(defun model-params (m) (cons (cons (model-emb m) (model-gemb m)) (mapcan #'ly-params (model-layers m))))
(defun count-params (m) (reduce #'+ (mapcar (lambda (pg) (length (car pg))) (model-params m))))

(defun forward (m ctxs b train)
  "CTXS: simple-vector of B context id vectors (length 8). Returns probabilities (B x V)."
  (declare (simple-vector ctxs) (dim b))
  (let ((x0 (model-x0 m)) (emb (model-emb m)) (e (model-e m)))
    (declare (dvec x0 emb) (dim e))
    (dotimes (i b)
      (dotimes (k +ctx+)
        (let ((c (svref (svref ctxs i) k)))
          (declare (dim c))
          (replace x0 emb :start1 (* (+ (* i +ctx+) k) e) :start2 (* c e) :end2 (* (1+ c) e)))))
    (let ((X x0) (r (* b +ctx+)))
      (declare (dim r))
      (dolist (l (model-layers m)) (setf r (/ r (ly-fold l)) X (ly-forward l X r train)))
      (let ((v (model-v m)) (P X))
        (declare (dim v) (dvec P))
        (dotimes (i b)
          (let* ((o (* i v)) (mx (aref P o)) (s 0d0))
            (declare (idx o) (double-float mx s))
            (loop for j from o below (+ o v) do (setf mx (max mx (aref P j))))
            (loop for j from o below (+ o v) do (setf (aref P j) (exp-neg (- (aref P j) mx))) (incf s (aref P j)))
            (loop for j from o below (+ o v) do (setf (aref P j) (/ (aref P j) s)))))
        P))))

(defun loss-and-backward (m ctxs ys b backprop &optional (train backprop))
  (declare (simple-vector ctxs ys) (dim b))
  (let* ((P (forward m ctxs b train)) (v (model-v m)) (loss 0d0) (inv (/ 1d0 b)))
    (declare (dvec P) (dim v) (double-float loss inv))
    (dotimes (i b) (decf loss (log (max 1d-300 (aref P (+ (* i v) (the dim (svref ys i))))))))
    (when backprop
      (let ((d (make-dvec (* b v))))
        (dotimes (q (* b v)) (setf (aref d q) (* inv (aref P q))))
        (dotimes (i b) (decf (aref d (+ (* i v) (the dim (svref ys i)))) inv))
        (let ((dX d) (rl (reverse (model-layers m))))
          (loop for (l . rest) on rl do (setf dX (ly-backward l dX t)))
          (let ((gemb (model-gemb m)) (e (model-e m)) (dX dX))        ; scatter into embedding
            (declare (dvec gemb dX) (dim e))
            (dotimes (i b)
              (dotimes (k +ctx+)
                (axpy 1d0 dX (* (+ (* i +ctx+) k) e) gemb (* (the dim (svref (svref ctxs i) k)) e) e)))))))
    (* loss inv)))

(defun sgd (m lr)
  (dolist (pg (model-params m))
    (let ((p (car pg)) (g (cdr pg))) (declare (dvec p g)) (axpy (- lr) g 0 p 0 (length p)) (fill g 0d0))))

(defun gradcheck (arch)
  (let* ((v 5) (b 4) (m (build arch v 3 4))
         (ctxs (coerce (loop repeat b collect (coerce (loop repeat +ctx+ collect (random v *rs*)) 'simple-vector)) 'simple-vector))
         (ys (coerce (loop repeat b collect (random v *rs*)) 'simple-vector)) (eps 1d-5) (w 0d0) (wa 0d0) (n 0))
    (dolist (pg (model-params m)) (let ((p (car pg))) (declare (dvec p)) (dotimes (i (length p)) (incf (aref p i) (* 0.1d0 (randn))))))
    (loss-and-backward m ctxs ys b t)
    (dolist (pg (model-params m))
      (let ((p (car pg)) (g (cdr pg))) (declare (dvec p g))
        (dotimes (i (length p))
          (let* ((old (aref p i)) (lp (progn (setf (aref p i) (+ old eps)) (loss-and-backward m ctxs ys b nil t)))
                 (lm (progn (setf (aref p i) (- old eps)) (loss-and-backward m ctxs ys b nil t))) (num (/ (- lp lm) (* 2 eps))))
            (setf (aref p i) old) (incf n) (setf wa (max wa (abs (- num (aref g i)))))
            (setf w (max w (/ (abs (- num (aref g i))) (max 1d-12 (+ (abs num) (abs (aref g i)))))))))))
    (format t "gradcheck ~a (any BatchNorm in train mode): ~d params, max relative error ~,3e, max abs error ~,3e~%" arch n w wa)))

(defun main ()
  (let* ((full (with-open-file (s "../input.txt" :external-format :utf-8)
                 (let* ((b (make-string (file-length s))) (k (read-sequence b s))) (subseq b 0 k))))
         (chars (coerce (sort (remove-duplicates (coerce full 'list)) #'char<) 'simple-vector))
         (v (length chars)) (c2i (let ((ht (make-hash-table))) (loop for c across chars for i from 0 do (setf (gethash c ht) i)) ht))
         (data (map 'simple-vector (lambda (c) (gethash c c2i)) full)) (nall (length data))
         (vstart (floor (* 0.9 nall))) (nl (gethash #\Newline c2i))
         (arch (opt "arch" "wavenet")) (e (parse-integer (opt "emb" (if (string= arch "flat") "16" "24"))))
         (hid (parse-integer (opt "hid" (if (string= arch "flat") "200" "128"))))
         (budget (float (parse-integer (opt "secs" "480")) 1d0))
         (m (build arch v e hid)) (b 32) (step 0) (run 0d0) (t0 (get-internal-real-time)) (hist nil))
    (declare (fixnum step) (double-float run))
    (labels ((secs () (/ (- (get-internal-real-time) t0) internal-time-units-per-second 1d0))
             (ctx (p) (coerce (loop for k below +ctx+ for j = (+ (- p +ctx+) k) collect (if (< j 0) nl (svref data j))) 'simple-vector))
             (eval-loss (from to stride)
               (let ((s 0d0) (n 0) (poss (loop for p from from below to by stride collect p)))
                 (loop while poss
                       do (let* ((chunk (loop repeat b while poss collect (pop poss))) (k (length chunk)))
                            (incf s (* k (loss-and-backward m (map 'simple-vector #'ctx chunk) (map 'simple-vector (lambda (p) (svref data p)) chunk) k nil)))
                            (incf n k)))
                 (/ s n))))
      (format t "config: arch=~a emb=~d hidden=~d ctx=8 | vocab=~d params=~d | SGD batch 32, lr 0.1 -> 0.01 for last 25% of ~ds~%"
              arch e hid v (count-params m) (round budget))
      (format t "train positions ~d, val positions ~d (fixed: last 10% of full text); periodic val = first 30000 val positions~%" vstart (- nall vstart))
      (finish-output)
      (loop for el = (secs) while (< el budget)
            do (let* ((poss (loop repeat b collect (+ 1 (random (1- vstart) *rs*)))))
                 (incf run (loss-and-backward m (map 'simple-vector #'ctx poss) (map 'simple-vector (lambda (p) (svref data p)) poss) b t))
                 (sgd m (if (< el (* 0.75d0 budget)) 0.1d0 0.01d0)) (incf step))
               (when (zerop (mod step 2000))
                 (let ((vl (eval-loss vstart (+ vstart 30000) 1)))
                   (format t "step ~6d  t=~6,1fs  train(batch avg)=~,4f  val(subset)=~,4f~%" step (secs) (/ run 2000) vl)
                   (push (list step (secs) (/ run 2000) vl) hist) (finish-output) (setf run 0d0))))
      (let ((s (secs)))
        (format t "trained ~d steps in ~,1fs (~,1f steps/s)~%" step s (/ step s))
        (format t "FINAL: train(every 10th train position)=~,4f  val(full fixed val, ~d positions)=~,4f~%"
                (eval-loss 1 vstart 10) (- nall vstart) (eval-loss vstart nall 1)))
      (with-open-file (f (format nil "~a.csv" (opt "tag" "mlp")) :direction :output :if-exists :supersede)
        (format f "step,seconds,train_batch,val_subset~%") (dolist (r (reverse hist)) (format f "~{~a~^,~}~%" r)))
      (let ((c (make-list +ctx+ :initial-element nl)))
        (format t "~%=== sample (T=0.8) ===~%~a~%"
                (with-output-to-string (o)
                  (dotimes (k 300)
                    (let* ((P (forward m (vector (coerce c 'simple-vector)) 1 nil))
                           (w (map 'vector (lambda (p) (expt (max p 1d-300) 1.25d0)) (subseq P 0 v)))
                           (u (* (random 1d0 *rs*) (reduce #'+ w))) (acc 0d0) (ch (1- v)))
                      (dotimes (i v) (incf acc (aref w i)) (when (> acc u) (setf ch i) (return)))
                      (write-char (svref chars ch) o) (setf c (append (cdr c) (list ch)))))))))))

(if (string= (opt "mode" "train") "gradcheck") (progn (gradcheck "flat") (gradcheck "wavenet")) (main))
