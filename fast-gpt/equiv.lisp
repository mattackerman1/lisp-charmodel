;;;; equiv.lisp -- old (gpt-big.lisp) vs new (gpt-fast.lisp): (1) analytic gradients on a tiny config and on the real
;;;; config, (2) training-loss curves for N steps with the same seed, same data windows, step-based LR schedule.
;;;; usage: sbcl --script equiv.lisp steps=300 data=../big/corpus.txt
(defun harg (key default)
  (let ((a (find-if (lambda (s) (and (> (length s) (length key)) (string= (concatenate 'string key "=") s :end2 (1+ (length key))))) sb-ext:*posix-argv*)))
    (if a (subseq a (1+ (length key))) default)))
(load (compile-file "gpt-old.lisp" :output-file "/tmp/equiv-old.fasl" :verbose nil :print nil))
(rename-package :gpt :gpt-old)
(load (compile-file "gpt-fast.lisp" :output-file "/tmp/equiv-new.fasl" :verbose nil :print nil))
(funcall (intern "%SET-THREADS" :gpt) 1)   ; single-threaded OpenBLAS, as in MAIN (same library in both)
(defun sym (pkg name) (intern (string-upcase name) pkg))
(defmacro with-pkg ((p) &body body) `(flet ((f (name &rest args) (apply (sym ,p name) args))) (declare (ignorable #'f)) ,@body))
(defun setup (p cfg k b seed pdrop &key (perturb nil))
  "Build model + K workers in package P with the same RNG consumption as gpt-big.lisp."
  (setf (symbol-value (sym p "*rs*")) (sb-ext:seed-random-state seed)
        (symbol-value (sym p "*pdrop*")) pdrop)
  (with-pkg (p)
    (let* ((c (apply (sym p "make-cfg") cfg)) (m (f "make-model*" c)) (ws (loop repeat k collect (f "make-wk*" c b))))
      (when perturb
        (dolist (pv (f "model-vecs" m)) (let ((a (car pv))) (dotimes (i (length a)) (incf (aref a i) (coerce (* 0.3 (f "randn")) 'single-float))))))
      (list c m ws))))
(defun grads-of (p m ws nt scale drop)
  (with-pkg (p)
    (dolist (w ws) (setf (slot-value w (sym p "drop")) drop (slot-value w (sym p "newmask")) t (slot-value w (sym p "loss")) 0d0 (slot-value w (sym p "count")) 0)
      (f "forward-backward" m w nt 0 t scale))
    (values (f "sum-grads" ws) (loop for w in ws sum (slot-value w (sym p "loss"))))))
(defun compare-grads (label cfg k b nt pdrop ids-fn)
  (let ((res (loop for p in '(:gpt-old :gpt)
                   collect (destructuring-bind (c m ws) (setup p cfg k b 1 pdrop :perturb (eq ids-fn :tiny))
                             (declare (ignore c))
                             (let ((rs (sb-ext:seed-random-state 99)) (vv (getf cfg :v)))
                               (dolist (w ws) (dotimes (q (* b nt)) (setf (aref (slot-value w (sym p "ids")) q) (random vv rs)
                                                                         (aref (slot-value w (sym p "tgt")) q) (random vv rs)))))
                             (multiple-value-list (grads-of p m ws nt (coerce (/ 1d0 (* k b nt)) 'single-float) (> pdrop 0d0)))))))
    (destructuring-bind ((g1 l1) (g2 l2)) res
      (let ((n 0) (ndiff 0) (maxabs 0d0) (maxg 0d0))
        (loop for a in g1 for bb in g2
              do (dotimes (i (length a))
                   (incf n) (setf maxg (max maxg (abs (aref a i))))
                   (unless (= (aref a i) (aref bb i)) (incf ndiff) (setf maxabs (max maxabs (abs (- (aref a i) (aref bb i))))))))
        (format t "~a dropout=~a: loss old ~,10f new ~,10f | ~d grads, ~d differ (max |diff| ~,3e, max |g| ~,3e)~%" label pdrop l1 l2 n ndiff maxabs maxg)
        (finish-output)))))
(format t "== gradient equivalence (old analytic vs new analytic, FT=single) ==~%")
(dolist (pd '(0d0 0.2d0 0.5d0))
  (compare-grads "tiny V=5 d=8 L=2 H=2 T=4, 2 workers x 2 seqs" '(:v 5 :d 8 :nl 2 :nh 2 :tt 4) 2 2 4 pd :tiny))
(dolist (pd '(0d0 0.1d0))
  (compare-grads "real V=86 d=128 L=4 H=4 T=64, 8 workers x 4 seqs" '(:v 86 :d 128 :nl 4 :nh 4 :tt 64) 8 4 64 pd :real))

;;; ---- training curves ----
(let* ((nsteps (parse-integer (harg "steps" "300"))) (k 8) (bt 32) (b 4) (tt 64) (pdrop 0.1d0)
       (full (with-open-file (s (harg "data" "../big/corpus.txt") :external-format :utf-8)
               (let* ((buf (make-string (file-length s))) (n (read-sequence buf s))) (subseq buf 0 n))))
       (chars (let ((seen (make-hash-table))) (loop for ch across full do (setf (gethash ch seen) t)) (coerce (sort (loop for k being the hash-keys of seen collect k) #'char<) 'simple-vector)))
       (c2i (let ((ht (make-hash-table))) (loop for ch across chars for i from 0 do (setf (gethash ch ht) i)) ht))
       (data (map '(simple-array fixnum (*)) (lambda (ch) (gethash ch c2i)) full))
       (vstart (floor (* 0.9 (length data)))) (v (length chars))
       (curves nil) (times nil))
  (format t "data loaded: ~d chars, vocab ~d~%" (length data) v) (finish-output)
  (dolist (p '(:gpt-old :gpt))
    (destructuring-bind (c m ws) (setup p (list :v v :d 128 :nl 4 :nh 4 :tt tt) k b 1 pdrop)
      (declare (ignore c))
      (with-pkg (p)
        (let* ((new (eq p :gpt)) (opt (if new (f "make-adam*" m ws k) (f "make-adam*" m))) (pool (when new (f "make-pool*" k)))
               (rs (symbol-value (sym p "*rs*"))) (scale (coerce (/ 1d0 (* bt tt)) 'single-float)) (losses nil) (t0 (get-internal-real-time)))
          (dotimes (step nsteps)
            (dolist (w ws)
              (let ((ids (slot-value w (sym p "ids"))) (tgt (slot-value w (sym p "tgt"))))
                (declare (type (simple-array fixnum (*)) ids tgt data))
                (dotimes (s0 b) (let ((start (random (- vstart tt 1) rs)))
                                  (dotimes (i tt) (setf (aref ids (+ (* s0 tt) i)) (aref data (+ start i))
                                                        (aref tgt (+ (* s0 tt) i)) (aref data (+ start i 1)))))))
              (setf (slot-value w (sym p "loss")) 0d0 (slot-value w (sym p "count")) 0 (slot-value w (sym p "drop")) t (slot-value w (sym p "newmask")) t))
            (let ((lr (* 1d-3 (min 1d0 (/ (1+ step) 100d0)))))        ; step-based warmup (deterministic)
              (if new
                  (progn (f "run-pool" pool (lambda (i) (f "forward-backward" m (nth i ws) tt 0 t scale)))
                         (f "opt-step" pool opt lr 0.1d0))
                  (progn (f "parallel" ws (lambda (w) (f "forward-backward" m w tt 0 t scale)))
                         (f "adamw" m opt (f "sum-grads" ws) lr 0.1d0))))
            (when (< step 3) (format t "~a step ~d done ~,1fs~%" p step (/ (- (get-internal-real-time) t0) 1d6)) (finish-output))
            (push (/ (loop for w in ws sum (slot-value w (sym p "loss"))) (loop for w in ws sum (slot-value w (sym p "count")))) losses))
          (push (/ (- (get-internal-real-time) t0) 1d6) times)
          (when pool (f "stop-pool" pool))
          (push (reverse losses) curves)))))
  (destructuring-bind (lnew lold) curves
    (let ((ndiff (loop for a in lold for bb in lnew count (/= a bb))) (maxd (loop for a in lold for bb in lnew maximize (abs (- a bb)))))
      (format t "~%== training curves, ~d steps, real config, dropout 0.1, seed 1, same windows ==~%" nsteps)
      (format t "old ~,1fs, new ~,1fs. steps with different train loss: ~d, max |diff| = ~,3e~%" (second times) (first times) ndiff maxd)
      (loop for s in '(0 1 9 49 99 149 199 249 299 399 499) when (< s nsteps)
            do (format t "  step ~4d  old ~,8f  new ~,8f~%" (1+ s) (nth s lold) (nth s lnew)))
      (with-open-file (o "curves-old-vs-new.csv" :direction :output :if-exists :supersede)
        (format o "step,loss_old,loss_new~%") (loop for a in lold for bb in lnew for s from 1 do (format o "~d,~,10f,~,10f~%" s a bb))))))
