;;;; prof.lisp -- benchmark/profile harness. usage: sbcl --script prof.lisp src=FILE steps=N threads=K dropout=P sprof=0|1
(require :sb-sprof)
(defun harg (key default)
  (let ((a (find-if (lambda (s) (and (> (length s) (length key)) (string= (concatenate 'string key "=") s :end2 (1+ (length key))))) sb-ext:*posix-argv*)))
    (if a (subseq a (1+ (length key))) default)))
(let ((src (harg "src" "gpt-old.lisp")))
  (load (compile-file src :output-file (format nil "/tmp/prof-~a-~a.fasl" (pathname-name src) (random 1000000 (make-random-state t))) :verbose nil :print nil)))
(in-package :gpt)
(defun harg (key default) (cl-user::harg key default))
(defvar *pool-for-stop* nil)
(defvar *fast* (fboundp (intern "OPT-STEP" :gpt)))
(let* ((k (parse-integer (harg "threads" "8"))) (bt 32) (b (floor bt k)) (tt 64)
       (c (make-cfg :v 86 :d 128 :nl 4 :nh 4 :tt tt))
       (nsteps (parse-integer (harg "steps" "200")))
       (pd (setf *pdrop* (float (read-from-string (harg "dropout" "0.1")) 1d0)))
       (m (make-model* c)) (ws (loop repeat k collect (make-wk* c b))) (opt (if *fast* (funcall 'make-adam* m ws k) (make-adam* m)))
       (pool (when *fast* (funcall (intern "MAKE-POOL*" :gpt) k)))
       (scale (coerce (/ 1d0 (* bt tt)) 'single-float))
       (rs (sb-ext:seed-random-state 7))
       (tl (make-hash-table)))
  (%set-threads 1)
  (labels ((now () (get-internal-real-time))
           (acc (key t0) (incf (gethash key tl 0) (- (now) t0)))
           (step1 ()
             (let ((t0 (now)))
               (dolist (w ws)
                 (dotimes (q (* b tt)) (setf (aref (w-ids w) q) (random 86 rs) (aref (w-tgt w) q) (random 86 rs)))
                 (setf (w-loss w) 0d0 (w-count w) 0 (w-drop w) (> pd 0d0) (w-newmask w) t))
               (acc :load t0))
             (if *fast*
                 (progn
                   (let ((t0 (now))) (funcall (intern "RUN-POOL" :gpt) pool (lambda (i) (forward-backward m (nth i ws) tt 0 t scale))) (acc :fwdbwd-parallel t0))
                   (let ((t0 (now))) (funcall (intern "OPT-STEP" :gpt) pool opt 1d-4 0.1d0) (acc :sum+adamw-parallel t0)))
                 (progn
                   (let ((t0 (now))) (parallel ws (lambda (w) (forward-backward m w tt 0 t scale))) (acc :fwdbwd-parallel t0))
                   (let* ((t0 (now)) (g (sum-grads ws))) (acc :sum-grads t0)
                     (let ((t1 (now))) (adamw m opt g 1d-4 0.1d0) (acc :adamw t1)))))))
    (dotimes (i 20) (step1))
    (clrhash tl)
    (sb-ext:gc :full t)
    (let ((t0 (now)) (gc0 sb-ext:*gc-run-time*) (by0 (sb-ext:get-bytes-consed)))
      (dotimes (i nsteps) (step1))
      (let ((s (/ (- (now) t0) internal-time-units-per-second 1d0)))
        (format t "~a threads=~d dropout=~a: ~d steps in ~,2fs = ~,2f steps/s = ~,0f tokens/s; GC ~,3fs, consed ~,1f KB/step~%"
                (harg "src" "?") k pd nsteps s (/ nsteps s) (/ (* nsteps bt tt) s)
                (/ (- sb-ext:*gc-run-time* gc0) internal-time-units-per-second 1d0)
                (/ (- (sb-ext:get-bytes-consed) by0) 1024d0 nsteps))
        (maphash (lambda (key v) (format t "  ~20a ~6,2f ms/step (~4,1f%)~%" key (/ v 1000d0 nsteps) (* 100 (/ v internal-time-units-per-second s)))) tl)))
    ;; single-worker per-function breakdown (no thread effects): sb-sprof on worker 0 alone
    (when (and *fast* pool) (setf *pool-for-stop* pool))
    (when (string= (harg "sprof" "1") "1")
      (let ((w (car ws)))
        (sb-sprof:with-profiling (:max-samples 200000 :sample-interval 0.0005 :mode :cpu :report :flat)
          (dotimes (i (* 3 nsteps))
            (setf (w-loss w) 0d0 (w-count w) 0 (w-drop w) (> pd 0d0) (w-newmask w) t)
            (forward-backward m w tt 0 t scale)))))))

(when *pool-for-stop* (funcall (intern "STOP-POOL" :gpt) *pool-for-stop*))
