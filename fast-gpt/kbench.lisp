;;;; kbench.lisp -- per-kernel micro benchmark, one worker-sized call (R=256 rows, d=128). usage: sbcl --script kbench.lisp FASL
(load (second sb-ext:*posix-argv*))
(in-package :gpt)
(defvar *new* (fboundp (intern "OPT-STEP" :gpt)))
(defmacro bench (name reps &body body)
  `(let ((t0 (get-internal-real-time)))
     (dotimes (k ,reps) ,@body)
     (format t "  ~22a ~8,4f ms/call~%" ,name (/ (- (get-internal-real-time) t0) 1000d0 ,reps))))
(let* ((R 256) (d 128) (n (* R 512)) (X (mkv (* R d))) (g (mkv d)) (b (mkv d)) (H (mkv (* R d))) (rs (mkv R)) (Y (mkv (* R d)))
       (hh (mkv n)) (gg (mkv n)) (dg (mkv n)) (tc (make-array n :element-type 'double-float :initial-element 0d0))
       (c (make-cfg :v 86 :d 128 :nl 4 :nh 4 :tt 64)) (qkv (mkv (* R 384))) (att (mkv (* 4 4 64 64))) (yy (mkv (* R d)))
       (dqkv (mkv (* R 384))) (dA (mkv (* 64 64))) (eb (make-array 128 :element-type 'double-float :initial-element 0d0))
       (st (make-array 1 :element-type '(unsigned-byte 64) :initial-element 12345)) (mask (mkv (* 4 4 64 64))))
  (dotimes (i (* R d)) (setf (aref X i) (- (random 2f0) 1f0) (aref yy i) (- (random 2f0) 1f0)))
  (dotimes (i n) (setf (aref hh i) (- (random 6f0) 3f0) (aref dg i) (random 1f0)))
  (dotimes (i (* R 384)) (setf (aref qkv i) (- (random 2f0) 1f0)))
  (fill g 1f0) (setf *pdrop* 0.1d0)
  (format t "~a~%" (second sb-ext:*posix-argv*))
  (bench "layernorm" 2000 (layernorm X R d g b H rs Y))
  (bench "ln-back" 2000 (ln-back Y H rs g b b R d X t))
  (if *new* (bench "gelu" 300 (funcall 'gelu hh gg tc n)) (bench "gelu" 300 (funcall 'gelu hh gg n)))
  (if *new* (bench "gelu-back" 300 (funcall 'gelu-back hh tc dg n)) (bench "gelu-back" 300 (funcall 'gelu-back hh dg n)))
  (if *new* (bench "attention(fwd,b=4)" 300 (funcall 'attention c qkv att yy 4 64 eb))
            (bench "attention(fwd,b=4)" 300 (funcall 'attention c qkv att yy 4 64)))
  (bench "attention-back(b=4)" 300 (attention-back c qkv att yy dqkv dA 4 64))
  (bench "fill-mask(65536)" 1000 (fill-mask st mask 65536)))
